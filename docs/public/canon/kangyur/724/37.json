{"t":"724","p":37,"paras":[["ཚ 141b","ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་སྤྱན་རས་གཟིགས་དབང་ཕྱུག་ལ་བཀའ་སྩལ་པ། མི་དང་འབྱུང་པོའི་དབུས་གནས་པའི། །སེམས་ཅན་རྣམས་ལ་རྗེས་བརྩེ་བས། །དཀྱིལ་འཁོར་ལས་ཅན་ཐམས་ཅད་ནི། །སེམས་དཔའ་ཆེན་པོ་སྨྲོས་ཤིག་སྨྲོས། །སྒྲོལ་མའི་དཀྱིལ་འཁོར་ལྷ་རྣམས་དང་། །ཕུན་ཚོགས་ཐམས་ཅད་མངོན་པར་འཕེལ། །སྒྲུབ་པོ་རྣམས་ལ་ཕན་པ་ཡི། །དོན་ཕྱིར་འདྲེན་པས་རྒྱས་པར་སྨྲོས། །ངོ་མཚར་རྨད་བྱུང་ཐམས་ཅད་ཀྱི། །ལུས་ཅན་བར་མར་གྱུར་པ་རྣམས། །ཁྱོད་ཀྱི་ཚིག་གི་མཆོག་གྱུར་པ། །འབྱུང་འགྱུར་དེ་དག་ཐོས་ནས་ནི། །མྱུར་དུ་ལྷ་རྣམས་སྒྲུབ་པ་ལ། །སེམས་ཅན་གང་དུ་རབ་ཞུགས་པ། །དེ་ཉིད་དུ་ནི་སྔར་བཤད་པ། །བྱང་ཆུབ་སེམས་དཔའ་བློ་ལྡན་དང་། །སངས་རྒྱས་བྱེ་བ་སྟོང་རྣམས་ཀྱིས། །ཐམས་ཅད་དེ་ལ་རྗེས་ཡི་རང་། །དཀྱིལ་འཁོར་སྡིག་པ་ཀུན་འཇོམས་པ། །དངོས་གྲུབ་ཀུན་བྱེད་དགེ་བ་ནི། །སེམས་ཅན་རྣམས་ཀྱི་མགོན་པོས་སྨྲོས། །སྒྲོལ་མའི་དཀྱིལ་འཁོར་ཁྱོད་ཀྱི་ཚིག །སེམས་ཅན་ཆོ་ག་ཡང་དག་འགྱུར། །དཀྱིལ་འཁོར་གང་འདི་ཐོས་ནས་ནི། །རབ་ཏུ་དད་པ་སྐྱེ་བར་འགྱུར། །དཔལ་མིན་འཇོམས་ཤིང་ཞི་བ་དང་། །དེ་བཞིན་ནད་དང་དགྲ་འཕྲོག་ཅིང་། །དཀྱིལ་འཁོར་སེམས་ཅན་ཐམས་ཅད་ཀྱི། །གཟི་བརྗིད་སྟོབས་ནི་རྣམ་པར་འཕེལ། །མཐོང་ངམ་ཐོས་ནས་དེ་ནས་ནི། །རབ་ཏུ་དད་པ་སྐྱེད་པར་བྱེད། །གང་ཡིན་དེ་རྣམས་བདག་གིས་ནི། །སངས་རྒྱས་ཀུན་གྱི་བྱང་ཆུབ་ནི། །ཐོབ་པའི་ཆེད་དུའང་ལུང་བསྟན་ཏོ། །མ་འོངས་སངས་རྒྱས་འབྱུང་འགྱུར་བ། །འཇིག་རྟེན་མགོན་པོ་རྣམས་ཀྱང་ནི། །རྗེས་སུ་ཡི་རང་འགྱུར་བ་ཡིན། །དཀྱིལ་འཁོར་ཕུན་ཚོགས་འཕེལ་བྱེད་པ། །དེ་བཞིན་ཡོན་ཏན་ཀུན་སྡུད་པ། །སྒྲོལ་མའི་དཀྱིལ་འཁོར་རྨད་བྱུང་བ། །སེམས་དཔའ་ཆེན་པོ་འཇིག་རྟེན་མགོན། །ཡང་དག་བཀའ་ཡིས་སྨྲོས་ཤིག་སྨྲོས། །དེ་སྐད་ཅེས་བཀའ་སྩལ་པ་དང་། བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་འཕགས་པ་"],["ཚ 142a","སྤྱན་རས་གཟིགས་དབང་ཕྱུག་སྟན་ལས་ལངས་ནས་བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་བྱས་ནས་པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ཏེ། བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་ཐལ་མོས་ཕྱག་འཚལ་ནས། བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པ་ལ་ཐ་མི་དད་པའི་ཚིགས་སུ་བཅད་པས་བསྟོད་པའི་ཚིག་གིས་མངོན་པར་བསྟོད་དོ། །ཤཱཀྱའི་རྒྱལ་པོ་ལྷ་ཡི་རྒྱལ། །ཕུན་ཚོགས་ཡོན་ཏན་དུ་མ་ཅན། །རབ་བསྔགས་རྫུ་འཕྲུལ་རབ་མ་ཉམས། །རྒྱུན་དུ་དཀར་བའི་གོས་དང་ལྡན། །མཆོད་སྡོང་ཞལ་ནི་འདམ་སྐྱེས་དྲི། །བློ་བཟང་སྙིང་པོ་བསྟན་པ་འཛིན། །གང་ཕྱིར་ཁྱོད་ནི་ཕུན་ཚོགས་ཉིད། །འདི་ནི་འགྲོ་བ་དེ་དག་གི། །དགའ་བས་དགའ་བར་བྱེད་པ་ནི། །མགོན་པོ་ལྷ་རྣམས་ཀྱི་ནི་སྟེ། །རང་བཞིན་དྲན་པས་ཀུན་ཏུ་སྣང་། །དེ་ཡི་ཚིག་ནི་རབ་རིག་པ། །དཔའ་དེ་ཆགས་པ་ཟད་པ་ཉིད། །འབྲས་བུ་གསུམ་ཉིད་འཛིན་པར་བྱེད། །དེ་དེ་གཞན་དུ་དེ་ཡིས་ནི། །ལྷ་ཡི་མཛེས་མས་ཀུན་བསྲུངས་པ། །བརྒྱད་ཀྱིས་འདིར་ནི་དབང་ཞལ་ལས། །སྐྱེས་པའི་དཔའ་བོ་རབ་སྟོབས་དང་། །གཡོ་བའི་སྤྲོ་དགའི་དབང་པོ་དང་། །ཀུན་ནས་གསེར་གྱི་རི་དང་ལྡན། །ཅོད་པན་ཡང་ནི་ལྷན་ཅིག་གདན། །ལྷ་དང་ལྷ་མིན་ལྷར་བཅས་པའི། །ལྷག་པའི་ཐེག་པ་ཐམས་ཅད་ཀྱང་། །འཇིག་རྟེན་བར་དོའི་སྲིད་པ་དང་། །སྐྱེ་བ་ཁྱོད་ཀྱི་སྲོག་ལ་སོགས། །བྱུང་བ་མཛེས་ལྡན་རང་ཉིད་ཀྱི། །འདི་ཡི་མིག་ནི་དགའ་བ་སྟེ། །གང་རྣམས་ཟླ་བ་ལྟ་བུར་དཀར། །ལྷ་རྣམས་ཀྱིས་བཟུང་རི་བོང་ཅན། །ཀུན་ད་དུ་ཀུ་དཀར་པོ་ཡི། །གོས་ནི་མནབས་ཉིད་ཙ་ཀོར། །བརྒྱ་བྱིན་འདབ་བརྒྱ་པ་ཡི་མིག །ས་སྲུངས་ཕྲག་པར་ཕྱོགས་གཅིག་འགྲོ། །བླ་མའི་རི་ལ་རི་བོང་ཅན། །རྒྱལ་པོའི་དཔུང་ལྡན་བརྒྱ་བྱིན་ནི། །མིག་བརྒྱ་བརྩོན་འགྲུས་མ་ཉམས་པས། །གྲངས་དང་ཆུ་གཏེར་ཆུ་འབྱིན་པ། །ཚོགས་ཀྱི་སྒྲ་ནི་དགའ་བ་དང་། དྲི་མེད་སྤྱན་ནི་དགའ་བ་ལའང་། །ཉི་མའི་འོད་ཟེར་དམ་པ་ནི། །རྣམ་པས་ཟས་དང་དྲི་འཁོར་བ། །བུམ་དཀར་གང་བ་སོ་སོ་ཡི། །བུམ་པ་དེ་རྣམས་དབང་བསྐུར་ཞིང་། །ཙནྡན་ས་"],["ཚ 142b","མཆོག་ཡན་ལག་བཤད། །གི་བང་ཐིག་ལེ་རྣམ་པར་བཀྲ །ཡན་ལག་དམ་པ་ཡོངས་འདུ་བའི། །དགའ་བ་མཆོག་གི་ཡན་ལག་དང་། །ལུས་མེད་གཞོམ་པའི་ཆེད་དུ་བྱས། །ཡན་ལག་ཆགས་པ་བྱས་མཐའ་ལས། །ཁྲུས་ནི་སྟུག་པོས་མི་འཕོ་བས། །གཞན་དུ་འཆི་མེད་ལེགས་པ་ནི། །དེ་འོག་ཐལ་མོ་སྦྱར་བ་ཡི། །དུག་གིས་བཏབ་པ་སྨད་པ་ལྟར། །དེ་བཞིན་གཤེགས་པའི་མཆོག་བརྗོད་པའི། །ཆར་ལྡན་ཁྱོད་ཀྱི་ཞལ་དུ་ནི། །སྔོན་ལས་ཁྱོད་ནི་ལམ་གྱི་མགོ། །དྲི་མ་བཞིན་དུ་སྤངས་པ་ཡང་། །མེ་ཏོག་ལྡན་པའི་ཟླ་བ་ལ། །རྣམ་པར་ཚར་ཕྱིན་ལོངས་སྤྱོད་ལྡན། །བཅིངས་པ་ལྟ་བུར་འདི་རྣམས་ཉིད། །བཙོས་ནས་སྔར་མེད་ཆོ་ག་ཡིས། །བཅུ་པར་ཁྱོད་ནི་ཞི་བ་སྟེ། །མགོན་མེད་འགྲོ་བ་མཐའ་ཡས་ལས། །གང་ཕྱིར་སྲིད་པ་མཐའ་མེད་ཅིང་། །དྲི་མས་ལྷ་དང་ལྷ་མིན་ཡང་། །དེ་ཡི་བརྟུལ་ཞུགས་ཕན་ཚུན་དུ། །དམ་པའི་སྤྱན་གྱི་འོད་ཀྱིས་སྣང་། །འཁྱིལ་པ་སྤྱན་ཡངས་ཡན་ལག་མཆོག །ཕྱོགས་སུ་ལྷ་རྣམས་གནས་པ་དང་། །མི་རྣམས་བྱང་ཆུབ་རྣམ་སངས་རྒྱས། །རབ་ཏུ་བྱེད་འགྱུར་ཞེས་པ་ནི། །མི་རྣམས་འབྱུང་དང་སྡུད་པའི་ལས། །དེ་ཕྱིར་རྣམ་པད་ཆུ་སྐྱེས་ནི། །ལྷ་ཡི་ཡན་ལག་དམ་པར་སོན། །དཔའ་བོའི་ཡན་ལག་དཀྲིས་ཆགས་བྲལ། །འཆི་བཞིན་ས་ཡི་ལུས་ཀྱང་འཁོད། །ཀུན་ནས་གཏོད་དང་ཀུན་ནས་སྡུད། །ཡང་དག་ས་དང་ཕྱོགས་དང་ལྡན། །རྣམ་བཞི་མཉམ་པར་བྱང་ཆུབ་ལྡན། །བྱང་ཆུབ་ཤིང་དྲུང་བདུད་དཔུང་ལས། །རྣམ་པར་རྒྱལ་བ་ཐོབ་པ་དང་། །སངས་རྒྱས་གོ་འཕང་འཕོ་མེད་དང་། །ཀླུ་ཡི་ཤིང་གི་རྩ་བ་རུ། །ཞེ་སྡང་རྩུབ་པོའི་ནགས་རྣམས་ཀྱིས། །རྐང་པ་སྟོང་བུ་མེ་ཡི་ཆེད། །རྨོངས་མུན་དྲི་མ་སྣང་བྱེད་པ། །ཁྲོ་བོའི་མེ་ནི་འབར་བ་ལ། །མི་གཡོ་རབ་ཏུ་སྦྱིན་པར་བྱེད། །ཕྱག་རྒྱ་རྡོ་རྗེ་ལྟ་བུ་སྒོམ། །གཞལ་བའི་འཁྲི་ཤིང་གཟུགས་བརྙན་བརྟན། །དམར་པོའི་མེ་ནི་འབར་བ་ནི། །འཇིགས་པའི་ཉི་ལྟར་རྣམ་མཛེས་པ། །ཡན་ལག་སྟོབས་བསྐྱེད་ཕྱག་འཚལ་བསྟོད། །དེ་ནས་བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་"],["ཚ 143a","སྤྱན་རས་གཟིགས་དབང་ཕྱུག་གིས་བཅོམ་ལྡན་འདས་ལ་ཚིགས་སུ་བཅད་པ་འདི་རྣམས་ཀྱིས་མངོན་པར་བསྟོད་ནས་རང་གི་སྟན་ལ་འཁོད་དེ། བྱང་ཆུབ་སེམས་དཔའ་ཆེན་པོའི་ཏིང་ངེ་འཛིན་ཀུན་ཏུ་གཟིགས་པ་ཞེས་བྱ་བ་ལ་སྙོམས་པར་ཞུགས་སོ། །སྙོམས་པར་ཞུགས་མ་ཐག་ཏུ་སེམས་དཔའ་ཆེན་པོའི་ཞལ་གྱི་སྒོ་ནས་འོད་ཟེར་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་དུ་མ་བྱུང་སྟེ་འོད་ཟེར་དེ་རྣམས་ཀྱིས་གང་གཱའི་བྱེ་མ་དང་མཉམ་པའི་སངས་རྒྱས་ཀྱི་ཞིང་རྣམས་ཀུན་ཏུ་སྣང་བར་བྱས་པར་གྱུར་ཏོ། །དམྱལ་བ་པའི་སེམས་ཅན་ཐམས་ཅད་ཀྱང་སྐད་ཅིག་དེ་དང་ཡུད་ཙམ་དེ་ལ་སྡུག་བསྔལ་ཐམས་ཅད་དང་བྲལ་བར་གྱུར་ཏོ། །གང་སངས་རྒྱས་ཀྱི་ཞིང་དེ་རྣམས་སུ་སངས་རྒྱས་བཅོམ་ལྡན་འདས་དེ་རྣམས་ཀྱིས་བྱང་ཆུབ་སེམས་དཔའ་སྤྱན་རས་གཟིགས་དབང་ཕྱུག་ལ་ལེགས་སོ་ཞེས་བྱ་བ་བྱིན་ཏེ། ལེགས་སོ་ལེགས་སོ། །སེམས་དཔའ་ཆེན་པོ་སྨྲོས་ཤིག །མཐུ་ཆེན་པོ་སེམས་ཅན་སྡིག་པ་ཅན་ཐམས་ཅད་དཀྱིལ་འཁོར་དུ་དབང་བསྐུར་བ་སྨྲོས་ཤིག །གང་གིས་དེ་ལྟ་བུ་དེ་རྣམས་ཕྱོགས་བཅུ་མཐའ་ཡས་པ་མུ་མེད་པ་རྣམས་སུ་སངས་རྒྱས་བཅོམ་ལྡན་འདས་བྱང་ཆུབ་སེམས་དཔའ་དང་། ཉན་ཐོས་ཀྱི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་བ་དང་། ལྷན་ཅིག་བྱང་ཆུབ་སེམས་དཔའ་སྤྱན་རས་གཟིགས་དབང་ཕྱུག་ལ་ལེགས་སོ་ཞེས་བྱ་བ་གནང་བ་དང་། ས་ཆེན་པོ་རི་དང་། ནགས་དང་། ཕུག་ཏུ་བཅས་པ་འདི་རབ་ཏུ་གཡོས་སོ། །དེ་ནས་བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་སྤྱན་རས་གཟིགས་དབང་ཕྱུག་བྱང་ཆུབ་སེམས་དཔའ་ཆེན་པོའི་ཏིང་ངེ་འཛིན་དེ་ལས་བཞེངས་ཏེ། བཅོམ་ལྡན་འདས་མ་འཕགས་མ་སྒྲོལ་མའི་སྔགས་བཤད་པར་བརྩམས་སོ། །དང་པོར་རེ་ཞིག་བཅོམ་ལྡན་འདས་མའི་དཀྱིལ་འཁོར་གྱི་སློབ་དཔོན་དམ་ཚིག་མཐོང་བས་སློབ་དཔོན་དང་མཚུངས་པའི་རྗེས་སུ་གནང་བ་ཐོབ་ཅིང་དད་པས་བྱང་ཆུབ་ཏུ་སེམས་བསྐྱེད་པ། སེམས་ཅན་རྣམས་ཀྱི་སྟོབས་དང་། སྟོབས་མ་ཡིན་པ་ཤེས་པ། སེར་སྣ་མེད་ཅིང་གཡོ་སྒྱུ་མེད་པས་ནག་པོ་མེད་ཅིང་ཧ་ཅང་མི་སྦོམ། ཧ་ཅང་མི་ཕྲ་བ་དྲི་ངན་པ་མེད་པས་དབང་པོ་མ་ཚང་བ་མ་ཡིན་པ། མཛེས་"],["ཚ 143b","པ། སྙིང་སྟོབས་དང་ལྡན་པས་སྦྱིན་པ་དང་། ཚུལ་ཁྲིམས་དང་། བཟོད་པ་དང་། བརྩོན་འགྲུས་དང་། བསམ་གཏན་དང་། ཤེས་རབ་དང་། སྙིང་རྗེ་དང་ཡང་དག་པར་ལྡན་པར་གྱུར་པ། སེམས་ཅན་གྱི་དགོངས་པ་དང་། བསམ་པ་ཤེས་པ་དང་། སངས་རྒྱས་དང་། ཆོས་དང་། དགེ་འདུན་ལ་མངོན་པར་དང་བ། ཆ་མང་པོ་མངོན་པར་ཤེས་པ། གསལ་ཞིང་གསལ་བར་སྨྲ་བ། དཀྱིལ་འཁོར་བྲི་བའི་ལས་ལ་བྱང་བ། རིག་གསུམ་གང་ཡང་རུང་བའི་རིག་པ་ལ་སོགས་པས་སྔོན་དུ་བསྙེན་པ་བྱས་པ། ཕྱག་དང་དཀྱིལ་འཁོར་གྱི་རབ་ཏུ་སྦྱོར་བ་ཤེས་པ། མཆོད་རྟེན་གྱི་ལས་བྱས་པ། ཧ་ཅང་མི་རྒན་བྱིས་པ་དང་། རིགས་དམའ་བར་སྐྱེས་པ་མ་ཡིན་པ། གཞོན་ཞིང་ལང་ཚོ་དང་ལྡན་པ་དང་། ཚུལ་བཟང་པོའི་སྒྲུབ་པ་པོས་གསང་བའི་དཀྱིལ་འཁོར་བྲི་བར་བྱའོ་ཞེས་སོ། །དེ་ནས་འདི་ལྟ་བུའི་སློབ་དཔོན་གྱིས་བཅོམ་ལྡན་འདས་མའི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་བརྩམ་པར་བྱ་སྟེ། ནུས་མེད་འདུལ་ཉེས་མ་ཡིན་པ། །དཀྱིལ་འཁོར་ཡང་དག་རབ་སྦྱར་བྱ། །རྨོངས་པའི་སེམས་དང་ཆགས་ཅན་ལ། །དཀྱིལ་འཁོར་བསྟན་པར་ཡང་མི་བྱ། །གང་ཞིག་བསླབ་ལ་ཡུད་ཙམ་ཡང་། །ལྷག་པར་འགྲོ་བའི་ལུས་ཅན་དེས། །མཐོ་རིས་ཐར་པ་ཡང་དག་འགྲུབ། །ཡིད་ཀྱི་དབང་ཕྱུག་ཐོབ་པར་འགྱུར། །བྱང་ཆུབ་སེམས་ནི་རྗེས་ཞིག་པའི། །དངོས་གྲུབ་དམིགས་པ་ཉིད་མི་འགྱུར། །བྱང་ཆུབ་རྩ་བར་རིག་ཐོབ་པའི། །སེམས་དེ་ལས་ནི་ཡང་དག་བརྩམ། །དེ་ནས་དཀྱིལ་འཁོར་སློབ་དཔོན་གྱིས། །སངས་རྒྱས་ཆོས་དང་དགེ་འདུན་ལ། །རབ་ཏུ་དང་བའི་སེམས་ཅན་རྣམས། །བདག་ཉིད་ཁོ་ནར་རབ་རྟོགས་བྱ། །དེ་ལ་བསྟན་བྱའི་དཀྱིལ་འཁོར་བྲི། །དེ་ནས་དཀྱིལ་འཁོར་སློབ་དཔོན་གྱིས། །སྟོབས་ཀྱིས་སྔོན་འདུལ་སི་ཐའི་ལུས། །ཆོ་འཕྲུལ་གྱི་ནི་ཟླ་ཕྱེད་ལ། །གྲོང་དང་གྲོང་ཁྱེར་གྲོང་རྡལ་དང་། །ལྗོངས་རྣམས་སུ་ནི་བྱང་ཤར་གྱི། །ཕྱོགས་ཀྱི་ཆ་རུ་མཆོད་ཡོན་བྱིན། །ས་ཡི་མཐིལ་དུ་དེ་ཇི་ལྟར། །ས་ཕྱོགས་སྔགས་ལ་སྔགས་འགྱུར་བ། །"],["ཚ 144a","སྣུན་དང་ལྗོན་ཤིག་མེ་ཏོག་བཟང་། །འབྲས་བུ་ཡང་དག་མང་པོ་ཅན། །རྒྱུན་མི་འཆད་པར་འབབ་པའི་ཕྱོགས། །དཀར་དང་སེར་བའི་ས་གཞི་ལ། །གྱོ་མོ་བོང་བ་གསེག་མ་བྲལ། །རྔ་བོ་ཆེ་ཡི་སྒྲ་དབྱངས་དང་། །ལམ་གྱི་བཞི་མདོ་དུར་ཁྲོད་དང་། །ལྷ་གཞན་ཡོངས་སུ་བཟུང་བ་དང་། །ཤིས་ཤིང་སྡུག་བསྔལ་རྫོགས་སྤངས་ལ། །གང་དུ་ཀུན་ནས་རྒྱང་གྲགས་ལྔའི། །ཚད་དུ་ཆུ་ཀླུང་ལྟེང་ཀ་དང་། །མཚོ་ཕན་ཆུ་བོ་རབ་འབབ་པ། །ལྗོན་ཤིང་མཆོད་རྟེན་ལྷ་ཁང་དང་། །མེ་ཏོག་ཉིད་ནི་དུས་རྒྱུན་དུ། །ཤིན་ཏུ་རྒྱ་ཆེན་ཡང་དག་ལྡན། །ཆོ་འཕྲུལ་ཕྱོགས་ནི་གང་རུང་ལ། །དེ་ནས་བཅོམ་ལྡན་འདས་མ་ཡི། །དཀྱིལ་འཁོར་སློབ་དཔོན་ས་ཕྱོགས་དེར། །ཉི་མ་གུང་ལ་སོང་ནས་ནི། །རལ་པ་གཅིག་མའི་སྙིང་པོ་ཡི། །མངོན་པར་མཛེས་པའི་ལས་བྱའོ། །ཐོག་མར་རབ་དག་སེམས་ཅན་ཀུན། །བྱམས་དང་སྙིང་རྗེ་དང་ལྡན་པས། །དཀྱིལ་འཁོར་གནས་དེར་ཡིད་ཀྱིས་དམིགས། །དགེ་བའི་རིག་པ་གདོན་པར་བྱ། །སྒྲོལ་མའི་སྙིང་པོ་དམ་པ་དང་། །དེ་བཞིན་དབྱངས་ནི་རྗེས་སུ་གདོན། །འདིར་ནི་སངས་རྒྱས་མཆོད་དོན་དུ། །དཀྱིལ་འཁོར་ལུས་ཅན་ཀུན་གྱིས་བྲི། །ཕྱོགས་ཀྱིས་འགྲོ་བའི་གནས་སུ་གནས། །ཐོག་མར་གཏོར་མ་བྱིན་བྱས་ནས། །དྲི་ཡི་ཡམ་ཤིང་ཡང་དག་ལྡན། །གནས་སུ་གནས་པས་ཀུན་ཟོས་ནས། །གོ་རིམས་བཞིན་དུ་སྤྱན་དྲང་བའི། །དབྱངས་ཀྱིས་ཚིག་འདི་བརྗོད་པར་བྱ། །སློབ་དཔོན་མིང་ནི་ཆེ་གེ་བདག །བཅོམ་ལྡན་འཕགས་མ་སྒྲོལ་མ་ཡི། །དཀྱིལ་འཁོར་དག་ནི་བྲི་བར་འཚལ། །བདག་དང་སེམས་ཅན་ཀུན་གྱིས་གང་། །བདག་མཐར་གདུག་པའི་སེམས་མེད་པ། །བསྐྱེད་ཅིང་བཀུར་སྟིར་བྱེད་པ་དང་། །སངས་རྒྱས་བསྟན་ལ་རབ་དད་པའི། །སེམས་ཅན་རྣམས་ལ་ཕྱིར་ཞིང་ནི། །མང་དུ་རབ་ཏུ་དད་པའི་ཆེད། །དཀྱིལ་འཁོར་བྲི་བར་བདག་འཚལ་ལོ། །དེ་ལྟར་ལན་གཉིས་ལན་གསུམ་བརྗོད། །དེ་ནས་སེམས་ཅན་དེ་རྣམས་ནི། །དཀྱིལ་འཁོར་གྱི་ནི་སློབ་དཔོན་"],["ཚ 144b","གྱིས། མཚན་མོ་མཐོང་བ་སྦྱིན་པར་བྱེད། །དེ་ནས་བྲིས་པའམ་གཞན་དུ་སོང་། །ཐོ་རངས་རྨི་ལམ་རྣམ་པར་སྤྱད། །ས་ཡི་ཕྱོགས་དེར་སོང་ནས་ནི། །ཁྲུ་བརྒྱ་ཡི་ནི་ཚད་དུ་ཡང་། །ཀུན་ནས་གྲུ་བཞི་པ་རུ་བྱ། །ཕྱི་རོལ་དཔག་ཏུ་མེད་པ་ཡི། །དཀོན་མཆོག་གསུམ་གྱི་ཚད་སོང་ནས། །ས་ལ་ཤིང་དང་ཕུབ་མ་དང་། །ཐལ་བ་སོལ་བ་སོ་ཕག་དང་། །སྐྲ་དང་སེན་མོ་མཆོད་སྦྱིན་གྱི། །སོ་ཕག་ནག་པོ་ལ་སོགས་གང་། །གཞན་ཡང་དཀྱིལ་འཁོར་དགེ་བ་ཡི། །མི་དགེའི་ཟུག་རྔུ་ཐམས་ཅད་ཀུན། །ལྷག་མ་མེད་པར་བས་ལ་ནས་ནི། །ས་ཡི་གོང་བུ་དེ་ཉིད་དུ། །གཞན་ཡང་ཆུ་ཀླུང་ཆེན་པོ་ཡི། །འགྲམ་གཉིས་ས་ནི་སྦྱང་བྱས་ནས། །རབ་ཏུ་བཅུག་སྟེ་ཐོབས་བརྡུང་། །ཙནྡན་ཆུ་ཡིས་ཡང་དག་གཏོར། །དེ་ལྟར་བྱས་ནས་མ་ལྟུང་བའི། །བ་བྱུང་ཙནྡན་ཆུ་བསྲེས་ནས། །ཁྲུ་བརྒྱད་པ་ཡི་ཕྱོགས་སུ་ནི། །ཕྱི་རོལ་གྱིས་ཀྱང་ཁྲུ་བཅུ་ཡི། །ཚད་དུ་ཡོངས་སུ་སྦྱངས་པ་ལ། །གསོ་སྦྱོང་སྦྱིན་ནས་བྱུག་ཏུ་གཞུག །ཇི་སྲིད་ས་ཡི་ཕྱོགས་དེར་ནི། །ཤིན་ཏུ་འཇམ་ཞིང་ཤིན་ཏུ་ནི། །ལེགས་པར་རྫོགས་པར་སྐྱེས་ཀྱི་བར། །དེ་ལྟར་ཉི་མ་བདུན་དུ་ནི། །དེ་ནས་ཁྲུ་བཞིའི་ཚད་དུ་ནི། །གྲྭ་བཞི་སེང་ལྡེང་ཕུར་བུ་བརྒྱད། །སོར་མོ་བཅུ་གཉིས་ཚད་དུ་བྱ། །གཞོན་ནུ་མས་བཀལ་སྲད་བུ་ནི། །ཚོན་སྣ་ལྔ་པ་ལེགས་འཇམ་པ། །ཤིན་ཏུ་སྲ་བ་བཅོམ་ལྡན་མའི། །རྩ་བའི་སྙིང་པོ་ལན་བདུན་གྱིས། །བསྔགས་པས་ཕུར་བུ་ལ་དཀྲིས་ནས། །བདུན་བྱས་སྲོད་ལ་གདབ་པར་བྱ། །དེ་ནས་དཀྱིལ་འཁོར་སློབ་དཔོན་གྱིས། །གཙང་མའི་གོས་ནི་བགོས་པ་ཡིས། །དཀྱིལ་འཁོར་ས་ཡི་དབུས་དེ་རུ། །རྩ་བ་ནག་པོ་མེད་པ་ཡི། །བུམ་བླང་དྲི་ཡི་ཆུ་དང་ནི། །མེ་ཏོག་སྒྲོན་མས་བཀང་བ་ལ། །མགྲིན་པར་མེ་ཏོག་ཕྲེང་བར་དཀྲིས། །ཨ་མྲའི་ཡལ་འདབ་ཁ་དགབ་བྱ། །པུས་མོ་དག་ནི་ངེས་བཙུགས་ནས། །རྩ་བའི་རིག་པ་བདུན་བྱས་ཏེ། །ཡང་ན་ཉི་ཤུ་རྩ་གཅིག་བརྗོད། །དེ་ནས་ཕྱོགས་བཅུར་ཀུན་བལྟས་ནས། །འདི་ནི་བསྒྲག་བྱ་ཆེ་གེ་དག །གནས་འདིར་སངས་རྒྱས་མཆོད་"],["ཚ 145a","པའི་ཕྱིར། །སེམས་ཅན་ཀུན་གྱི་ཏིང་འཛིན་ནི། །བསམ་བྱས་དཀྱིལ་འཁོར་བྲིས་པ་འདིར། །སངས་རྒྱས་ཕན་པར་མཛད་པ་ཀུན། །དཀྱིལ་འཁོར་དུ་ནི་བྱོན་པར་མཛོད། །ད་ལྟ་འདིར་ནི་བྱོན་ནས་ཀྱང་། །བདག་གི་མཆོད་ཡོན་བཞེས་སུ་གསོལ། །དེ་དབུས་ཉིད་དུ་བརྟག་བྱ་བ། །གནས་སུ་བྲིས་པའི་བཅོམ་ལྡན་འདས། །སྤྱན་དྲང་བྱ་ཞིང་ལྷ་རྣམས་ཀྱི། །གནས་མདོར་བསྟན་ནས་བརྗོད་པར་བྱ། །དགའ་ལྡན་དུ་ནི་བྱང་ཆུབ་སེམས། །འཇིག་རྟེན་གཞན་དུ་གང་གནས་པ། །དེ་བཞིན་ཁ་བའི་གནས་སུ་དང་། །གང་ལྡན་པདྨའི་དབང་ཕྱུག་འབྱུང་། །ལྕང་ལོ་ཅན་དུ་ནོར་དབང་ཕྱུག །ཏེ་སེ་རུ་ནི་བདེ་བྱེད་བཤད། །མཆོད་ཡོན་སྣོད་ནི་བཀང་བ་ཡིས། །དེ་རྣམས་གནས་ནི་རྣམ་བསམ་བྱ། །དེ་ནས་ཞལ་ནི་སྲུབ་བསྙེན་བཀུར། །དཀྱིལ་འཁོར་ལས་རྣམས་ཐམས་ཅད་ལ། །མིང་དང་གནས་ནི་ཡོངས་ཉམས་ན། །ཕྱིན་ཅི་ལོག་ཏུ་ལྡོག་པར་འགྱུར། །དེ་ལྟར་ཉི་མ་བདུན་དུ་ནི། །ཉིན་རེ་ཉིན་རེ་ཙནྡན་གྱི། །ཆུ་ཡིས་བྱུག་ཏུ་གཞུག་པར་བྱ། །མཚན་མོའི་ཐུན་ལའང་དེ་བཞིན་བྱ། །བར་འདིར་ཡོ་བྱད་ཐམས་ཅད་ནི། །རྣམ་པར་འབྱོར་པར་འགྱུར་བ་ཡིན། །དེ་ལ་འདི་ནི་བརྗོད་བྱ་སྟེ། །དག་པའི་ཤེལ་དང་མཚུངས་པ་ཡི། །ཕྱེ་མ་རྡོ་རྗེའི་རང་བཞིན་སྐྱེས། །ཛི་བའི་མེ་ཏོག་དང་མཚུངས་པའི། །ཕྱེ་མས་དཀྱིལ་འཁོར་ཀུན་ཏུ་བྲི། །པདྨ་རཱ་ག་ཨུཏྤ་ལ། །ཕྱེ་མ་མཐའ་དག་གིས་གདབ་བྱ། །གུར་གུམ་ཆུ་དང་མཚུངས་པ་དང་། །པུཥྤ་རཱ་ག་ཡི་དཀྱིལ་འཁོར། །ཟར་མའི་མེ་ཏོག་དང་མཚུངས་ཤིང་། །དེ་བཞིན་མ་ར་ཀ་ཏས་ཀྱང་། །དེ་ཙམ་ཁ་དོག་རིན་ཆེན་མ། །ལྕགས་ཀྱང་རུང་སྟེ་མིང་ཅན་ལྔ། །ཡང་ན་དྲིས་བཏགས་ཕྱེ་མས་སམ། །ཇི་ལྟར་སྙེད་པ་རྣམ་སྤྲུལ་པས། །རབ་བཀུག་རིན་ཆེན་ཕྱེ་མ་ཡིས། །ཡང་དག་པ་ཡི་དངོས་གྲུབ་འདོད། །ནོར་བུ་མཆིང་བུ་མཚུངས་མིན་གང་། །པདྨ་རཱ་གས་རྣམ་པ་ཀུན། །དཀྱིལ་འཁོར་ཡོ་བྱད་ཐམས་ཅད་ཀྱང་། །སློབ་དཔོན་གྱིས་ནི་གཞོན་ནུ་མའི། །ལག་པས་བྱེད་དུ་གཞུག་པར་བྱ། །བྲམ་ཟེ་རྒྱལ་རིགས་རིགས་སྐྱེས་པ། །བྱང་ཆུབ་སེམས་ནི་བསྐྱེད་པ་དང་། །མ་ནོར་སྐྱེས་པ་རབ་མཛེས་པ། །དབང་"],["ཚ 145b","པོ་མ་ཚང་མ་ཡིན་པ། །མདོར་ན་བུད་མེད་མཚན་ཉིད་དང་། །ཡང་དག་ལྡན་པར་སྐྱེས་པ་ཡིས། །འདི་འདྲའི་གཞོན་ནུ་མ་གཅིག་གཉིས། །གསུམ་ལ་གསོ་སྦྱོང་སྦྱིན་ནས་ནི། །འོ་མའི་ཟས་ཀྱིས་མངོན་དགའ་བར། །བྱས་ནས་དཀར་པོའི་གོས་བགོས་ཏེ། །དཀྱིལ་འཁོར་ཡོ་བྱད་ཐམས་ཅད་ནི། །བྱེད་གཞུག་དཀྱིལ་འཁོར་ཡོ་བྱད་ཀུན། །ལེགས་བསགས་སོ་སོར་བརྟགས་པ་ཡིས། །ཆུ་དང་རྣམ་པར་དབེན་པ་དང་། །དགེ་སློང་འདུལ་བ་བྱས་པ་དང་། །ཡོངས་སུ་སྦྱང་བ་བྱས་པ་དང་། །གཙང་སྦྲའི་སྤྱོད་པ་སྔོན་འགྲོ་བས། །སློབ་དཔོན་རང་གི་ལྷག་གནས་ཆེད། །ཕྱེ་མ་ཐམས་ཅད་བདུག་པ་བྲི། །གཏོར་མ་དང་ནི་མར་རྣམས་ནི། །ཆོ་ག་ཅན་གྱིས་བྱེད་དུ་གཞུག །དེ་ནས་སློབ་དཔོན་ཡོ་བྱད་ཀུན། །ཚོགས་ནས་དཀྱིལ་འཁོར་རང་ཉིད་བྲེ། །སློབ་མ་ཡོངས་སུ་བཟུང་བར་གྱིས། །དེ་རྣམས་སངས་རྒྱས་ཆོས་དང་ནི། །དགེ་སློང་དགེ་འདུན་ལ་རབ་དང་། །ཡན་ལག་ཆ་ཤས་ཀུན་རྫོགས་པ། །བདེན་པར་སྨྲ་དང་སྤོམ་པ་མིན། །མཛེས་པ་མཐོང་དང་ཁ་དོག་གཙིགས། །གཟུང་བར་མི་བྱ་གཅིག་གཉིས་གསུམ། །བཅྭ་བརྒྱད་དང་ནི་གཞན་བཅུ་དྲུག །དེ་རྣམས་སྐྱབས་གསུམ་ཡོངས་སུ་འཛིན། །བྱང་ཆུབ་སེམས་ནི་བསྐྱེད་པ་དང་། །འོ་མའི་སྟོན་མོ་བཟའ་བ་དང་། །འོ་མའི་ཤིང་ལས་བྱུང་བ་ཡི། །སོ་ཤིང་སོར་མོ་བརྒྱད་ཀྱི་ཚད། །བཅོམ་ལྡན་རྩ་བའི་སྙིང་པོ་ཡིས། །ལན་ནི་ཉི་ཤུ་རྩ་བདུན་དུ། །མངོན་པར་བསྔགས་ནས་བ་ཡི་གཅིན། །རབ་སྦྱར་མཚན་མོའི་ཐུན་མཚམས་སུ། །དཀྱིལ་འཁོར་ས་གཞི་ཕྱི་རོལ་དུ། །ཤར་དུ་མངོན་ཕྱོགས་ཀུ་ཤ་ཡི། །ཁྲེས་ལ་རིམ་པས་ཉེར་འདུག་ནས། །སྙིང་པོ་རེ་རེ་ལག་པར་བྱིན། །རྩ་བའི་སྙིང་པོ་ལན་བདུན་བཟླས། །གཙུག་ཏོར་བཅིང་ལའང་བདུན་བཟླས་བྱ། །དེ་ནས་སོ་ཤིང་དེ་རྣམས་ལ། །བྱིན་ནས་རང་རང་སོ་ཤིང་བཟའ། །རལ་གཅིག་མ་ཡི་སྙིང་པོ་ཡིས། །ལན་བདུན་བསྔགས་པའི་དྲི་ཡི་ཆུས། །སྤྱི་བོར་མངོན་པར་གཏོར་བར་བྱ། །དེ་ནས་དེ་རྣམས་ལ་བརྗོད་བྱ། །"],["ཚ 146a","བཅོམ་ལྡན་འཕགས་པ་སྤྱན་རས་གཟིགས། །དབང་ཕྱུག་མཆོག་གི་ཐུགས་རྗེ་ཅན། །ཆེན་པོའི་མཆོག་ནི་སྦྱིན་པ་པོ། །བསྒྲལ་དཀའ་སྒྲོལ་བ་དྲན་པར་གྱིས། །བཅོམ་ལྡན་འདས་མ་སྒྲོལ་མ་ཡང་། །རིག་པའི་རྒྱལ་མོ་ཆེན་མོ་སྟེ། །སངས་རྒྱས་བྱང་ཆུབ་སེམས་དཔའ་ཀུན། །སྐྱེད་པར་བྱེད་མ་དྲན་པར་གྱིས། །དེ་ཡི་འོག་ཏུ་སློབ་དཔོན་གྱིས། །སློབ་མ་དེ་རྣམས་ཀུན་ལ་ནི། །འདོད་ཆགས་བྲལ་དང་ལྡན་པའི་ཆོས། །བརྟན་པར་བྱས་ནས་དེ་རྣམས་མདུན། །ཤེས་རབ་ཕ་རོལ་ཕྱིན་བཀླག་བྱ། །དེ་ལྟ་བུ་ཡི་ཆོ་ག་ཡིས། །བུད་མེད་རྣམས་ཀྱང་ཡོངས་གཟུང་བྱ། །ལངས་ནས་བུ་མོས་བཀལ་བ་ཡིས། །སྲད་བུ་ཚོན་སྣ་ལྔ་པ་ནི། །མི་མཉམ་རྒྱུད་དུ་བསྒྲིམ་པ་ལ། །དྲི་ཡི་ཆུ་ཡིས་མངོན་བཀྲུས་ནས། །རེ་རེར་པདྨའི་བགྲང་ཕྲེང་གིས། །བསང་གཏོར་བྱས་ནས་རྩ་བ་ཡི། །སྙིང་པོ་ལན་གྲངས་ཉེར་གཅིག་ཏུ། །མངོན་བསྔགས་དེ་ལ་འདིར་བརྗོད་བྱ། །དཔལ་གྱི་གཞི་ནི་ཡོད་པའི་ཕྱིར། །སངས་རྒྱས་རྣམས་ཀྱི་ཞབས་མཚན་མ། །བྱང་ཆུབ་སེམས་དཔའ་འབྱུང་བ་སྟེ། །པདྨའི་བགྲང་ཕྲེང་དེ་ཕྱིར་བསྔགས། །དེ་ནས་སློབ་དཔོན་རང་ཉིད་ཀྱིས། །སློབ་མ་རྣམས་ལ་ཆ་ཕྲ་མོས། །ལག་པ་ལ་ནི་བཅིང་བར་བྱ། །སློབ་མ་རྣམས་ལ་གང་ཁོ་ན། །དེ་ཉིད་སློབ་མ་བདག་ཉིད་བྱ། །དེ་ནས་དཀྱིལ་འཁོར་ལྷག་གནས་པ། །ཤར་དུ་མངོན་ཕྱོགས་བླ་གོས་ནི། །ཕྲག་པ་གཅིག་ཏུ་བྱས་ནས་ནི། །པུས་མོ་གཡས་པའི་ལྷ་ང་ནི། །ས་ལ་རབ་ཏུ་བཙུགས་བྱས་ཏེ། །རྩ་བའི་ཕྱག་རྒྱ་བཅིང་བ་དང་། །རྩ་བའི་རིག་པ་བཟླས་པར་བྱ། །སངས་རྒྱས་བྱང་ཆུབ་ཐམས་ཅད་དང་། །རང་རྒྱལ་འཕགས་པ་ཉན་ཐོས་དང་། །ལྷ་ཀླུ་གནོད་སྦྱིན་དྲི་ཟ་དང་། །ལྷ་མིའི་དྲི་དང་མེ་ཏོག་གི །ཕྲེང་བ་ཡོངས་སུ་འཛིན་པ་ཡིས། །ཀུན་ལ་གསོལ་བ་གདབ་པར་བྱ། །དཀྱིལ་འཁོར་གྱི་ནི་སློབ་དཔོན་བདག །ཆེ་གེ་མོ་ཞེས་བྱ་བ་ཡིས། །བཅོམ་ལྡན་འཕགས་མ་སྒྲོལ་མ་ཡི། །དཀྱིལ་འཁོར་བྲི་བར་འཚལ་ལགས་ན། །དེ་དག་རང་ཉིད་བྱོན་པར་མཛོད། །སངས་རྒྱས་བཅོམ་ལྡན་འདས་ཀུན་དང་། །བྱང་ཆུབ་སེམས་དཔའ་རང་སངས་རྒྱས། །ཉན་"],["ཚ 146b","ཐོས་ལྷ་ཀླུ་གནོད་སྦྱིན་དང་། །དྲི་ཟ་ལྷ་མིན་ནམ་མཁའ་ལྡིང་། །མིའམ་ཅི་དང་ལྟོ་འཕྱེ་ཆེ། །རང་གི་རིག་པ་སྔགས་ཚོགས་ཀྱིས། །ཡོངས་བསྐོར་སེམས་ཅན་ཐམས་ཅད་ལ། །རྗེས་སུ་བརྩེ་བས་བྱོན་ནས་ཀྱང་། །བདག་ལ་རྗེས་སུ་གནང་བར་མཛོད། །དེ་ལྟར་ཡང་གཉིས་ཡང་གསུམ་དུ། །དེ་ནས་དཀྱིལ་འཁོར་སློབ་དཔོན་གྱིས། །རྩ་བའི་རིག་པ་བཟླས་པ་དང་། །དཀྱིལ་འཁོར་ས་གཞི་ལ་བལྟས་ནས། །དབུས་སུ་མེ་ཏོག་ཕྲེང་བ་དོར། །གལ་ཏེ་མེ་ཏོག་ཕྲེང་གཡོ་བྱེད། །དེ་ནས་བྱོན་པར་ཤེས་པར་བྱ། །དེ་ནས་སངས་རྒྱས་བྱང་སེམས་ལ། །དྲི་ཡི་ཆུ་ཡིས་མཆོད་ཡོན་དང་། །མེ་ཏོག་ཕུལ་ཅིག་དེ་ནས་ནི། །ཁྲུ་བརྒྱའི་ཕྱི་རོལ་ས་གཞི་ལ། །ཡོངས་སུ་སྦྱང་བ་བྱས་པ་རུ། །ཨ་པཱ་མརྒའི་ཡམ་ཤིང་གིས། །མེ་ནི་རབ་ཏུ་སྦར་བྱས་ནས། །ཤར་དུ་མངོན་ཕྱོགས་ཀུ་ཤ་ཡིས། །རྩ་བའི་སྙིང་པོ་སྦྲང་རྩི་ཞོ། །མར་གྱི་སྲེག་བླུགས་བརྒྱད་བརྒྱར་དབུལ། །དེ་ནས་སངས་རྒྱས་བྱང་སེམས་དང་། །ལྷ་རྣམས་ལ་ཡང་མཆོད་ཡོན་དབུལ། །དེ་ནས་དཀྱིལ་འཁོར་ཕྱོགས་བཞི་རུ། །གསོ་སྦྱོང་ཡོངས་སུ་བླངས་པ་ཡིས། །སྐྱེས་བུ་སྲུང་བའི་ཕྲེང་བ་དང་། །དབང་པོ་ཚང་བ་གཞག་པར་བྱ། །དེ་ལ་འདིར་ནི་བརྗོད་བྱ་སྟེ། །གང་ཞིག་རྣམ་པ་གཞན་བྱ་བ། །སྐྱོང་བ་བྲལ་བར་འགྱུར་བ་སྟེ། །དཀྱིལ་འཁོར་དམ་ཚིག་བརྒྱད་རྣམས་ནི། །ཡང་དག་འབྱུང་བར་མི་འགྱུར་རོ། །དེ་ཕྱིར་ཆོ་ག་བྱས་པ་ཡིས། །སློབ་མས་དམ་ཚིག་ཤེས་པར་འགྱུར། །དེ་ནས་དཀྱིལ་འཁོར་སློབ་དཔོན་གང་། །རབ་གནས་སློབ་མས་ཐབས་ཅིག་ཏུ། །སོང་ནས་ཀུ་ཤ་བཏིང་བ་ལ། །སངས་རྒྱས་བྱང་ཆུབ་སེམས་དཔའ་ཡི། །ཚོགས་ཀུན་རྗེས་སུ་དྲན་པ་ཡིས། །གཡས་པའི་གཞོགས་ཀྱིས་ཉལ་བར་བྱ། །དེ་ནས་ཐོ་རངས་སློབ་དཔོན་གྱིས། །གཙང་མ་ཤར་དུ་ཁ་ཕྱོགས་པས། །རྨི་ལམ་རྣམ་པར་དཔྱད་པར་བྱ། །དེ་ལ་འདི་ནི་བརྗོད་བྱ་སྟེ། །གང་ཞིག་ཙནྡན་བིལ་བ་སོགས། །ཨུ་དུམ་བཱ་ར་སོགས་ནྱ་གྲོ་དྷ། །རྒྱལ་མཚན་ཕྲེང་བས་ཁྱབ་པ་དང་། །རྨི་ལམ་རབ་ཏུ་དད་པའང་རུང་། །ཁ་ཅིག་མེ་ལྕེ་མཛེས་པ་དང་། །དེ་ལྟར་མཐོང་བ་དེ་དངོས་གྲུབ། །མཆོག་གི་བར་དུའོ་ངང་པ་དང་། །ཀཱ་རཎྜ་བ་ཀྲུང་ཀྲུང་དང་། །"],["ཚ 147a","རྨ་བྱ་རོ་ཧ་ཎ་རྣམས་ནི། །གང་ཞིག་དེ་ལྟ་བུ་མཐོང་འགྱུར། །རྨི་ལམ་བར་མའི་དངོས་གྲུབ་དེ། །མྱུར་བ་ཁོ་ནར་འབྱུང་བར་འགྱུར། །མ་འམ་ར་ཧ་ཎ་ཡང་རུང་། །དེ་བཞིན་པི་ཝང་ཐོགས་པ་དང་། །ཀུཎྜ་ལ་སོགས་པ་ཡང་རུང་། །དེ་བཞིན་ཨ་སོགས་དྷི་མཐོང་ན། །གང་ཡང་རྨི་ལམ་མཐོང་བྱེད་པ། །མི་རྣམས་ཐ་མའི་དངོས་གྲུབ་དེ། །སྒྲོལ་མའི་རྟོག་པར་ངེས་པར་བསྟན། །གཏུམ་པོ་ཁྱི་ཡི་ལག་པ་རྣམས། །གང་གིས་མཐོང་བར་གྱུར་པ་དང་། །བོང་བུ་རྔ་མོ་ཤིང་རྟ་སོགས། །མཐོང་དང་རིག་པ་ཉིད་སོགས་སམ། །རྒྱ་སྐྱེགས་ཏིལ་མར་གྱིས་རེག་པ། །གང་གིས་རྨི་ལམ་དུ་འཇུག་པ། །དེ་ཡི་དངོས་གྲུབ་ངེས་པར་གནས། །དམ་ཚིག་ཙམ་དུ་འབྱུང་བར་འགྱུར། །དེ་ལྟ་བུ་སོགས་ཡོན་ཏན་ལྡན། །རྨི་ལམ་བློ་ཡིས་རྣམ་དཔྱད་ནས། །དེ་ལྟར་རབ་བློ་གང་ཤེས་ནས། །སློབ་མ་དེ་ལ་རྨི་ལམ་གྱི། །ལུང་དུ་ཡང་ནི་བསྟན་པར་བྱ། །དེ་ནས་དཀྱིལ་འཁོར་སློབ་དཔོན་ནི། །གལ་ཏེ་ཁྱིམ་གནས་གྱུར་པའམ། །དགེ་སློང་དགེ་སློང་མ་དང་ནི། །དགེ་བསྙེན་དགེ་བསྙེན་མ་ཡང་རུང་། །ཆེན་པོ་དེ་རྣམས་གསོ་སྦྱོང་ནི། །བཟུང་སྟེ་ཕྱི་ནས་སློབ་མ་རྣམས། །གསོ་སྦྱོང་ཡང་དག་གུས་པར་བྱ། །སློབ་མ་རྨི་ལམ་མི་དགེ་བ། །བསྟན་བྱ་སྔོན་དུ་སྦྱིན་སྲེག་བྱ། །དེ་ནས་དཀྱིལ་འཁོར་སློབ་དཔོན་ནི། །སྔ་མ་ཁོ་ན་རས་དང་ནི། །རས་རིས་མཐར་ནི་ཨ་ལཱ་ས། །ཟངས་ལས་འབྱུང་བར་བ་ཞུགས་ཏེ། །ཡང་དག་འཇོག་པར་བྱེད་དུ་གཞུག །དེ་ནས་དཀྱིལ་འཁོར་ས་གཞི་ལ། །ཙནྡན་ཆུ་ཡིས་ལེགས་པར་བྱུག །སློབ་མ་ཐམས་ཅད་གནས་ཅིག་ཏུ། །སྙིང་པོས་བསྲུང་བ་བྱས་ནས་ནི། །དཀྱིལ་འཁོར་ཕྱི་ཡི་གནས་གཅིག་ཏུ། །ཉེར་འདུག་དམ་ཚིག་ཤེས་པ་རྣམས། །ནང་དུ་རབ་ཏུ་གཞུག་པར་བྱ། །དེ་ནས་ཉི་མ་ནུབ་དུས་སུ། །དཀྱིལ་འཁོར་ཐིག་ནི་གདབ་པར་བྱ། །བུ་མོས་བཀལ་བའི་སྲད་བུ་ནི། །ཚོན་སྣ་ལྔ་པ་རྩ་བ་ཡི། །སྙིང་པོ་ལན་བདུན་བསྔགས་བྱས་ཏེ། །དབང་ལྡན་ཕྱོགས་ནས་བརྩམས་ནས་ནི། །ཕུར་བུ་དེ་རྣམས་སྲད་བུས་བཅིངས། །དེ་དག་ཐམས་ཅད་ཁྲུ་ཡི་ཚད། །གསུམ་བྱས་སྲད་བུས་ཡོངས་དཀྲི་བྱ། །ཕྱི་ནས་"],["ཚ 147b","ཀུན་ཏུ་དུང་དང་ནི། །རྔ་བོ་ཆེ་དང་རྫ་རྔ་དང་། །འཁར་རྔ་རྣམ་པ་སྣ་ཚོགས་པའི། །འཁར་བ་དང་ནི་ཕེག་རྡོབ་རྣམས། །ཀུན་ནས་འཁྲོལ་བར་བྱེད་དུ་གཞུག །གདུགས་དང་རྒྱལ་མཚན་བ་དན་སོགས། །ཕྱི་རོལ་དུ་ནི་དགྲམ་པར་བྱ། །དཀྱིལ་འཁོར་གྲུ་བཞི་སྒོ་བཞི་པ། །ཚོན་སྣ་ལྔ་པའི་ཐིག་སྐུད་ཀྱིས། །ཁྲུ་བརྒྱར་བྱས་ནས་ཐིག་གདབ་བྱ། །དེ་ལམ་དཀྱིལ་འཁོར་གཉིས་པ་སྟེ། །དེ་ནས་ཁ་དོག་ཐམས་ཅད་པ། །རྩ་བའི་ཕྱག་རྒྱ་བཅིངས་ནས་ནི། །རྩ་བའི་རིག་པ་བརྒྱད་བརྒྱར་བཟླས། །དེ་ནས་དཀྱིལ་འཁོར་སློབ་དཔོན་ནི། །སངས་རྒྱས་བྱང་ཆུབ་སེམས་དཔའ་ཀུན། །རང་སངས་རྒྱས་དང་འཕགས་པ་ཡི། །ཉན་ཐོས་དགེ་འདུན་རྣམས་ལ་ནི། །ཕྱག་བྱས་དཀྱིལ་འཁོར་ཁོར་ཡུག་ཏུ། །རྒྱང་གྲགས་ལྔ་པ་ལྷག་གནས་ཆེ། །རལ་པ་གཅིག་པའི་སྙིང་པོ་ཡིས། །གདུག་པའི་སེམས་ཅན་ཐམས་ཅད་ཀྱི། །སེམས་ནི་བཅིང་བར་བྱ་བའོ། །དཀྱིལ་འཁོར་ཡང་ནི་ཐམས་ཅད་ཀྱི། །སློབ་དཔོན་གྱི་ནི་ཡོ་བྱད་རྣམས། །རལ་གཅིག་སྙིང་པོ་ཉིད་ཀྱིས་ནི། །ཐོག་མར་བསྲུང་བ་བྱས་ནས་ནི། །བྱང་ཤར་ཕྱོགས་ནས་བརྩམས་བྱས་ཏེ། །ཚངས་པའི་ཐིག་ནི་གདབ་པར་བྱ། །རྩ་བའི་རིག་པ་ཟློས་པ་ཉིད། །དཀྱིལ་འཁོར་ཐམས་ཅད་མཁས་པས་བྲིས། །ཡོངས་སུ་བཅད་ཅིང་ལུས་དཀར་བའི། །སློབ་དེ་དེ་བཞིན་གཤེགས་རྣམས་ལ། །ཕྱག་བྱ་རིན་ཆེན་ཕྱེ་མས་སོ། །པདྨའི་རིགས་ལ་ཕྱག་བྱས་ཏེ། །ཕྱེ་མ་སེར་པོས་བཅོམ་ལྡན་མ། །འཕགས་མ་སྒྲོལ་མ་ཕྱག་བྱས་ནས། །ལྗང་གུ་རྣམས་ཀྱིས་ཉན་ཐོས་ཀུན། །རང་སངས་རྒྱས་ཀུན་ཕྱག་བྱས་ནས། །ནག་པོས་རྡོ་རྗེའི་རིགས་ལའོ། །དེ་ལྟར་དང་པོས་དཀྱིལ་འཁོར་གྲུ་བཞི་སྒོ་བཞི་བའི་སྙིང་པོར་རོ། །ཕྱི་ནས་གཉིས་ལ་ཁྲུ་གཉིས་ཀྱི་ཚད་དུ་རབ་ཏུ་འཇུག་པར་བྱེད་པའོ། །གསུམ་པ་མཐོ་གང་པ་དེའི་ཉིས་འགྱུར་རོ། །དེ་ལྟར་ཐམས་ཅད་དུ་རིམ་གྱིས་བྲིས་ནས་ནང་གི་དཀྱིལ་འཁོར་དུ་བྲི་བར་འདོད་པས་སངས་རྒྱས་བཅོམ་ལྡན་འདས་དང་བྱང་ཆུབ་སེམས་དཔའ་དང་རང་སངས་རྒྱས་ཐམས་ཅད་དེར་རང་བྱོན་པར་མཛད་དུ་གསོལ། །འབྲུ་ཐམས་ཅད་དང་རིན་པོ་ཆེ་ཐམས་ཅད་དང་སྨན་ཐམས་ཅད་དང་། དྲི་དང་མེ་ཏོག་ཐམས་ཅད་དང་། ཙནྡན་གྱི་ཆུས་ཡོངས་སུ་བཀང་བ། མཱ་ཥའི་ཡལ་འདབ་ཀྱིས་ཁ་བཀབ་པ། དུ་ཀུ་ལའི་རས་"],["ཚ 148a","དཀར་པོས་མགྲིན་པ་བཅིངས་པ། གསེར་དང་དངུལ་ལས་བྱུང་བ། དཀྱིལ་འཁོར་དེའི་ཡོ་བྱད་ཐམས་ཅད་རིས་གཉིས་པའི་མཐར་མེ་ཏོག་གི་ཕྲེང་བས་དཀྲིས་ནས་རྩ་བའི་རིག་པས་བསྔགས་པ་དེ་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ཞེས་བྱ་བ་སྟེ། སྙིང་པོའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་གཞག་པར་བྱའོ། །དེ་ལ་འདི་བརྗོད་པར་བྱ་སྟེ། དམ་ཚིག་དོན་དང་བསོད་ནམས་དོན། །འདོད་དོན་སོ་སོར་དམིགས་བྱེད་དུ། །སྡོམ་པ་གཟུང་བར་བྱས་གྱུར་ནས། །གང་དུ་གནས་པ་ཐམས་ཅད་ནས། །དཀྱིལ་འཁོར་མཆོག་འདི་བྲི་བར་བྱ། །གཞན་གྱིས་མི་ཐུབ་ཐུགས་རྗེ་ཆེ། །སངས་རྒྱས་བྱམས་པ་སྤྱན་མར་བཅས། །འདི་རྣམས་མིང་ནི་ཀུན་དྲངས་ནས། །དེ་བཞིན་གཤེགས་པ་བྲི་བར་བྱ། །འཇིག་རྟེན་གསུམ་རྒྱལ་དཀར་མོར་གྲགས། །དེ་བཞིན་དུ་ནི་ཁྲོ་གཉེར་ཅན། །ཁྲོས་མ་ཞེས་ནི་གྲགས་པ་སྟེ། །འདི་རྣམས་མིང་ནི་ཀུན་དྲན་ནས། །སྤྱན་རས་གཟིགས་ནི་བྲི་བར་བྱ། །རིག་པ་མཆོག་ལས་སླར་འཇིགས་བྱེད། །རྡོ་རྗེ་སེར་སྐྱ་རྡོ་རྗེ་ནི། །དྲག་པོར་བཞེད་དང་སེང་གེ་དང་། །དེ་བཞིན་རྡོ་རྗེ་ཁུ་ཚུར་ཉིད། །འདི་རྣམས་མིང་ནི་ཀུན་ནས་ནི། །ཕྱག་ན་རྡོ་རྗེ་ཀུན་ཏུ་བྲི། །དེ་ནས་དཀྱིལ་འཁོར་སློབ་དཔོན་གྱིས། །སྙིང་པོའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཕྱེ་མ་དཀར་པོ་དང་། ཡུངས་ཀར་དཀར་པོ་བསྲེས་པས་སངས་རྒྱས་བཅོམ་ལྡན་འདས་རིན་པོ་ཆེའི་སེང་གེའི་གདན་ལ་ཉེ་བར་བཞུགས་པ་ཆོས་སྟོན་པར་མཛད་བཞིན་པ། འོད་ཀྱི་དཀྱིལ་འཁོར་འོད་ཀུན་ཏུ་འཕྲོ་བ། གཙུག་ཏོར་ནས་འོད་ཟེར་འབྱུང་བཞིན་པའི་བཅོམ་ལྡན་འདས་རྣམ་པ་མཆོག་ཐམས་ཅད་དང་ལྡན་པ་སྐྱེས་བུ་ཆེན་པོའི་མཚན་གྱིས་བརྒྱན་པ་དང་པོར་བྲིས་ཤིང་། བཅོམ་ལྡན་འདས་ཀྱི་སྟེང་གི་གཞོགས་གཉིས་སུ་ཕྱེ་མ་སེར་པོ་དང་། པདྨ་གེ་སར་ཕན་ཚུན་བསྲེས་པས་གཙུག་ཏོར་གྱི་རྒྱལ་པོ་རྣམས་ཀུན་ནས་འབར་བའི་ཕྲེང་བས་འཁྲུགས་པ་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་ཆེན་པོའི་གཟུགས་དང་། ཆ་བྱད་དང་། དབྱིབས་ཀྱི་རྣམ་པ་ཅན་རབ་ཏུ་དང་བའི་སྐུ་དེ་བཞིན་གཤེགས་པ་ལ་མངོན་པར་ཕྱོགས་པ། ས་བོན་གྱིས་གང་བ་དང་། འབྲས་བུ་ཕྱག་ན་བསྣམས་པ་ལ་འདི་ལྟ་སྟེ། བཅོམ་"]]}