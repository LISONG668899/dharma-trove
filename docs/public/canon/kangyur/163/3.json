{"t":"163","p":3,"paras":[["བ 158a","ཐུབ་པ་ཆེ་ལ་མཆོད་པ་བྱས། །བྱང་ཆུབ་སེམས་དཔའ་ཐམས་ཅད་ལ། །གསེང་ཐགས་ཀྱི་ནི་གོས་ཕུལ་ལོ། །བྱང་ཆུབ་ཤིང་དག་སྤྲུལ་ནས་སུ། །དེའི་དྲུང་སེང་གེའི་ཁྲི་བཤམས་ལ། །སྟོང་ཕྲག་བྱེ་བ་ཉི་ཤུ་ལྔ། །དེ་རྣམས་ལ་ནི་འཁོད་གྱུར་པ། །ལོ་ནི་བྱེ་བ་གྲངས་སྙེད་པར། །བགྲང་བ་དག་ཏུ་མི་ཆོད་པའི། །བྱང་ཆུབ་སེམས་དཔའ་ཐམས་ཅད་ནི། །བྱེ་བ་བརྒྱ་ཕྲག་ལྷགས་པར་གྱུར། །ཤར་གྱི་ཕྱོགས་ནས་བཟུང་ནས་སུ། །ལྷོ་ཕྱོགས་ནུབ་ཕྱོགས་བྱང་ཕྱོགས་དང་། །འོག་དང་སྟེང་དང་དེ་བཞིན་དུ། །ཕྱོགས་དག་གི་ཡང་མཚམས་ནས་ལྷགས། །ཇི་ཙམ་མིག་གིས་མཐོང་བའི་བར། །དེ་སྲིད་འཇིག་རྟེན་ཁམས་རྣམས་སུ། །སྐྱོབ་པ་འཇིག་རྟེན་མགོན་པོ་ཡི། །གསེར་གྱི་མདོག་འདྲའི་འོད་ཀྱིས་གང་། །སྟོན་པ་གང་ན་བཞུགས་པ་དང་། །ཆོས་ནི་གང་ན་འབར་བ་དེར། །འཇིག་རྟེན་ཁམས་ནི་ཐམས་ཅད་ནས། །བྱང་ཆུབ་སེམས་དཔའ་ཉེ་བར་ལྷགས། །དེ་ལྟར་མཐའ་ཡས་དཔག་ཏུ་མེད། །བསམ་གྱིས་མི་ཁྱབ་མཆོད་པ་ནི། །རིན་ཆེན་དྲ་བ་ལིཙྪ་བཱི། །གཞོན་ནུ་དེ་ཡི་ཚེ་ན་བྱས། །དེ་ནས་བདག་ཉིད་ཆེན་པོ་པ། །ལྷ་དང་ཀླུ་དང་མི་རྣམས་ཀྱིས། །མདུན་དུ་མི་མཆོག་ཤཱཀྱ་ཡི། །སེང་གེས་དབུགས་ནི་འབྱིན་པར་མཛད། །ང་ཡི་མདུན་དུ་འདུག་ནས་སུ། །ཁྱོད་ཀྱིས་འདི་འདྲའི་མཆོད་བྱས་པ། །གང་གཱའི་བྱེ་མ་ཇི་སྙེད་པ། །དེ་སྙེད་མཆོད་པ་དག་གིས་མཆོད། །རིན་ཆེན་དྲ་བ་ཅན་གྱི་ཕྱིར། །མདོ་སྡེ་བཤད་པ་སུས་རིག་པ། །བྱང་ཆུབ་ལས་ནི་མི་ལྡོག་སྟེ། །སངས་རྒྱས་སྨྲ་བའི་མཆོག་ཏུ་འགྱུར། །གང་ཞིག་མདོ་སྡེ་འདི་འཛིན་པའི། །བསོད་ནམས་ཕུང་པོའི་ཚད་དག་ནི། །འདི་སྙེད་སོགས་པར་འགྱུར་རོ་ཞེས། །དེ་ལྟར་བཤད་པར་མི་ནུས་སོ། །ཕྱོགས་བཅུའི་འཇིག་རྟེན་ས་དང་ཆུ། །མེ་དང་རླུང་གི་ཚད་དག་ནི། །འདི་ཙམ་ཞེས་ནི་བཤད་པར་ནུས། །བསོད་ནམས་ཕུང་པོ་བཤད་མི་ནུས། །དགེ་སློང་ངམ་ནི་དགེ་སློང་མ། །དགེ་བསྙེན་འམ་ནི་དགེ་བསྙེན་མ། །གང་གིས་མདོ་སྡེ་འདི་ཐོས་ནས། །ལྷ་དང་ཀླུ་དང་ལྟོ་འཕྱེ་ཆེ། །སེམས་ཅན་ཐམས་ཅད་ཉེར་ལྷགས་པས། །དེ་ཡི་གཟི་བརྗིད་མི་བཟོད་དེ། །མེ་ནི་བསིལ་བར་འགྱུར་སྲིད་ཀྱི། །དེ་ཡི་གཟི་"],["བ 158b","བརྗིད་ཉམས་པ་མེད། །མདོ་སྡེ་འདི་ནི་གང་འཛིན་པ། །བྱང་ཆུབ་སྤྱད་པ་སྤྱོད་པའི་ཚེ། །སེམས་ཅན་ཀུན་གྱིས་བསྟེན་བྱ་ཞིང་། །བྱང་ཆུབ་སེམས་ལའང་མཆོད་པ་བྱེད། །གང་ཞིག་སྟོབས་དང་ལྡན་པའི་མིས། །བྱེ་བ་སྟོང་དུ་བཤད་པ་ཡི། །སྐྲ་རྩེས་སྟོང་གི་འཇིག་རྟེན་ཁམས། །བསྐལ་པ་བྱེ་བ་བཟུང་བ་བས། །གང་ཞིག་ཕྱི་མའི་དུས་དག་ཏུ། །སངས་རྒྱས་བྱང་ཆུབ་གླེང་གཞི་ནི། །འདི་འདྲའི་རྣམ་པས་ཐོས་ནས་སུ། །གཞན་དག་ལ་ཡང་སྟོན་བྱེད་ན། །གང་ཞིག་སྔར་ནི་རབ་བསྒྲགས་པ། །འདི་ཡི་ངོ་མཚར་ཆེན་པོ་ཡི། །བརྒྱ་དང་གྲངས་དང་བགྲང་བ་དང་། །དཔེར་ཡང་འགྱུར་བ་མ་ཡིན་ནོ། །ཕྱི་མ་ཡི་ནི་དུས་དག་ཏུ། །འདི་འདྲའི་རྣམ་པ་སེང་གེའི་སྒྲ། །བསྟན་པ་བླ་མེད་ཐོས་གྱུར་ཀྱང་། །འགལ་མེད་དོན་མེད་འགྱུར་བར་འོང་། །འཇིག་རྟེན་མགོན་པོ་རྫོགས་སངས་རྒྱས། །འོད་མཛད་གང་གིས་འདིར་མཐོང་བ། །ཕྱི་མའི་དུས་སུ་དེས་ཐོས་ནས། །ཞེ་ས་གུས་པར་བྱེད་པར་འགྱུར། །གལ་ཏེ་ཞིང་རྣམས་བྱེ་བ་ན། །སེམས་ཅན་གང་དག་འཁོད་དེ་དག །སངས་རྒྱས་ཡེ་ཤེས་ལྡན་གྱུར་ལ། །གང་གཱ་ཡི་ནི་བྱེ་མ་སྙེད། །བསྐལ་པ་དུ་མ་བརྒྱ་དག་ཏུ། །རིམ་གྲོ་དག་ནི་བྱེད་པ་དང་། །ཇི་ལྟར་སྟོང་ཆེན་གྱི་ནི་འཇིག་རྟེན་ཁམས། །དེ་སྙེད་དག་གི་གཙུག་ལག་ཁང་མཆོག་ནི། །དབུལ་བྱ་ལྷ་ཡི་ཙན་དན་དག་ལས་བྱས། །ལྷ་ཡི་གཙུག་ལག་ཁང་མཆོག་རེ་རེ་ལའང་། །བྱེ་བ་ཕྲག་སྟོང་དག་གི་ཁང་བཟངས་བྱས། །བྱེ་བ་ཕྲག་སྟོང་དག་གི་ཁང་བཟངས་ཀྱང་། །དབུལ་བྱ་ལྷ་ཡི་རིན་ཆེན་དག་ལས་བྱས། །རེ་རེའི་ཁྲི་དག་བཤམས་ནས་རིམ་གྲོ་པ། །བྱེ་བ་ཕྲག་བརྒྱ་ཤིན་ཏུ་ཚང་བར་བཀོད། །མཁས་པས་དེ་ནི་རིན་ཆེན་དྲ་བ་དག །བླངས་ནས་དེ་ཚེ་ཁྲི་དེ་བརྒྱན་པ་རྣམས། །གང་གཱའི་བྱེ་སྙེད་བསྐལ་པ་བྱེ་བ་བརྒྱར། །ཐུབ་ཆེན་འཇིག་རྟེན་སྤྱོད་པ་བཞུགས་པ་ཡི། །སངས་རྒྱས་གཅིག་ལ་འབུལ་བྱ་དབུལ་བ་དང་། །ཇི་ལྟར་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད། །ཡོངས་སུ་མྱ་ངན་འདས་ཀྱི་མཆོད་རྟེན་བྱས། །ཇི་ལྟར་སྟོང་ཆེན་འཇིག་རྟེན་ཁམས་རྣམས་སུ། །སངས་རྒྱས་གཅིག་གི་མཆོད་རྟེན་བྱས་པ་ནི། །རིན་ཆེན་རང་བཞིན་ལྷ་ཡི་སྒོ་སྟོང་ལྡན། །ཤིན་ཏུ་"],["བ 159a","ལེགས་པར་སྲིད་པའི་རྩེ་སྲིད་མཐོ། །ཇི་ལྟར་གང་གཱའི་ཀླུང་གི་བྱེ་སྙེད་ཀྱི། །གདུགས་ནི་མཆོད་རྟེན་གཅིག་ལ་འབུལ་བར་བྱེད། །དེ་ཚེ་རེ་རེ་གདུགས་ལ་མུ་ཏིག་གི། །རྒྱན་ཕྲེང་བྱེ་བ་རྣམས་ཀྱང་ཤིན་ཏུ་བཀྲམ། །ཇི་ལྟར་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད། །བྱེ་བའི་འཕན་དང་རིན་ཆེན་སྣ་ཚོགས་ཀྱི། །རྒྱལ་མཚན་བྱེ་བ་ཕྲག་བརྒྱ་གང་གཱ་ཡི། །བྱེ་སྙེད་མཆོད་རྟེན་དག་ལ་འབུལ་བར་བྱེད། །སྣང་བ་མཛད་པ་ཐམས་ཅད་མཁྱེན་གཅིག་གི། །མཆོད་རྟེན་གཅིག་ལ་སིལ་སྙན་བྱེ་བ་སྟོང་། །དཀྲོལ་ཅིང་གུས་པའི་མི་ནི་ས་ཡ་དག །བྱེ་བ་ཕྲག་སྟོང་ཚང་བ་འབུལ་བར་བྱེད། །མེ་ཏོག་གདུགས་བརྒྱ་དུ་མ་མཆོད་རྟེན་ལ་འབུལ་བ། །ཐུབ་པ་ཆེ་ལ་དེ་འདྲའི་མཆོད་པ་ཉིན་གཅིག་བཞིན། །གང་གཱའི་བྱེ་སྙེད་བསྐལ་པ་སྟོང་དུ་བྱེད་པ་བས། །གང་ཞིག་མདོ་སྡེ་འདི་ལས་ཚིགས་བཅད་གཅིག་ཐོས་ནས། །སོམ་ཉི་མེད་ཅིང་འདུན་པ་སྐྱེད་བྱེད་ལ། །རྒྱལ་བའི་མཚན་འདི་དག་ཀྱང་རྗོད་བྱེད་ན། །དེ་བས་བསོད་ནམས་འདི་ནི་བླ་མེད་མཆོག །མཁས་པ་ཏིང་ངེ་འཛིན་གྱི་མིང་ཐོས་ཤིང་། །ཚུལ་ཁྲིམས་སྐྱོན་མེད་མཚན་འདི་འཛིན་པ་དང་། །དེ་བཞིན་སངས་རྒྱས་ལ་ནི་མཆོད་བྱེད་པ། །དེས་ནི་གང་གཱའི་བྱེ་སྙེད་སངས་རྒྱས་མཐོང་། །ཐུབ་ཆེན་རྐང་གཉིས་མཆོག་གྱུར་དེ་དག་ལ། །མཆོད་པ་དམ་པའང་ཡིད་ཀྱིས་བྱས་ནས་ནི། །རྟག་ཏུ་མྱོས་མེད་ཆོས་ཀྱང་སྟོན་བྱེད་ཅིང་། །བསྐལ་པ་བྱེ་བ་དེ་ནི་རྨོངས་མེད་འགྱུར། །འཇིག་རྟེན་མགོན་པོས་མདོ་མཆོག་རྒྱལ་པོ་འདི། །སྟོན་པའི་ཚེ་ན་གང་གིས་སྔོན་མཐོང་བ། །རྒྱལ་བ་མཆོག་ལས་འདི་ནི་ཐོས་གྱུར་ནས། །ཕྱི་མའི་དུས་སུ་དེ་ནི་དགའ་བས་འཛིན། །དྲི་ང་ཕྱི་སའི་བུམ་པ་མིས་འདོར་ལྟར། །འདོད་པ་སྐྱོན་དུ་བགྲང་བ་སྤོང་བྱེད་ཅིང་། །མཁས་པ་ངེས་འབྱུང་ཞི་ལ་མངོན་དགའ་སྟེ། །རྟག་ཏུ་མྱོས་མེད་དགོན་པ་སྟེན་པར་བྱེད། །ཡངས་པའི་གྲོང་ཁྱེར་མཆོག་ཏུ་གནས་ནས་སུ། །དེར་ནི་བཤད་ཚེ་གང་གིས་ང་མཐོང་ཞིང་། །དྲ་བའང་ང་ལ་མཆོད་བྱེད་མཐོང་བ་ནི། །ཕྱི་མའི་དུས་སུ་མདོ་མཆོག་འདི་འཛིན་ཏོ། །ངའི་བུ་གང་ཞིག་རྟག་ཏུ་རྗེས་འབྲང་ཞིང་། །བྱང་ཆུབ་ཞི་བ་སྤྱོད་མཆོག་སྤྱོད་པ་ན། །སེམས་ཅན་རྣམས་ནི་རྟག་ཏུ་འདུལ་བྱེད་པ། །"],["བ 159b","ཕྱི་མའི་དུས་སུ་མདོ་མཆོག་འདི་འཛིན་ཏོ། །སངས་རྒྱས་འདྲེན་པ་གཞལ་མེད་དཔག་མེད་ཀྱི། །སྤྱད་པ་སྤྱོད་ཚེ་གང་གིས་རིམ་གྲོ་དང་། །དེ་བཞིན་མཆོད་པ་མཆོག་དག་བྱེད་པ་ནི། །དེ་ནི་ཕྱི་དུས་རྒྱལ་མཆོག་ཆོས་འཛིན་ཏོ། །གང་ཞིག་བསྐལ་པ་བྱེ་བར་ཚངས་སྤྱོད་ཅིང་། །འཇིག་རྟེན་མཐའ་ཡས་དོན་ནི་སྔར་སྤྱད་པ། །གང་ཞིག་ཕྱི་མའི་དུས་སུ་མདོ་སྡེ་འདི། །ཐོས་པའི་བསོད་ནམས་གྲངས་སུ་འགྱུར་མ་ཡིན། །སངས་རྒྱས་འཁྲུགས་མེད་ཡང་ན་ཚེ་དཔག་མེད། །སངས་རྒྱས་གཞལ་མེད་དཔག་མེད་དེ་དག་འདིར། །སེམས་ཅན་སྙིང་པོ་གང་གིས་མཐོང་འདོད་པ། །མདོ་སྡེ་མཛེས་པ་དཔག་མེད་བཟུང་བར་གྱིས། །ཚེ་དཔག་མེད་དང་མི་འཁྲུགས་དྲི་མེད་འོད། །སེང་གེ་དང་ནི་ཏོག་དང་དེ་བཞིན་དུ། །གང་ཞིག་སངས་རྒྱས་དེ་ཀུན་མཐོང་འདོད་པ། །ཕྱི་མའི་དུས་སུ་རྒྱལ་མཆོག་ཆོས་ཟུང་ཤིག །སངས་རྒྱས་བྱམས་པ་དང་ནི་དྲི་མེད་འོད། །བདག་ཉིད་ཆེན་པོ་དང་ནི་སེང་གེ་ཏོག །རབ་སྣང་གཙོ་བོ་དེ་བཞིན་མཐོང་འདོད་པ། །དེ་ནི་ཕྱི་དུས་རྒྱལ་མཆོག་ཆོས་ཟུང་ཤིག །འདི་འདྲའི་མདོ་སྡེ་ཁྱད་པར་འཕགས་མཆོག་དག །རིན་ཆེན་དྲ་བ་ཅན་ལ་ང་ཡིས་བཤད། །ཕྱི་མའི་དུས་སུ་དེ་ཚེ་ཁྱོད་ཀྱིས་ནི། །བག་མེད་གནས་ལ་འདུག་པར་མ་བྱེད་ཅིག །ཕྱི་མའི་དུས་ཀྱི་ཚེ་རུ་གྱུར་པ་ན། །ཚུལ་ཁྲིམས་སྐྱོན་མེད་རྟག་ཏུ་བག་བྱོས་དང་། །དེ་ནས་ཁྱོད་ནི་འཆི་བའི་དུས་བྱས་ནས། །རྒྱལ་བ་འོད་ཟེར་མཐའ་ཡས་ཅན་གྱི་ཞིང་། །རིན་ཆེན་ལྡན་ཞེས་བྱ་བའི་འཇིག་རྟེན་ཁམས། །སྟེང་གི་འཇིག་རྟེན་ཁམས་སུ་འགྲོ་བར་འགྱུར། །དེ་ནས་ཁྱོད་ནི་འཆི་བའི་དུས་བྱས་ནས། །མྱུར་བ་ཉིད་དུ་སངས་རྒྱས་བྱམས་པ་མཐོང་། །བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྐད་ཅེས་བཀའ་སྩལ་པ་དང་། ལིཙྪ་བཱི་གཞོན་ནུ་རིན་ཆེན་དྲ་བ་ཅན་དང་། བྱམས་པ་ལ་སོགས་པ་བྱང་ཆུབ་སེམས་དཔའ་བྱེ་བ་ཕྲག་བཞི་བཅུ་དང་། དགྲ་བཅོམ་པ་བྱེ་བ་ཕྲག་དྲུག་ཅུ་དང་། ལྷ་བྱེ་བ་ཕྲག་དགུ་བཅུ་རྩ་དགུ་རྣམས་ཡི་རངས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་ལ་མངོན་པར་བསྟོད་དོ། །འཕགས་པ་རིན་ཆེན་དྲ་བ་ཅན་གྱིས་ཞུས་པ་ཞེས་བྱ་བ་ཐེག་པ་ཆེན་པོའི་མདོ་རྫོགས་སྷོ།། །།རྒྱ་གར་གྱི་མཁན་པོ་ཛྙཱ་ན་གར་བྷ་དང་། ལོཙྪ་བ་བནྡེ་ཡེ་ཤེས་སྙིང་པོས་བསྒྱུར། ཞུས་ཆེན་གྱི་ལོཙྪ་བ་བནྡེ་དཔལ་བརྩེགས་ཀྱིས་ཞུས་ཏེ་གཏན་ལ་ཕབ་པ།། །།"]]}