་ཐོས་མ་ཐག་ཏུ་མོས་ཤིང་ཐེ་ཙོམ་འཚལ་བར་མི་འགྱུར་ན། བཅོམ་ལྡན་འདས་རིགས་ཀྱི་བུའམ། རིགས་ཀྱི་བུ་མོ་དེ་བསོད་ནམས་ཇི་ཙམ་ཞིག་སྐྱེད་པར་འགྱུར། བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། ཀུན་དགའ་བོ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་བྱང་ཆུབ་ཏུ་ཡང་དག་པར་ཞུགས་པ་གང་གིས་འཛམ་བུའི་གླིང་འདི་རིན་པོ་ཆེས་ཡོངས་སུ་བཀང་སྟེ། དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའི་སངས་རྒྱས་རྣམས་ལ་དབུལ་བ་ཕུལ་བ་བབས། གང་གིས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ཐོས་མ་ཐག་ཏུ་མོས་ཤིང་དད་དེ་ཡིད་ཆེས་ལ་ཐེ་ཙོམ་མི་ཟ་བ་དེ་དེ་བས་བསོད་ནམས་ཆེས་མང་དུ་སྐྱོད་པར་འགྱུར་རོ། །ཀུན་དགའ་བོ་འཛམ་བུའི་གླིང་རིན་པོ་ཆེས་བཀང་བ་ལྟ་ཞོག་སྟེ། །ཀུན་དགའ་བོ་གང་གིས་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་རིན་པོ་ཆེས་བཀང་སྟེ། དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའི་སངས་རྒྱས་རྣམས་ལ་དབུལ་བ་ཕུལ་བ་བབས། གང་གིས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ཐོས་ལ། ཐོས་ནས་ཀྱང་ཐོས་མ་ཐག་ཏུ་མོས་ཤིང་དད་དེ་ཡིད་ཆེས་ལ་ཐེ་ཙོམ་མི་ཟ་བ་དེ་དེ་བས་བསོད་ནམས་ཆེས་མང་དུ་སྐྱེད་པར་འགྱུར་རོ། །དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་བཀའ་སྩལ་ཏོ། །གང་གིས་འཛམ་བུའི་གླིང་འདི་ནི། །རིན་ཆེན་བཀང་སྟེ་དེ་བཞིན་གཤེགས། །སྐྱོབ་པ་སངས་རྒྱས་འཇིག་རྟེན་མགོན། །རྣམས་ལ་དབུལ་བ་བྱས་པ་བས། །མཁས་པ་གང་གིས་མདོ་སྡེ་འདི། །ཐོས་ནས་ལྷག་པར་མོས་བྱེད་པ།།"],["ཞ 291b","མོས་དང་ལྡན་དེ་བསོད་ནམས་ནི། །དེ་བས་མང་དུ་སྐྱེད་པར་འགྱུར། །གང་གིས་གང་གཱའི་བྱེ་སྙེད་ཀྱི། །ཞིང་དག་རིན་ཆེན་རྣམས་བཀང་སྟེ། །སངས་རྒྱས་རྣམས་ལ་ཕུལ་བ་བས། །འདི་ནི་དེ་བས་ཁྱད་པར་འཕགས།། །།བམ་པོ་དྲུག་པ་སྟེ་ཐ་མ། དེ་སྐད་ཅེས་བཀའ་སྩལ་པ་དང་། ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ། །བཅོམ་ལྡན་འདས་རིགས་ཀྱི་བུའམ། རིགས་ཀྱི་བུ་མོ་གང་ཞིག་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ལ་མོས་ནས་རྟོགས་ཏེ་འཛིན་ཏམ། འཆང་ངམ། ཀློག་གམ། ཀུན་ཆུབ་པར་བགྱིད་དམ། འདོན་ན་བཅོམ་ལྡན་འདས་རིགས་ཀྱི་བུའམ། རིགས་ཀྱི་བུ་མོ་དེ་བསོད་ནམས་ཇི་ཙམ་ཞིག་སྐྱེད་པར་འགྱུར། བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། ཀུན་དགའ་བོ་རིགས་ཀྱི་བུའམ། རིགས་ཀྱི་བུ་མོ་བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་བྱང་ཆུབ་ཏུ་ཡང་དག་པར་ཞུགས་པ་གང་གིས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་དང་བྲལ་བར་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའི་སངས་རྒྱས་རྣམས་ལ་བསྐལ་པ་བརྒྱར་སྦྱིན་པ་སྦྱིན་པ་དང་། ཆོས་ཀྱི་རྣམ་གྲངས་འདི་དང་བྲལ་བར་བསྐལ་པ་བརྒྱར་ཚུལ་ཁྲིམས་སྲུང་བ་དང་། ཆོས་ཀྱི་རྣམ་གྲངས་འདི་དང་བྲལ་བར་བསྐལ་པ་བརྒྱར་བཟོད་པ་སྒྲུབ་པ་དང་། ཆོས་ཀྱི་རྣམ་གྲངས་འདི་དང་བྲལ་བར་བསྐལ་པ་བརྒྱར་བརྩོན་འགྲུས་རྩོམ་པ་དང་། ཆོས་ཀྱི་རྣམ་གྲངས་འདི་དང་བྲལ་བར་བསྐལ་པ་བརྒྱར་བསམ་གཏན་རྣམས་ལ་སྙོམས་པར་འཇུག་པ་དང་། ཆོས་ཀྱི་རྣམ་གྲངས་འདི་དང་བྲལ་བར་བསྐལ་པ་བརྒྱར་ཤེས་རབ་སྒོམ་ཞིང་འཇིག་རྟེན་གྱི་གནས་རྣམས་ལ་མཁས་པར་གྱུར་ན། ཀུན་དགའ་བོ་དེས་ནི་དེ་བཞིན་གཤེགས་པ་ལ་བཀུར་སྟི་བྱས་པར་མི་འགྱུར་རོ། །དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་བཀའ་སྩལ་ཏོ། །གང་གིས་བསྐལ་པ་བརྒྱ་ཚང་བར། །བཟའ་བ་ལ་སོགས་ཐམས་ཅད་ཀྱིས། །དེ་བཞིན་གཤེགས་ལ་བསྙེན་བཀུར་བ། །དེས་ནི་བསྟི་སྟང་བྱས་མི་འགྱུར། །འབྲས་བུར་དམིགས་པ་འཇོམས་བྱེད་པའི། །མདོ་སྡེ་འདི་ནི་གང་འཛིན་པ། །དེ་ནི་སངས་རྒྱས་བཀུར་"],["ཞ 292a","སྟི་བྱས། །ཆོས་ཀྱི་བཀུར་སྟི་བྱས་པ་ཡིན། །རྫོགས་པའི་སངས་རྒྱས་ཆོས་ཀྱི་སྐུ། །ཆོས་སྐྱེས་ཆོས་ཀྱི་ཏོག་ལྡན་པས། །སངས་རྒྱས་རྣམས་ལ་བཀུར་སྟི་འདི། །དེས་ན་སངས་རྒྱས་བཀུར་སྟི་བྱས། །གང་གིས་བསྐལ་པ་བརྒྱ་ཚང་བར། །གོས་ལ་སོགས་པས་དེ་བཞིན་གཤེགས། །སངས་རྒྱས་རྣམས་ལ་མཆོད་བྱེད་པ། །དེ་དག་དེས་ནི་བཀུར་བྱས་མིན། །ཚུལ་འདི་འཛིན་པར་བྱེད་ན་ནི། །དེ་ལྟས་སངས་རྒྱས་བཀུར་བར་འགྱུར། །འདི་ནི་བཀུར་སྟི་རྣམས་ཀྱི་མཆོག །གོས་མང་བྱིན་པ་དེ་ལྟར་མིན། །གང་གིས་བསྐལ་པ་བརྒྱ་ཚང་བར། །འཇིག་རྟེན་མགོན་པོ་སངས་རྒྱས་ལ། །སྤོས་དང་མེ་ཏོག་གཏོར་བྱེད་པ། །དེ་དག་དེས་ནི་བཀུར་བྱས་མིན། །གང་ཞིག་ཚུལ་མཆོག་ཟབ་མོ་ཡི། །མདོ་སྡེ་འདི་ནི་འཛིན་བྱེད་པ། །འདི་ནི་འཇིག་མགོན་སྐྱོབ་རྣམས་ལ། །བཀུར་སྟི་བྱེད་པ་དམ་པ་ཡིན། །གང་གིས་འཇིག་རྟེན་མགོན་པོ་ཡི། །མཆོད་རྟེན་རིན་ཆེན་རྒྱུ་ལས་བསྒྲུབས། །རི་རབ་འདྲ་བ་བྱས་ཀྱང་ནི། །དེས་ནི་སངས་རྒྱས་བཀུར་བྱས་མིན། །གང་ཞིག་མདོ་སྡེ་འདི་འཛིན་ཅིང་། །འཛིན་པར་ཡང་ནི་མི་བལྟ་ན། །དེ་ནི་བསྙེན་བཀུར་མཆོག་ཡིན་ཏེ། །མཆོད་པ་ཀུན་གྱི་ནང་ན་མཆོག །གང་ཟག་གང་ཞིག་བསྐལ་པ་བརྒྱ། །ཚང་བར་ཚུལ་ཁྲིམས་སྲུང་བྱེད་ལ། །མདོ་སྡེ་འདི་ནི་མི་འཛིན་ན། །ཚུལ་ཁྲིམས་དེ་ནི་མཆོག་མ་ཡིན། །གང་ཞིག་མདོ་སྡེ་འདི་འཛིན་ཅིང་། །འཛིན་པར་རློམ་སེམས་མེད་ན་ནི། །ཚུལ་ཁྲིམས་དེ་ནི་བསྔགས་པ་སྟེ། །ཚུལ་ཁྲིམས་དེ་ནི་བླ་ན་མེད། །ཚུལ་འདི་ཀུན་དུ་བཟུང་བའི་ཕྱིར། །མཁས་པ་ཚུལ་ཁྲིམས་ཆེན་པོ་དང་། །བསམ་གྱིས་མི་ཁྱབ་དཔག་མེད་པ། །ཚུལ་ཁྲིམས་གང་ཡིན་དེ་དེ་ཚོལ། །ང་ཡིས་ཇི་སྐད་བཤད་པ་ཡི། །མདོ་འདི་ལ་ནི་གང་སློབ་པ། །མཉམ་མཐོང་དེ་ལ་ཚུལ་ཁྲིམས་དང་། །ངང་ཚུལ་ངན་པ་ཡོད་མ་ཡིན། །གང་ཞིག་མདོ་འདིར་མི་སློབ་པ། །དེ་ནི་བྱང་ཆུབ་ཕྱིར་མི་སློབ། །བྱང་ཆུབ་དེ་དང་བསླབ་པ་མཉམ། །དེ་ནི་སུས་ཀྱང་བསླབས་པ་མེད། །གང་ཞིག་མདོ་སྡེ་འདི་འཛིན་པ། །དེ་ནི་མདོ་འདིར་བཤད་པ་ཡི། །ཚུལ་"],["ཞ 292b","ཁྲིམས་དེ་འདྲ་དེ་དག་གི། །ཚུལ་ཁྲིམས་ཕུན་སུམ་ཚོགས་པར་འགྱུར། །བཟོད་དང་ལྡན་པའི་མི་གང་ཞིག །འདིར་ནི་བསྐལ་པ་བརྒྱར་ཚང་བར། །སེམས་ཅན་དག་ནི་ཐམས་ཅད་ཀྱིས། །མི་སྙན་བརྗོད་དང་སྤྱོས་བཟོད་ཅིང་། །རྐང་ལག་དག་ཀྱང་གཏུབས་པ་ན། །དེ་ཡི་སེམས་ནི་འགྱུར་མེད་ཅིང་། །དེ་ནི་གང་དུའང་ཐ་བ་དང་། རབ་ཏུ་ཞེ་སྡང་མི་སྐྱེད་ལ། །བཟོད་པ་སྨྲ་བའི་མི་གང་ཞིག །བཟོད་པ་རྣམ་པ་དེ་ལྟ་བུས། །བསྐལ་པ་བྱེ་བ་ཟད་བྱེད་ཀྱང་། །བཟོད་པ་དེ་ནི་བསྔགས་མ་ཡིན། །གང་ཞིག་མདོ་འདི་ཐོས་ནས་ནི། །མོས་པས་འདི་ནི་འཛིན་བྱེད་པ། །དེ་ནི་བཟོད་པ་རྣམས་ཀྱི་མཆོག །དེ་ནི་བཟོད་པ་ཤིན་ཏུ་བཟང་། །གང་ཞིག་མདོ་སྡེ་འདི་འཛིན་ཅིང་། །གང་དུའང་ཆགས་པར་མི་བྱེད་པ། །བཟོད་པ་དེ་ནི་ཁྱད་པར་འཕགས། །བཟོད་པ་དེ་ནི་བླ་ན་མེད། །གང་ཞིག་སངས་རྒྱས་ཡེ་ཤེས་མཆོག །ཆགས་མེད་ཡེ་ཤེས་འདོད་པ་དེས། །མདོ་སྡེ་འདི་ལ་མི་ཆགས་པར། །མྱུར་དུ་འདི་ནི་གཟུང་བར་བྱ། །གང་ཞིག་བསྐལ་པ་བརྒྱ་ཚང་བར། །བརྩོན་འགྲུས་ལྡན་པ་མི་འདུག་ཅིང་། །གཉིད་ཀྱིས་མ་ནོན་བདག་ཉིད་ཅན། །རྟག་ཏུ་འདའ་བར་བྱེད་པ་བས། །མཁས་པ་གང་ཞིག་ལུང་མནོད་ཕྱིར། །མདོ་སྡེ་འདི་ལ་སྦྱོར་བྱེད་ན། །བརྩོན་འགྲུས་དེ་ནི་དེ་བས་མཆོག །བརྩོན་འགྲུས་འདི་ནི་ཁྱད་པར་འཕགས། །གང་ཞིག་བསྐལ་པ་བརྒྱ་ཚང་བར། །དྲང་སྲོང་མངོན་ཤེས་ལྔ་ལྡན་གྱུར། །མདོ་སྡེ་འདི་ནི་མི་ཉན་ན། །མངོན་ཤེས་མཆོག་ཅེས་མི་བྱའོ། །གང་ཞིག་དོན་ཤེས་མི་གནས་པར། །མདོ་སྡེ་འདི་ནི་འཛིན་བྱེད་པ། །དེ་ནི་མངོན་ཤེས་ཐམས་ཅད་ཀྱི། །མངོན་པར་ཤེས་པའི་མཆོག་ཡིན་ནོ། །མི་གང་བསྐལ་པ་བརྒྱ་ཚང་བར། །ཤེས་རབ་དང་ནི་ལྡན་གྱུར་ལ། །འཇིག་རྟེན་པ་ཡི་ཤེས་རབ་ལྡན། །འཇིག་རྟེན་བྱ་བ་རྣམས་ལ་ངེས། །གང་ཞིག་ཚུལ་འདི་མི་སློབ་ན། །དེ་ནི་ཤེས་རབ་ཚུལ་ཤེས་མིན། །གང་ཞིག་ཚུལ་འདི་འཛིན་བྱེད་པ། །དཔའ་བོ་དེ་ཉིད་ཤེས་རབ་ལྡན། །གང་ཞིག་མདོ་སྡེ་དམ་པ་འདི། །ཐོས་ནས་མོས་ཤིང་རྟོགས་བྱེད་པ། །བརྟན་པ་དེ་ནི་ཤེས་རབ་ལྡན། །དེ་ནི་ཤེས་རབ་མཁས་པ་ཡིན། །གང་ཞིག་"],["ཞ 293a","ཆོས་ཀུན་ཤེས་རབ་ཀྱིས། །ཤེས་པར་འདོད་པ་ཇི་ལྟས་ཀྱང་། །མདོ་སྡེ་འདི་ནི་ལུང་ནོད་ལ། །དེ་ནི་ཤེས་རབ་འདི་འཐོབ་འགྱུར། །མདོ་སྡེ་འདིར་ནི་རབ་བཤད་པ། །དེ་ནི་ཤེས་རབ་སྤྱོད་ཡུལ་ཡིན། །དེ་ཡི་ཕྱིར་ན་མདོ་སྡེ་འདི། །གཟུང་བར་བརྩོན་འགྲུས་བརྩམ་པར་གྱིས། །དེ་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་འདི་སྐད་ཅེས་གསོལ་ཏོ། །དཔག་ཚད་རངས་པའམ་འོན་ཏམ་ནི། །དཔག་ཚད་བརྒྱར་ཡང་བརྒྱུགས་ནས་ནི། །འབྲས་བུ་སྣ་ཚོགས་སེལ་བ་ཡི། །མདོ་སྡེ་འདི་ནི་མཉན་པར་བགྱི། །ཁ་ཚོན་དཔག་ཚད་རངས་པ་ཡི། །མེ་མདག་ག་གང་བ་རྒལ་ནས་ནི། །གང་ན་མདོ་སྡེ་འདི་གནས་པར། །མཁས་པས་མྱུར་དུ་མཆི་བར་བགྱི། །བསམ་གཏན་ཀུན་གྱི་དམ་པ་ལ། །བསམ་གཏན་པ་གང་བསམ་གཏན་འཚལ། །དེས་ནི་ཉོན་མོངས་ཀུན་སེལ་བ། །མདོ་སྡེ་འདི་ནི་ལུང་མནོད་བགྱི། །གང་ཞིག་འདི་ནི་འཇིག་རྟེན་ཁམས། །གྲགས་པ་མངོན་དགའ་ཞེས་བགྱི་བ། །ཤིན་ཏུ་མཛེས་དེར་མཆི་འཚལ་བ། །དེས་ནི་མདོ་སྡེ་འདི་བཤད་བགྱི། །གང་ཞིག་སངས་རྒྱས་མི་འཁྲུགས་པ། །ཐུབ་པ་བླ་མེད་མཐོང་འཚལ་བ། །དེས་ནི་མདོ་འདི་ལུང་མནོད་ཅིང་། །མང་དུ་བཀླག་ཅིང་གཟུང་བར་བགྱི། །གང་ཞིག་བྱང་ཆུབ་སེམས་དཔའི་གནས། །བདེ་བ་ཅན་དུ་མཆི་འཚལ་བ། །དེས་ནི་མདོ་འདི་ལུང་མནོས་ན། །མྱུར་བ་ཉིད་དུ་མཆི་བར་འགྱུར། །སངས་རྒྱས་ཀུན་གྱིས་གསུངས་པ་ཡི། །མདོ་སྡེ་འདི་ནི་བཏོན་བགྱིས་ནས། །རྫོགས་པའི་སངས་རྒྱས་འོད་དཔག་མེད། །བསམ་གྱིས་མི་ཁྱབ་དེ་མཐོང་འགྱུར། །བྱང་ཆུབ་སེམས་དཔའ་མ་སྨད་པ། །ཡོན་ཏན་འདི་དག་མངོན་འཚལ་བས། །སངས་རྒྱས་ཀུན་གྱིས་གསུངས་པ་ཡི། །མདོ་སྡེ་འདི་ནི་གཟུང་བར་བགྱི། །དེ་སྐད་ཅེས་གསོལ་པ་དང་། བཅོམ་ལྡན་འདས་ཀྱིས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ། །ཀུན་དགའ་བོ་ལེགས་ས་ལེགས་སོ། །ཀུན་དགའ་བོ་ཇི་སྐད་སྨྲས་པ་དེ་དེ་བཞིན་ཏེ། །ཀུན་དགའ་བོ་རིགས་ཀྱི་བུའམ། རིགས་ཀྱི་བུ་མོ་གང་ཞིག་གང་གི་ཚེ་སེམས་ཀྱི་གཡེང་བ་དང་མཚན་མ་ཐམས་ཅད་དང་བྲལ་"],["ཞ 293b","བའི་ཡིད་ཀྱིས་མདོ་འདི་ཀློག་གམ་ཁ་ཏོན་བྱེད་ན་དེ་དེའི་ཚེ། སངས་རྒྱས་གང་དང་གང་མཐོང་བར་འདོད་པ་དེ་དང་དེ་མཐོང་བར་འགྱུར་རོ། །ཇི་སྟེ་སེམས་གཡེངས་ནས་མི་ཀློག་གམ། ཁ་ཏོན་མི་བྱེད་ན་འཆི་བའི་དུས་ཀྱི་ཚེ། སངས་རྒྱས་བཅོམ་ལྡན་འདས་རྣམས་མིག་ལམ་དུ་མཐོང་བར་མི་འགྱུར་རོ། །དེ་ཅིའི་ཕྱིར་ཞེ་ན། ཀུན་དགའ་བོ་གང་ཞིག་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ལུང་ནོད་དམ། འཛིན་ཏམ། འདོན་ཏམ། ཀློག་པའི་རིགས་ཀྱི་བུའམ། རིགས་ཀྱི་བུ་མོ་དེ་སངས་རྒྱས་ཐམས་ཅད་ཀྱིས་ཡོངས་སུ་བཟུང་བར་འགྱུར་རོ། །དེ་ནས་གཞོན་ནུར་གྱུར་མ་སེང་གེས་གཞོན་ནུ་མ་ལྔ་བརྒྱ་དང་ལྷན་ཅིག་ཏུ་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་ཏེ་བཏུད་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ། །བཅོམ་ལྡན་འདས་བུད་མེད་དུ་གྱུར་པས་མདོ་འདི་ལུང་མནོས་སམ། བཟུང་ངམ། བཏོན་ཏམ་བཀླགས་ན་ཡོན་ཏན་ཅི་ཞིག་ཏུ་འགྱུར། བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། སེང་གེ་གལ་ཏེ་བུད་མེད་བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་བྱང་ཆུབ་ཏུ་ཡང་དག་པར་ཞུགས་པས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ལུང་ནོད་ཏམ། འཛིན་ཏམ། འདོན་ཏམ། ཀློག་གམ། འཆང་ན་དེའི་བུད་མེད་ཀྱི་དངོས་པོ་དེ་ཉིད་ཐ་མར་གྱུར་པ་ཡིན་ནོ། །དེ་ཅིའི་ཕྱིར་ཞེ་ན། ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ལུང་མནོས་པ་དང་། བཟུང་བ་དང་། བཏོན་པ་དང་། བཅངས་པ་དང་། བཀླགས་པས་ཉོན་མོངས་པ་གང་དག་གིས་བུད་མེད་བུད་མེད་ཀྱི་དངོས་པོ་ཡོངས་སུ་འཛིན་པའི་བུད་མེད་ཀྱི་ཉོན་མོངས་པ་རྣམས་བུད་མེད་ལ་འབྱུང་བར་མི་འགྱུར་རོ། །དེ་སྐད་ཅེས་བཀའ་སྩལ་པ་དང་། གཞོན་ནུར་གྱུར་མ་སེང་གེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ། །བཅོམ་ལྡན་འདས་ཉོན་མོངས་པ་གང་དག་དང་ལྡན་ན་བུད་མེད་བུད་མེད་ཀྱི་དངོས་པོ་ཡོངས་སུ་འཛིན་པའི་བུད་མེད་ཀྱི་ཉོན་མོངས་པ་དེ་དག་གང་ལགས། བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། སེང་གེ་འདི་ལ་བུད་མེད་ཀྱིས་བུད་མེད་གཟུགས་བཟང་བ། མཛེས་པ་བལྟ་ན་སྡུག་པ། རྒྱན་གྱིས་བརྒྱན་པ། བདེ་བ་དང་ལྡན་པ། གཞན་མཐོང་ན་དེ་དེ་ལ་འདོད་པ་སྐྱེད་དེ། འདི་ནི་ངན་སྐྱུགས་ཀྱི་གོང་བུ་ལ་ཚོན་གྱིས་བྲིས་པ། བྱིས་པ་འདྲིད་པ། དྲི་ང་བ། ངན་སྐྱུགས་ཀྱིས་སྦགས་པ་ཡིན་པ་དེ་ལྟར་མི་རྟོག་ན། དེ་དེ་ལ་དེ་ལྟར་མི་རྟོག་ཅིང་"],["ཞ 294a","སྡུག་པར་མཐོང་སྟེ། དེ་ལ་འདོད་པ་སྐྱེད་པས་བུད་མེད་བུད་མེད་ཀྱི་དངོས་པོ་ཡོངས་སུ་འཛིན་ཏོ། །སེང་གེ་གཞན་ཡང་འདི་ལ་བུད་མེད་ཕྲག་དོག་ཅན་དང་། སེར་སྣ་ཅན་དང་། གཡོ་དང་ལྡན་པར་གྱུར་ལ། དེ་བཞིན་དུ་ཚིག་ཏུ་སྨྲ་ཞིང་གཞན་དུ་སེམས་ཀྱིས་འཕྲོག་པ་དང་། གཞན་དུ་ཚིག་ཏུ་མངོན་སུམ་དུ་སྨ་ཞིང་གཞན་དུ་གསང་བར་སེམས་པ་དང་། ཉམས་སུ་མྱོང་བར་བྱ་བའི་ཕྱིར་དགེ་སློང་གི་གན་དུ་འགྲོ་བའི་ཆོས་ཀྱི་ཕྱིར་མ་ཡིན་པ་དང་། ཁྲོ་བས་ཟིལ་གྱིས་ནོན་པ་དང་། རྨུགས་པ་དང་། གཉིད་ཆེ་བ་དང་། འདུ་འཛི་ལ་མངོན་པར་དགའ་བ་དང་། ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ལྟ་བུའི་ལུང་མནོད་པ་དོན་དུ་མི་གཉེར་བ་དང་། ཀུན་ནས་ཉོན་མོངས་པའི་སེམས་ཀྱིས་ཉིན་མཚན་ཟད་པར་བྱེད་ཀྱང་རྣམ་པར་བྱང་བའི་སེམས་ཀྱིས་མ་ཡིན་ན། ཉོན་མོངས་པ་དེ་དག་གིས་བུད་མེད་དེ་བུད་མེད་ཀྱི་དངོས་པོ་ཡོངས་སུ་འཛིན་ཏེ་ཟད་པར་མི་བྱེད་དོ། །དེ་བས་ན་སེང་གེ་མདོར་ན་བུད་མེད་ཀྱིས་བདག་གི་ཉོན་མོངས་པ་ཐམས་ཅད་མི་སྐྱེ་བ་དང་མི་འབྱུང་བར་བྱ་བའི་ཕྱིར་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ལུང་ནོད་པར་བྱ། གདོན་པར་བྱ། ཀུན་ཆུབ་པར་བྱ། གཟུང་བར་བྱ། བཀླག་པར་བྱའོ། །དེ་ཅིའི་ཕྱིར་ཞེ་ན། ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ནི་བུད་མེད་ཀྱི་ཉོན་མོངས་པ་དང་བྲལ་བའོ། །གཞོན་ནུར་གྱུར་མ་སེང་གེས་གསོལ་པ། བཅོམ་ལྡན་འདས་གལ་ཏེ་བུད་མེད་བུད་མེད་ཀྱི་དངོས་པོ་ལས་བསྒྱུར་བར་མི་འཚལ་ལ་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ནི་ལུང་ནོད་ཅིང་འཛིན། འདོན། འཆང་། ཀློག །ཀུན་ཆུབ་པར་བགྱིད་ན། དེ་ཇི་ལྟར་ལྟ་བར་བགྱི། བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། སེང་གེ་བུད་མེད་ཀྱི་དངོས་པོ་ལས་བསྒྱུར་བར་མི་འདོད་དུ་ཟིན་ཀྱང་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ནི་ལུང་ནོད་དམ་སེམས་ན། དེ་ཉིད་བུད་མེད་ཀྱི་དངོས་པོའི་ཐ་མ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ། རྫུ་འཕྲུལ་གྱི་སྟོན་པ་ནི་མ་གཏོགས་སོ། །སེང་གེ་འདི་ལྟ་སྟེ་དཔེར་ན་སྐྱེས་པའམ། བུད་མེད་ལ་ལ་ཞིག་མེའི་ཕུང་པོ་ཆེན་པོ་ཀུན་དུ་རབ་ཏུ་མཆེད་ཅིང་འབར་བ་མེ་ལྕེ་དང་བཅས་པར་བདག་ཉིད་ཀྱི་ལུས་མཆོངས་ཏེ་ཚིག་འདི་སྐད་དུ་བདག་གི་ལུས་འཚིག་པར་མ་གྱུར་ཅིག །བདག་གི་པགས་པའི་མདོག་མ་གྱུར་ཅིག་ཅེས་སྨྲས་ན། སེང་གེ་འདི་ལ་ཇི་སྙམ་དུ་སེམས། སྐྱེས་པའམ། བུད་མེད་དེ་ཚིག་དེ་སྐད་སྨྲས་པས་བསམ་པ་དེ་འཐོབ་པར་འགྱུར་རམ། གསོལ་"],["ཞ 294b","པ། བཅོམ་ལྡན་འདས་དེ་ནི་མ་ལགས་སོ། །བཅོམ་ལྡན་འདས་ཞུགས་ཀྱི་ཕུང་པོ་ཆེན་པོ་ནི་སྲེག་པའི་བདག་ཉིད་ལགས་ཏེ། པགས་པའི་མདོག་མ་མཆིས་པར་བགྱིད་དོ། །བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། སེང་གེ་དེ་བཞིན་དུ་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ཡང་ཉོན་མོངས་པ་ཐམས་ཅད་སེལ་བའོ། །སེང་གེ་དེ་བས་ན་བུད་མེད་བུད་མེད་ཀྱི་དངོས་པོ་མི་འདོད་པ་དང་། སངས་རྒྱས་ཀྱི་ཆོས་རྣམས་མྱུར་དུ་སྒྲུབ་པར་འདོད་པ་དང་། སངས་རྒྱས་གྲངས་མེད་པ་མཐོང་བར་འདོད་པ་དང་། སྤོབས་པ་ཆགས་པ་མེད་པ་ཐོབ་པར་འདོད་པས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ཉིད་གཟུང་བར་བྱ། ཀུན་ཆུབ་པར་བྱ། གདོན་པར་བྱ། བཀླག་པར་བྱ། བཅང་བར་བྱ། ཁ་ཏོན་དུ་བྱའོ། །དེ་ནས་གཞོན་ནུར་གྱུར་མ་སེང་གེ་གཞོན་ནུ་མ་ལྔ་བརྒྱ་དང་ལྷན་ཅིག་ཏུ་ཐལ་མོ་སྦྱར་ཏེ། བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ། །བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའི་སངས་རྒྱས་མར་མེ་མཛད་ལས་མནོས་ཏེ། དེ་སླན་ཆད་འདི་སྲོག་ཆགས་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་མང་པོ་འཛིན་དུ་སྩལ་ཏོ། །དེ་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་འདི་སྐད་ཅེས་གསོལ་ཏོ། །བཅོམ་ལྡན་འདས་ཅི་ལགས། གཞོན་ནུར་གྱུར་མ་སེང་གེས་བུད་མེད་ཀྱི་དངོས་པོ་མ་བསྒྱུར་ལགས་སམ། བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། ཀུན་དགའ་བོ་ཁྱོད་ཅི་གཞོན་ནུར་གྱུར་མ་སེང་གེ་བུད་མེད་ཡིན་སྙམ་དུ་སེམས་སམ། གསོལ་པ། བཅོམ་ལྡན་འདས་དེ་དེ་ལྟ་ལགས་སོ། །བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། ཀུན་དགའ་བོ་དེ་སྐད་མ་སྨྲ་ཤིག །དེ་ཅིའི་ཕྱིར་ཞེ་ན། ཀུན་དགའ་བོ་འདི་ནི་གཞོན་ནུར་གྱུར་མ་སེང་གེ་དང་། གཞོན་ནུ་མ་ལྔ་བརྒྱ་པོ་འདི་དག་གི་ཆོ་འཕྲུལ་ཡིན་ཏེ། ཕྱི་མའི་སྐྱེ་བོ་མཐོང་ནས་བུད་མེད་ལ་སྙིང་བརྩེ་བ་དང་། བུད་མེད་བུད་མེད་ཀྱི་དངོས་པོ་ལས་རྣམ་པར་དགྲོལ་བའི་ཕྱིར་གཞོན་ནུར་གྱུར་མ་སེང་གེས་ཆོ་འཕྲུལ་འདི་བསྟན་ཏོ། །དེ་ཅིའི་ཕྱིར་ཞེ་ན། འདི་དག་ནི་སྐྱེས་པ་མི་འཇུག་ཅིང་འཇུག་ཏུ་མི་དབང་བའི་ཁྱིམ་ཐམས་ཅད་དུ་ཞུགས་ནས་ཆོ་འཕྲུལ་གྱིས་བུད་མེད་འདུལ་ལོ། །ཀུན་དགའ་བོ་གཞོན་ནུར་གྱུར་མ་སེང་གེ་ལ་ནི་བུད་མེད་ཀྱི་ཆོས་མེད་སྐྱེས་པའི་ཆོས་མེད་དོ། །དེ་ཅིའི་ཕྱིར་ཞེ་ན། ཆོས་ཐམས་ཅད་"],["ཞ 295a","མི་དམིགས་པའི་ཕྱིར་འདིས་བུད་མེད་མི་དམིགས་སྐྱེས་པ་མི་དམིགས་སོ། །གཞོན་ནུར་གྱུར་མ་སེང་གེས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་རྟོགས་པར་ཁོང་དུ་ཆུད་དོ། །སྣང་བ་ཐོབ་བོ། །ཀུན་དགའ་བོ་དེ་ལྟ་བས་ན་གཞོན་ནུར་གྱུར་མ་སེང་གེའི་རྗེས་སུ་སློབ་པར་འདོད་པའི་བུད་མེད་ཀྱིས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་གཟུང་བར་བྱ། ཀུན་ཆུབ་པར་བྱ། གདོན་པར་བྱ། བཅང་བར་བྱ། བཀླག་པར་བྱ། ཁ་ཏོན་དུ་བྱའོ། །དེ་ནས་དགེ་སློང་མ་ལྔ་སྟོང་སྟན་ལས་ལངས་ཏེ། བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས། བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ། །བཅོམ་ལྡན་འདས་བདག་ཅག་དེང་སླན་ཆད་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་གཟུང་བར་བགྱིད། ཀུན་ཆུབ་པར་བགྱིད། འདོན་པར་བགྱིད། འཆང་བར་བགྱིད། ཀློག་པར་བགྱིད། ཁ་ཏོན་དུ་བགྱིད་དོ། །དེ་ཅིའི་སླད་དུ་ཞེ་ན། བཅོམ་ལྡན་འདས་བདག་ཅག་ནི་བུད་མེད་ཀྱི་དངོས་པོ་དོན་དུ་གཉེར་བ་མ་ལགས་སོ། །བཅོམ་ལྡན་འདས་བདག་ཅག་ནི་བུད་མེད་ཀྱི་དངོས་པོ་ལ་སྨོད་ལགས་སོ། །བཅོམ་ལྡན་འདས་བདག་ཅག་དེང་སླན་ཅད་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་ཀུན་ཆུབ་པར་མ་གྱུར་གྱི་བར་དུ་མཆིས་པར་མི་བགྱིད་དོ། །རྨུགས་པ་དང་གཉིད་ཀྱིས་ནོན་པར་མི་བགྱིད་དོ། །དེ་སྐད་ཅེས་གསོལ་པ་དང་། བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་མ་དེ་དག་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ། །ཆེ་ཞེ་དག་ཁྱེད་ཀྱིས་ཚིག་འདི་ལ་ལེགས་པར་སྨྲས་ཏེ། གོ་ཆ་ཆེན་པོ་བགོས་ཤིང་ཁྱེད་ཅི་ནས་ཀྱང་བུད་མེད་ཀྱི་དངོས་པོ་ནི་དོན་དུ་མི་གཉེར་ལ། སངས་རྒྱས་ཀྱི་ཆོས་རྣམས་ནི་དོན་དུ་གཉེར་བའི་ཕྱིར་བརྩོན་འགྲུས་ཆེན་པོ་འདི་བརྩམས་པ་ལེགས་སོ་ལེགས་སོ། །དེ་བས་ན་ཁྱོད་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་གཟུང་བའི་ཕྱིར་བརྩོན་འགྲུས་དེ་བས་ཀྱང་རྩོམས་ཤིག །དེ་ནས་དགེ་སློང་མ་དེ་དག་གིས་འདི་ཐོས་ནས་ཚིམ་ཞིང་མགུ་ནས་ཡི་རངས་ཏེ་རབ་ཏུ་དགའ་ནས་དགའ་བ་དང་ཡིད་བདེ་བ་སྐྱེས་ཏེ། སོ་ས་ནས་བླ་གོས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་བཀབ་བོ། །བཀབ་ནས་ཀྱང་ཚིགས་སུ་བཅད་པ་འདི་སྨྲས་སོ། །སྐྱེས་པའི་དངོས་པོའི་ཆེད་དུ་ནི། །དེ་རིང་བདག་ཅག་དབུགས་རྙེད་དོ། །རྒྱལ་བ་གཞན་དུ་མི་གསུང་བས། །བདག་ཅག་འཇིག་རྟེན་མཆོག་ཏུ་འགྱུར། དེ་ནས་ཁྱིམ་བདག་གི་ཆུང་མ་ལྔ་བརྒྱས་དགེ་སློང་མ་དེ་དག་གི་"]]}