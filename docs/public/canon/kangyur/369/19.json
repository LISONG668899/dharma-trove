ང་སྤྱན་དང་ནི། །ལྷ་མོ་སྒྲོལ་མ་གོས་དཀར་མོ། །འོད་ཟེར་ཅན་དང་ཛམྦྷ་ལ། །ལྷ་མོ་སྐུལ་བྱེད་ས་འཛིན་མ། །རང་གི་ས་བོན་ལས་བྱུང་བ། །ཕྱག་བཅུ་གཉིས་ཀྱིས་རྣམ་པར་བརྒྱན། །སྤྱན་གསུམ་པ་ལ་གཡས་བརྐྱང་བཞུགས། །སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས། །རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་གིས་གནས། །རིག་བྱེད་བཞི་ཡི་ཞལ་གདོང་སྟེ། །ཕྱོགས་ཀྱི་གོས་ཅན་རོ་ཡི་གདན། །སྐྲ་གྲོལ་བ་ལ་འཇིགས་པ་སྟེ། །ཐོད་པའི་ཕྲེང་བའི་དབུ་རྒྱན་ཅན། །ཁྲོ་བས་བལྟ་ཞིང་ཐུགས་རྗེའི་ཉམས། །ཤེས་རབ་ཕ་རོལ་ཕྱིན་ལྷ་མོ། །དེ་ཉིད་ཡེ་ཤེས་མཆོག་ལས་བྱུང་། །སོ་སོ་ཡང་དག་སྦྱོར་བའི་བདག །དེ་ཉིད་ཡེ་ཤེས་གདོན་མི་ཟ། །ཁྲོ་བོ་སྣ་ཚོགས་གཟུགས་ཅན་ནི། །དཔའ་བོ་རང་ཉིད་ལས་བྱུང་བ། །ཁྲོ་མཆོག་མཁའ་འགྲོ་འབྱུང་བ་ཡང་། །གོས་པ་མེད་པར་ཉམས་པ་ཡི། །བདག་པོ་ཉིད་དུ་སྦྱར་བར་བྱ། །བདག་ཉིད་སྒོམ་པ་ཉིད་ཡིན་ནོ། །མཉམ་པར་མ་བཞག་སྦྱོར་བ་ཡིས། །སྒོམ་ཞིང་རྣམ་པར་བསྒོམ་པར་བྱ། །ཕྲ་བའི་ཁྲོ་བོའི་རྡོ་རྗེ་ཅན། །སྙིང་གའི་པདྨའི་དབུས་སུ་ནི། །རྡོ་རྗེ་མཁའ་འགྲོ་ཐུགས་བརྩེ་ཅན། །འདི་ཉིད་དུ་ནི་གནས་མཛད་ཅིང་། །རྫོགས་སངས་རྒྱས་ཀུན་བྱང་ཆུབ་སེམས། །འགྲོ་བ་གསུམ་པོ་འདི་ལ་གནས། །འདི་ཉིད་ཀྱིས་མཆོད་པ་ཉིད་ཀྱིས། །མཆོད་འོས་ཐམས་ཅད་མཆོད་པ་ཡིན། །གང་ཞིག་འདི་ལ་རྟག་བལྟ་བ། །དེ་ནི་རྒྱལ་བས་མཆོད་པར་བཞེད། །ནང་གི་སྦྱོར་བ་རྡོ་རྗེ་ཡིས། །རྣལ་འབྱོར་རྡོ་རྗེ་ཅན་དུ་འདོད། །དེ་བས་རྡོ་རྗེ་"],["ཀ 369a","མཆོད་པ་ཡིས། །ཡིད་འདོད་རྣམས་ཀྱི་ལུས་ལ་འདོད། །མཆོད་པ་ལྔ་ཡི་སྦྱོར་བ་ཡིས། །མྱུར་དུ་སངས་རྒྱས་ཉིད་ཐོབ་པར། །གང་འདི་རྒྱུད་ལས་གསུངས་པ་དག །དེ་ནི་ཕ་རོལ་གཞན་དུ་འདོད། །དངོས་མེད་བཞི་ལ་དགོད་པ་ཡིན། །ལྷ་ཡི་གཟུགས་སུ་བསྒོམ་པ་ཡི། །མཉམ་ཉིད་མཆོད་པ་ཆེན་པོ་སྟེ། །སངས་རྒྱས་ཐམས་ཅད་རབ་བསྒྲུབ་པའོ། །སྔགས་དང་དེ་ཉིད་བསྟན་པ་ཡི། །བསྟན་པ་ཙམ་དུ་ལེགས་འབྱུང་བའི། །རྒྱུད་ནི་དོན་དམ་མ་ཡིན་ཏེ། །དོན་དམ་ཡང་དག་སྐྱེས་པ་ན། །སྟོན་པ་མེད་ཅིང་བསྟན་པའང་མེད། །ཉི་ཤུ་རྩ་བཞིར་ཕྱེ་བ་ཡི། །གནས་སོགས་འདི་ཉིད་ལ་གནས་ཏེ། །དེ་བས་དེ་རུ་འཁོར་བ་ཉིད། །སྐྱོ་བྱ་དེ་ཉིད་ཅན་གྱིས་མིན། །གལ་ཏེ་དེ་ཉིད་མེད་གྱུར་ན། །དེ་ཡི་འཁྲུལ་པས་ཅི་ཞིག་བྱ། །འོན་ཏེ་དེ་ཉིད་ལྡན་གྱུར་ན། །དེ་ལ་འཁྲུལ་པ་ཅི་ཞིག་ཡོད། །གནས་དང་ཉེ་བའི་གནས་མཆོག་རྣམས། །བསྟན་པས་དྲི་མ་མེད་པར་འགྱུར། །ཡང་ན་མི་ནུས་བག་མེད་པའི། །མི་ཡི་གནས་ནི་བསྒྲགས་པར་བྱ། །ང་ཡིས་འདི་ལྟར་བཤད་པ་ནི། །སེམས་ཅན་བསམ་པའི་དབང་གིས་ཏེ། །བསམ་གཏན་ལས་གཞན་བདེ་མེད་ཕྱིར། །དེ་བས་བསམ་གཏན་མཆོག་གཞོལ་བྱ། །རྣལ་འབྱོར་པ་ནི་ཕྱི་རོལ་འཁོར། །དེ་ཡི་ཁམས་རྣམས་ཟད་པར་འགྱུར། །དེ་བས་ཕྱི་རོལ་སྤངས་ནས་ནི། །རྣལ་འབྱོར་རོལ་པས་གནས་པར་བྱ། །དཔལ་ལྡན་རྡོ་རྗེ་རྣལ་འབྱོར་ཅན། །རྣམ་དག་ཡེ་ཤེས་སྤྱན་གྱིས་ནི། །ཐུགས་རྗེ་ཐུགས་གདུངས་རིང་པོ་ནས། །རྡོ་རྗེ་རྣལ་འབྱོར་ཅན་དག་གཟིགས། །དེ་རྣམས་དགྱེས་པས་དངོས་གྲུབ་མཆོག །ཅི་འདོད་པར་ནི་སྩོལ་བར་འགྱུར། །དེས་ནི་རྗེ་བཙུན་ཡེ་ཤེས་ཀྱང་། །རབ་ཏུ་འབད་དེ་བསྒྲུབ་པར་བྱ། །སྣ་ཚོགས་སྤྱོད་པ་ཡང་དག་ལྡན། །སྤྱོད་དང་བརྟུལ་ཞུགས་སྤྱད་པ་ཡི། །སྤྱོད་དང་བརྟུལ་ཞུགས་འདིར་སྤོངས་ལ། །དེ་ཉིད་བརྟུལ་ཞུགས་ལ་དགར་བྱ། །གང་ཡང་རུང་བའི་ཟས་གནས་པ། །རྣམ་པ་དེས་བྱས་བརྟུལ་ཞུགས་ཅན། །བསམ་གཏན་ཟས་མཆོག་གཞོལ་འགྱུར་བས། །སྨྱོན་པའི་སྤྱོད་པས་གནས་པར་གྱིས། །གཅེར་བུ་འམ་ཡང་གཅེར་བུ་མིན། །གང་རུང་ཇི་ལྟ་དེ་ལྟར་འགྱུར། །"],["ཀ 369b","རང་གི་ལྷག་པའི་ལྷ་དམིགས་ལ། །དེ་ཉིད་གཅིག་པུ་རྣམ་པར་བསམ། །ལྐུགས་པའི་དངོས་པོར་གྱུར་པ་ཡིས། །ཟླ་དྲུག་ཙམ་གྱིས་ངེས་པར་ནི། །རྣལ་འབྱོར་ཅན་གྱིས་ཉེར་བསྟེན་ན། །རྣལ་འབྱོར་ཆེན་མོ་འདི་གསལ་འགྱུར། །ཡེ་ཤེས་སྒྲོན་མའི་མཆོག་མཐོང་ན། །རྣལ་འབྱོར་མ་རྣམས་ལེགས་འདུས་ཏེ། །པདྨའི་འབྱུང་གནས་ཉམས་དགའ་བར། །ངང་པའི་ཚོགས་འདུས་ཇི་བཞིན་ནོ། །མིག་འཕྲུལ་མཁན་ལྟར་འཇིག་རྟེན་དུ། །འགྲོ་ཀུན་དོན་ནི་བྱེད་པའོ། །དཔལ་ལྡན་རྡོ་རྗེ་འཛིན་པར་ནི། །མངོན་འགྱུར་འདི་ལ་ཐེ་ཚོམ་མེད། །སྤྱོད་པ་འདི་ལ་ངེས་པར་ནི། །ཇི་སྐད་བཤད་པ་དེར་འགྱུར་བར། །སེམས་ནི་དག་པར་གྱིས་ཤིག་ཅེས། །སེམས་ཅན་རྣམས་ལ་བདག་གསོལ་འདེབས། །གང་གིས་རྨད་བྱུང་སྙིང་རྗེར་ལྡན། །གང་གིས་གསུང་བ་དེ་ཉིད་འགྱུར། །རྡོ་རྗེ་དྲག་པོའི་སྦྱོར་བ་ཡིས། །མཁའ་འགྲོ་མ་ནི་སྙིང་གར་དགོད། །སྙིང་གར་རྡོ་རྗེ་ལྕགས་ཀྱུར་སྦྱོར། །ཐུགས་ཀྱི་རྡོ་རྗེས་ནང་སྦྱར་ཏེ། །གཞན་ཡང་རྡོ་རྗེ་དགོད་བྱ་བ། །ཆོས་ཀྱི་དབྱིངས་སུ་རྣམ་པར་བརྟག །རང་གིས་ནམ་མཁར་སྦྱོར་ནས་སུ། །གཟི་བརྗིད་གཟུགས་ནི་འཛིན་པར་བསྒོམ། །རང་གི་ཆོས་ཀྱི་ཡིད་དགོད་པ། །རང་དྲོད་རང་བཞིན་དྲི་མ་མེད། །རང་གི་སྒོམ་པའི་སྦྱོར་བ་ཡིས། །རང་གི་ཆོས་ཀྱི་ཡི་གེ་བསྒོམ། །ཇི་ལྟ་ཇི་ལྟར་རྟོགས་པ་ཡི། །གཞན་ཉིད་གཟུགས་ཀྱི་སྒོམ་པ་ལ། །ཡིད་ཀྱི་གཏི་མུག་གྲུབ་པ་ཡི། །དབང་པོ་གཞན་མ་བསྒོམ་པར་བྱ། །ཇི་ལྟ་ཇི་ལྟར་མོས་པ་ཡིས། །གཞན་ཉིད་གཟུགས་ལ་བལྟ་བར་བྱ། །མངོན་པར་བརྗོད་པའི་རྒྱུད་བླ་མའི་བླ་མ་ལས་བདག་འདུལ་བའི་མཆོད་པའི་ལེའུ་སྟེ་དྲུག་ཅུ་རྩ་བརྒྱད་པའོ།། །།དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་གསང་བའི་ཡེ་ཤེས་གསང་བ་འདི་གསུངས་སོ། །རང་བཞིན་བདག་མེད་ཆོས་རྣམས་ནི། །ནམ་མཁའ་ལྟ་བུར་དྲི་མ་མེད། །སྟོང་ཉིད་ཡེ་ཤས་རྡོ་རྗེ་ཡིས། །སྟོང་ཉིད་རྟག་ཏུ་བསྒོམ་པར་བྱ། །ལེགས་སོ་བྱ་བ་རྣམས་བྱིན་ནས། །རྒྱུད་སྐྱེས་པ་ཡི་སྦྱོར་བ་ལས། །ལེགས་སོ་ལེགས་སོ་ཡེ་ཤེས་ཆེ། །ངེས་པར་བརྗོད་པ་མཆོག་གི་"],["ཀ 370a","མཆོག །ལེགས་སོ་རྡོ་རྗེ་ཚུལ་དྲག་པོ། །སངས་རྒྱས་བྱང་ཆུབ་བཀའ་དྲིན་རབ། །ལེགས་སོ་གཉིས་མེད་སྦྱོར་བ་ནི། །མཆོག་དང་མཆོག་ནི་གྲུབ་པ་ལ། །ལེགས་སོ་ཞེས་བྱ་ངེས་པར་སྦྱོར། །འདོད་པ་མེད་པའི་སྒོམ་པ་ནི། །ལེགས་སོ་ཐམས་ཅད་འགྲོ་བའི་མགོན། །ཐེག་པ་ཆེན་པོ་བསྟན་པ་འདི། །གཉིས་མེད་ཡེ་ཤེས་མཆོག་དང་ནི། །མན་ངག་ཐོབ་པའི་དང་པོ་སྟེ། །ལེགས་སོ་རྡོ་རྗེ་བླ་མ་ཀུན། །དེ་ལ་བསྟན་པ་རྣལ་འབྱོར་མ། །ལེགས་སོ་འཁོར་གྱི་དཀྱིལ་འཁོར་ལ། །དངོས་གྲུབ་བླ་ན་མེད་པ་བྱིན། །རྫོགས་ཏེ་ཅང་མི་གསུང་བར་གྱུར་ཏོ། །བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པས་དེ་སྐད་ཅེས་བཀའ་སྩལ་ནས། དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཁྲོ་བོའི་རྡོ་རྗེ་རྣམས་ངེས་པར་བརྗོད་པའི་རྒྱུད་བླ་ན་མེད་པའི་མཁའ་འགྲོ་མའི་དྲ་བའི་སྡོམ་པ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་ལ་མངོན་པར་བསྟོད་དོ།། །།མངོན་པར་བརྗོད་པའི་རྒྱུད་བླ་མའི་བླ་མ་ཞེས་བྱ་བ་གསང་བའི་ཡང་གསང་བ་བདེ་མཆོག་རྒྱུད་ཀྱི་རྒྱལ་པོ་ཆེན་པོ་ཐེ་ཚོམ་མེད་པར་དེ་ཁོ་ན་སྒོམ་པ་བསྟན་པའི་ལེའུ་སྟེ། དྲུག་ཅུ་རྩ་དགུ་པའོ།། །།མངོན་པར་བརྗོད་པའི་རྒྱུད་བླ་མའི་བླ་མ་ལས་གསང་བ་ལས་གསང་བའི་བདེ་མཆོག་གི་རྒྱུད་ཀྱི་རྒྱལ་པོ་ཆེན་པོ་ཞེས་བྱ་བ་རྫོགས་སྷོ། །རྒྱ་གར་གྱི་མཁན་པོ་པཎྜི་ཏ་ཆེན་པོ་དཱི་པངྐ་ར་ཤྲཱི་ཛྙཱ་ན་དང་། བོད་ཀྱི་ལོཙྪ་བ་ཆེན་པོ་དགེ་སློང་རིན་ཆེན་བཟང་པོས་བསྒྱུར་ཅིང་ཞུས་ཏེ་གཏན་ལ་ཕབ་པ། ཕྱིས་པཎྜི་ཏ་ཆེན་པོ་ཛྙཱ་ན་ཤྲཱི་དང་། ལོཙྪ་བ་ཁྱུང་པོ་ཆོས་ཀྱི་བརྩོན་འགྲུས་ཀྱིས་ཀྱང་ཞུས་པའོ། །ཕྱིས་པཎྜི་ཏ་ཨཱ་ནནྡ་དང་། ལོ་ཆུང་གིས་ཆད་ལྷག་རྣམས་བསབས་ནས། ཞུས་དག་བྱས་ནས་ལེགས་པར་བཅོས་ཏེ་གཏན་ལ་ཕབ། །འདི་ལས་ཟབ་པ་མེད་དོ།། །།"],["ཁ 1a","༄༅། །རྒྱུད་འབུམ་ཁ་པ་བཞུགས་སོ། །"]]}