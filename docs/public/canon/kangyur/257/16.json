ས་ཅད་འདིར་གྱིས་ཤིག །མགོ་དང་ནག་པ་གྲོ་བཞིན་ཏེ། །དེ་དག་ཕུན་སུམ་ཚོགས་པར་བྱེད། །རྩི་བྱེད་ན་ཡང་དེ་དག་སྟེན། །དེར་བྱིན་གོས་རྒྱན་སྣ་ཚོགས་སྒྲོགས། །ནབ་སོ་དང་ནི་ས་ག་དང་། །མོན་གྲེ་བདེ་བར་བྱེད་པ་སྟེ། །དེ་དག་ལ་ནི་ལམ་དུ་འཇུག །སྣྲོན་ནི་སྒྲུབ་པ་བྱེད་པ་ཡིན། །སྐག་ཅེས་བྱ་བ་ཁྲུམས་སྨད་ནི། །དྲག་པོའི་ལས་དག་བྱེད་པ་ཡིན། །ཆུ་སྟོད་ཆུ་སྨད་ཐ་སྐར་དང་། །བྲ་ཉེ་ཁྲུམས་སྟོད་ཁྲུམས་སྨད་མཛའ། །དབོས་ནི་སྐལ་བ་བཟང་པོ་སྦྱིན། །བརྩོན་པ་དང་ནི་བཞོན་པ་དང་། །མལ་དང་ཁྲི་ནི་བཤམ་པ་ཡང་། །འདི་ལ་བྱ་བ་དེ་འཇུག་གོ། །ཡང་སྨྲས་པ། འགྲོ་བ་བཞི་དང་ལྡན་པར་ནི། །མགོ་ལ་ཁྱོད་ནི་གནས་པར་འགྱུར། །མི་ཡི་ལས་བྱ་མྱུར་དུ་སྒྲུབས། །ཡུད་ཙམ་སུམ་ཅུར་འགྲོ་བར་གྱིས། །ཞག་བརྒྱད་ནད་པ་མྱུར་དུ་གསོས། །ཁྱོད་ཟས་ཚོན་ཤ་ཟླ་བའི་ལྷ། །དེར་ནི་སྐྱེས་དགུ་གང་དག་སྐྱེ། །དཔའ་ཞིང་འབྱོར་བར་འགྱུར་བ་ཡིན། །ཁྱབ་འཇུག་བདེན་འདི་ཤིན་ཏུ་བསྲུངས། །དེ་བྱེད་ཇི་བཞིན་ང་ཡིས་བཤད། །གྲོ་བཞིན་ཐ་སྐར་མངལ་དུ་འཇུག །མཆུ་གཉིས་གྲེ་དབོ་འཆི་བར་བྱེད། །སྣྲོན་གྱི་ཚེ་ནི་བྱ་བ་འཕེལ། །སྐག་དང་གཞན་བཅས་ཐོབ་པར་བྱེད། །ལམ་རིང་རྩོད་དང་གནས་ནས་འགྲོ། །བྱ་བ་དེ་འདྲ་སྤང་བར་གྱིས། །ནབ་སོ་རྒུད་པར་བྱེད་པ་སྟེ། །མོན་གྲེ་ས་ག་བཞིན་དུ་ཤེས། །གསང་"],["ཟ 200b","བའི་གནས་བཞིན་བརྩམ་པར་གྱིས། །བརྫུན་གཡོ་དམངས་ཀྱིས་འཇོམས་པར་བྱེད། །ནག་པ་ལས་ཀྱི་རྒྱུ་སྐར་ཏེ། །འདི་ལ་ཆེ་ཆུང་ཐམས་ཅད་རྩོམ། །ལག་ནི་ཕུན་སུམ་ཚོགས་པར་བྱེད། །མོན་གྲུ་ས་རི་གཞན་ཐོབ་བྱེད། །འདིར་ནི་སྨན་དང་སྦྱིན་འདུལ་བཞོན། །རྒྱན་དང་གོས་ཀྱང་ཐོབ་པར་བྱེད། །རྒྱལ་དང་ལྷ་མཚམས་ཁྲུམས་སྟོད་བདེ། །དེ་དག་ལམ་དུ་ཤིན་ཏུ་འཕྲོད། །སྣྲུབས་དང་ནམ་གྲུ་མཆུ་སྒྲུབ་བྱེད། །འདི་ལ་གཏུམ་པོའི་ལས་ཀྱང་བྱ། །མེ་བཞི་དགྲ་ཟིན་བྲ་ཉེ་དང་། །སྣར་མ་དབྱེར་མེད་ཆུ་གཉིས་བཞིན། །སྐལ་བཟང་བག་མ་གཏོང་དང་བཞོན། །མལ་ཀུན་འདིར་ནི་བྱེད་དུ་ཆུག །ལག་ལྷ་དྲག་མོས་དེ་ཚེ་སྨྲས། །ཚེས་ལྔ་ལ་ནི་ཁྱོད་གནས་ཏེ། །ཡུད་ཙམ་བཅོ་ལྔ་ཁྱོད་འགྲོ་བྱེད། །ཁྱོད་ཀྱི་ཟས་ནི་མར་སར་ཏེ། །དྲག་ཅིང་མི་བཟད་སྡང་བྱེད་སྒྲུབ། །ནད་པ་ཡང་ནི་ཞག་བཅུ་ཡིན། །ཁྱོད་ལ་སྤྱད་པས་མི་གང་སྐྱེ། །སྲིད་པ་གསུམ་དུ་མི་ཟད་འགྱུར། །ནོར་ཚོལ་བྱེད་ཅིང་ཆོམ་པོས་འཆི། །ཁྱོད་ཀྱི་སྦྱོར་བས་དེ་ཡིན་ནོ། །མོན་གྲུ་སྣྲུབས་ལ་མངལ་དུ་འཇུག །ཆུ་དང་ནམ་གྲུས་འཕེལ་བར་འགྱུར། །དབོ་ཡི་ཚེ་ན་འཆི་བར་བྱེད། །ཆུ་གཉིས་བྲ་ཉེ་ཇི་བཞིན་ནོ། །སྐྱེ་དང་འཇིག་དང་འཕེལ་བ་ཡི། །བྱེད་པ་དེ་ནི་སྤོང་བར་གྱིས། །ལྷ་མཚམས་དང་ནི་ཁྲུམས་སྟོད་དེར། །བྱེད་པ་བསྟན་ནས་རྒུད་པར་བྱེད། །ས་རི་ལས་ཀྱི་རྒྱུ་སྐར་ཡིན། །བྱེད་པ་ཆུང་ངུ་ཐམས་ཅད་འཇུག །ས་ག་དང་ནི་མོན་གྲེ་དང་། །ནབ་སོ་ཕུན་སུམ་ཚོགས་པར་བྱེད། །ཁྲུམས་སྨད་པར་ནི་བདེ་བྱེད་ཡིན། །སྣྲོན་དང་སྐག་ནི་ལམ་ན་མཉམ། །གྲེ་ནི་སྒྲུབ་པར་བྱེད་པ་སྟེ། །ཆུ་སྟོད་ཐ་སྐར་གསུམ་པ་ཡིན། །མེ་བཞིའི་བར་གཞན་གྲོགས་མཆོག་སྟེ། །སྨིན་དྲུག་ནག་པ་གྲོ་བཞིན་དང་། །བྱི་བཞིན་བག་མ་གཏོང་དང་བཞོན། །མལ་དང་སྐལ་བ་བཟང་པོར་སྒྲུབ། །ཉི་མའི་ལྷ་མོ་ནབ་སོས་སྨྲས། །ཚེས་དྲུག་ལ་ཡང་གནས་པར་འགྱུར། །སྦྲུལ་ཤ་ཁྱོད་ཀྱི་ཟས་སུ་ཤོག །ལས་ཀྱང་དྲག་པོར་བྱ་བར་གྱིས། །ཡུད་ཙམ་བཞི་བཅུ་རྩ་ལྔར་འགྲོ། །"],["ཟ 201a","འདིར་ནི་ནད་པ་ཞག་བརྒྱད་ཡིན། །ཁྱོད་སྤྱད་སུ་ཡང་མི་ནང་སྐྱེ། །ཞིང་པ་ལོངས་སྤྱོད་ལྡན་པར་འགྱུར། །རྟ་དང་གླང་ཆེན་ཟད་པར་འགྲོ། །ནབ་སོས་མངལ་དུ་འཇུག་པར་འགྱུར། །འདི་ནི་མོན་གྲེའི་ཟས་ཡིན་ཏེ། །སྨིན་དྲུག་ལ་ནི་འཆི་བར་བྱེད། །ཁྲུམས་སྨད་རྒུད་པར་བྱེད་པ་ཡིན། །སྐག་སྣྲོན་ལས་ཀྱི་རྒྱུ་སྐར་ཡིན། །ས་ག་བརྟུལ་ཞུགས་བསྟན་པ་ཡིན། །རྒྱལ་ཡང་ཕུན་སུམ་ཚོགས་པར་བྱེད། །ལག་དང་ལྷ་མཚམས་ཞེས་བྱ་དང་། །ཁྲུམས་སྟོད་ཀྱང་ནི་བདེ་བར་བྱེད། །མཆུ་དང་ནམ་གྲུ་བཞིན་དུ་སྟེ། །དེ་དག་ལམ་དུ་ཞུགས་ན་བཟང་། །བྲ་ཉེ་ཆུ་སྨད་གྲེ་དང་དབོ། །སྒྲུབ་བྱེད་ནག་པ་གྲོ་བཞིན་དང་། །ས་རི་སྣར་མ་མགོ་མོན་གྲུ། །མི་ཡི་ནང་ཁྱོད་གྲོགས་མཆོག་འགྱུར། །རྒྱལ་འདིར་ལྷ་མོ་ཕུར་བུ་ཁྱོད། །ཚེས་བདུན་གནས་ཁྱོད་ཡུད་སུམ་ཅུ། །འགྲོ་བྱེད་བུ་རམ་སྦྲང་རྩི་ཟས། །ཆོས་ལྡན་བྱེད་ཆུད་མྱུར་དུ་སྒྲུབ། །ནད་ཀྱང་ཞག་ལྔ་ཁོ་ན་སྟེ། །ཁྱོད་སྤྱད་སུ་ཡང་མི་ནང་སྐྱེ། །ཚུལ་དགའ་ཆོས་སྨྲས་མདུན་འདོན་བློན། །ཞིང་རིང་བག་གཏོང་དེ་དག་འཇིག །ཁྲུམས་སྟོད་དང་ནི་ལྷ་མཚམས་ལ། །མངལ་དུ་འཇུག་པར་བྱེད་པ་སྟེ། །དབོ་དང་ཡང་ནི་ཐ་སྐར་དང་། །ཆུ་སྨད་ལ་ནི་འཕེལ་བར་བྱེད། །སྣར་མ་ནག་པ་གྲོ་བཞིན་འཆི། །གསུམ་པོ་དེ་དག་ཤེས་པར་གྱིས། །མཆུ་སྣྲུབས་ནམ་གྲུ་དེ་དག་གསུམ། །རྒུད་བྱེད་མཁས་པས་ཤེས་པར་གྱིས། །ལྷ་མཚམས་བྱེད་པ་ཐམས་ཅད་ལ། །ལས་དག་གི་ནི་རྒྱུ་སྐར་ཏེ། །མཁས་པས་ཤེས་པ་ཁོ་ནར་གྱིས། །སྣྲོན་ནི་ཕུན་སུམ་ཚོགས་པར་བྱེད། །ཁྲུམས་སྨད་སྐག་གིས་ཐོབ་བྱེད་གྲེ། །ཆུ་སྟོད་ཐ་སྐར་གསུམ་པོ་བདེ། །མེ་བཞི་སྒྲུབ་མིན་དྲུག་དབྱེར་མེད། །དེ་བཞིན་མཁས་པས་གསུམ་ཤེས་གྱིས། །ས་རི་གྲོགས་དང་གྲོགས་མཆོག་སྟེ། །མགོ་དང་ལག་དང་མོན་གྲུ་བཞིན། །ས་ག་དང་ནི་མོན་གྲེ་ཡང་། །དོན་ནི་འབྲས་བུར་བཅས་པ་ཡིན། །སྦྲུལ་གྱི་ལྷ་མོ་སྐག་འདིར་སྨྲ། །ཚེས་བརྒྱད་ལ་ནི་ཁྱོད་གནས་ཀྱིས། །ཡུད་ཙམ་བཅོ་ལྔས་ཁྱོད་འགྲོ་བྱེད། །གོད་"],["ཟ 201b","པའི་ཤ་ནི་ཟས་ཡིན་ནོ། །འགྲོ་བའི་ནང་དུ་གཤིན་རྗེ་ཡི། །བྱེད་པ་མི་ཟད་ཁྱོད་གནས་ཀྱིས། །ཉིན་དེར་ཁྱོད་སྤྱོད་སུ་མིར་སྐྱེ། །ཁྲོ་ཞིང་སྡིག་པ་ཅན་དུ་འགྱུར། །ཤིན་ཏུ་མི་སྡུག་ཚུལ་ཁྲིམས་ཉམས། །ཆོས་གོས་གདིང་བ་ཟད་འགྱུར་ཞིང་། །ཁྲུམས་སྨད་ཅེས་བྱ་རབ་མཆོག་ལ། །མངལ་དུ་འཇུག་པ་སྟོན་པར་བྱེད། །མེ་བཞི་སྨིན་དྲུག་འཆི་བར་བྱེད། །མགོ་སྣྲུབས་གྲེ་ནི་རོ་མྱངས་པས། །རྒུད་བྱེད་ཆུ་སྟོད་ཐ་སྐར་དང་། །སྣྲོན་ནི་ལས་ཀྱི་རྒྱུ་སྐར་ཡིན། །སྣྲུབས་དང་ནམ་གྲུ་མཆུ་ཞེས་པ། །གསུམ་པོ་ཕུན་སུམ་ཚོགས་པར་བྱེད། །བྲ་ཉེ་བདེ་བྱེད་གྲོ་དབོ་དང་། །གྲོ་བཞིན་མཆུ་གཉིས་ཁྱོད་ཐོས་སྒྲུབ། །ནག་པ་སྣར་མ་མཆུ་གཉིས་དང་། །མོན་གྲེ་ལྷ་མཚམས་ས་ག་དང་། །ལག་དང་ནབ་སོ་དེ་དག་གྲོགས། །ཁྲུམས་སྟོད་ཀྱང་ནི་དེ་བཞིན་ནོ། །གཤིན་རྗེའི་ཡི་དགས་ལྷ་མོས་སྨྲས། །ཚེས་དགུ་ལ་ནི་ཁྱོད་གནས་ཤིང་། །ཡུད་ཙམ་སུམ་ཅུར་ཉིན་མཚན་དུ། །ཏིལ་གྱི་སྦྱར་ཐུག་ཟས་ཡིན་ནོ། །སེམས་ཅན་བྱེད་པ་ཆུང་འབྲིང་སྒྲུབས། །ཞག་བརྒྱད་ཐམ་པར་ནད་པ་སོས། །གང་མའི་བྲ་ཉེ་སུ་མིར་སྐྱེ། །བསོད་ནམས་བྱེད་པར་བཤད་པ་ཡིན། །བརྫུན་སྲོག་ཤིན་ཏུ་ཡུན་རིངས་བསྲུངས། །སྣྲུབས་ནི་ལས་ཀྱི་རྒྱུ་སྐར་ཡིན། །འདིར་ཡང་ནམ་གྲུས་མངལ་དུ་འཇུག །ས་ག་ལ་ཡང་འཆི་བར་བྱེད། །ལག་ཅེས་བྱ་བ་ཁོ་ན་དང་། །མོན་གྲེ་ཡང་ནི་གསུམ་པ་ཡིན། །སྣར་མ་དང་ནི་ནག་པ་དང་། །གསུམ་པ་གྲོ་བཞིན་འདིར་དགའ་བྱེད། །དབོ་དང་བྲ་ཉེ་རྒུད་བྱེད་ཡིན། །ཆུ་སྨད་ཕུན་སུམ་ཚོགས་པར་བྱེད། །ཐ་སྐར་དང་ནི་གྲེ་དང་ནི། །མཆུ་གཉིས་འཕེལ་བར་བྱེད་པ་ཡིན། །གསུམ་པོ་དེ་དག་ཤེས་པར་གྱིས། །མེ་བཞི་དང་ནི་བྱི་བཞིན་དང་། །སྨིན་དྲུག་ཀྱང་ནི་བདེ་བར་བྱེད། །ས་རི་དེ་ལ་སྒྲུབ་པ་ཡིན། །མགོ་གཉིས་དང་ནི་མོན་གྲུ་བཅས། །དེ་གསུམ་རྗེ་གྲོགས་ཤེས་པར་གྱིས། །སྣྲོན་རྒྱལ་ལྷ་མཚམས་ཆུ་སྟོད་དང་། །ནབ་སོ་ལྷག་པར་ཟླ་བའང་ཡིན། །སྐལ་ལྡན་ལྷ་མོ་གྲེ་ཡིས་སྨྲས། །ཚེས་བཅུ་ལ་ནི་ཁྱོད་གནས་ཤིག །བིལ་བ་མར་སར་ཟས་ཡིན་"],["ཟ 202a","ཏེ། །ཡུད་ཙམ་སུམ་ཅུར་ཁྱོད་ཀྱིས་འགྲོ། །འགྲོ་འདིར་བྱ་བ་ཆུང་ངུ་སྒྲུབས། །ཞག་བདུན་ནད་པ་ཁྱོད་སྤྱོད་པས། །སུ་ཞིག་མིར་སྐྱེ་དྲི་དགའ་འདོད། །གོས་དང་རྒྱན་དག་འདོད་པ་ཡིན། །བྱེ་བྲག་ཕྱེད་རྣམས་སུ་སྲུང་བ། །ཐ་སྐར་ལ་ནི་མངལ་འཇུག་འགྱུར། །ནབ་སོས་འཆི་མགོ་ཟིན་རོ་མྱང་། །འཕེལ་བྱེད་སྨིན་དྲུག་རྒུད་པར་བྱེད། །མེ་བཞིའང་མཁས་པས་མངོན་ཤེས་གྱིས། །གྲེ་ཞེས་བྱ་དང་བྲ་ཉེ་དང་། །ཆུ་སྨད་ཅེས་ནི་བྱ་བ་གསུམ། །ཕུན་སུམ་ཚོགས་བྱེད་ཤེས་པར་གྱིས། །འདི་ནི་ས་ག་མོན་གྲེ་ཡང་། །སྒྲུབ་ཡིན་ལག་ལའང་བདེ་བ་སྟེ། །སྣར་མ་ནག་པ་གྲོ་བཞིན་ཉིན། །མཁས་པས་གྲོགས་གཉིས་ཤེས་པར་གྱིས། །རྣམ་པ་དྲུག་ཏུ་འགྱུར་བ་ནི། །སྐག་དང་ནམ་གྲུ་རྒྱལ་དག་དང་། །སྣྲུབས་དང་སྣྲོན་ཞེས་བྱ་བ་དང་། །ཁྲུམས་གཉིས་གང་ཡིན་འདིར་ཡིན་ནོ། །ལྷག་པར་ཡང་ནི་དེ་བཞིན་དུ། །ཐམས་ཅད་ཀྱང་ནི་བགྲང་བར་གྱིས། །མཁས་པ་བློ་གྲོས་ལྡན་པ་ཡིས། །རང་གི་ཐམས་ཅད་ཤེས་པར་གྱིས། །གྲེ་དབོ་ཉི་མའི་ལྷ་མོས་སྨྲས། །ཚེས་ནི་བཅུ་གཅིག་ཁྱོད་གནས་ཀྱིས། །ཡུད་ཙམ་བཞི་བཅུ་རྩ་ལྔ་ཡིས། །ཁྱོད་ནི་རྣམ་པར་གྲོལ་བར་གྱིས། །མགོ་ཡིས་ལས་ནི་ཆུང་ངུས་ཀྱང་། །ས་བོན་ཐོབ་ཅིང་བསྐྱེད་བྱ་སྟེ། །ཞག་བཅུར་ནད་པ་ཞི་བར་གྱིས། །ཁྱོད་སྤྱད་སྐྱེ་དགུ་གང་འབྱུང་བ། །བླུན་ཞིང་བསྙེན་གནས་གནས་པ་དང་། །སྦྱིན་བྲལ་འགྲོ་ལ་སྡང་མི་སྡུག །དུག་གིས་འཆི་བར་འགྱུར་བ་སྟེ། །དེ་ཡི་མངལ་འཇུག་བྲ་ཉེ་ཤོག །ནམ་གྲུ་མོན་གྲེ་འཕེལ་བར་བྱེད། །ལག་ཅེས་བྱ་དང་ས་ག་དང་། །སྣྲོན་ཞེས་བྱ་བ་གསུམ་པ་སྟེ། །དེ་དག་འཆི་བར་བྱེད་པ་ཡིན། །ཁྲུམས་སྨད་དང་ནི་རྒྱལ་ཡང་འདིར། །རྒུད་བྱེད་ཡིན་པར་ཤེས་པར་གྱིས། །སྣར་མ་དང་ནི་ཆུ་སྨད་ཀྱང་། །དེའི་ལས་རྒྱུ་སྐར་ཤེས་པར་གྱིས། །མེ་བཞིའང་ཕུན་སུམ་ཚོགས་བྱེད་ཅིང་། །བྱི་བཞིན་དང་ནི་སྨིན་དྲུག་ཀྱང་། །བདེ་བར་བྱེད་པའི་གནས་ཡིན་ཏེ། །མོན་གྲུ་དང་ནི་མགོ་སྒྲུབ་བྱེད། །ནབ་སོ་ཁྲུམས་སྟོད་ལྷ་མཚམས་འདིར། །མཁས་པ་"]]}