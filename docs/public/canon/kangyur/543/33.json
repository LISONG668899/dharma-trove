ད་བྱེད། །ལོ་ནི་བརྒྱ་དང་ལྔ་བཅུར་འཚོ། །དེ་ལུས་ཞིག་ནས་ལྷ་ཡུལ་འགྲོ། །འཁོར་བ་རྣམས་སུ་འཁོར་བ་ན། །ཡུན་རིང་བདེ་བ་རྗེས་མྱོང་ནས། །བདག་ཉིད་ཆེན་པོ་མཐར་གྱིས་དེ། །བྱང་ཆུབ་ཐོབ་པར་འགྱུར་བ་ཡིན། །དེ་ལྟར་རྣམ་པ་མང་པོ་ཡི། །ང་ཡི་བསྟན་ལ་དགེ་སློང་རྣམས། །ཤེས་རབ་ལྡན་ཉིད་ཆོས་ཀྱང་སྤྱོད། །དུས་ཀྱི་མཐའ་ལ་དེ་ཚེ་འབྱུང་། །ཕྱི་མ་དེ་ཚེ་དུས་དག་ཏུ། །དགེ་སློང་དགྲ་བཅོམ་ཞེས་བྱ་བ། །དེ་ནི་སྔགས་དོན་བདག་ཉིད་ལྡན། །རྒྱུད་ཤེས་དེ་བཞིན་མང་དུ་ཐོས། །གནོད་སྦྱིན་སྔགས་ནི་རབ་བརྗོད་པས། །དེ་ལ་བུམ་པ་བཟང་པོ་འགྲུབ། །སྔོན་ནི་ངས་ནི་གང་བཤད་པའི། །ཐེག་པ་ཆེན་པོའི་མདོ་སྡེ་ཡང་། །དེ་ཡི་ཚེ་ན་བུམ་པ་ལས། །དཀའ་ཐུབ་ཆེན་པོ་འདྲེན་པར་བྱེད། །གླེགས་བམ་དེ་ལ་དེས་བལྟས་ནས། །དེ་ལ་སྔགས་ནི་ཟློས་པ་ན། །གནོད་སྦྱིན་བསྒྲུབ་པའི་བུམ་པ་ལ། །དེར་ནི་བསྲུང་བ་མ་བྱས་པའི། །བག་མེད་དྲན་པ་ཉམས་པ་ཡིས། །གཙུག་སྤྱོད་ཀྱིས་ནི་བུམ་པ་ཕྲོགས། །དེ་ནི་དེ་ནས་སྔགས་གྲུབ་པའི། །དགེ་སློང་སྔགས་ནི་ཟློས་བྱེད་པའི། །བུམ་པ་དག་ནི་བལྟས་པ་ན། །དེར་ནི་མངོན་པར་མཐོང་མ་གྱུར། །དེ་ནས་ཁྲོ་བས་མིག་དམར་ཞིང་། །རྣམ་གཡོ་ཚིག་ཏུ་སྨྲ་བ་ནི། །ཚངས་པ་དཀའ་བའི་མཐར་གྱུར་པར། །བརྒྱ་བྱིན་སོགས་བཅས་དབང་ཕྱུག་ཆེ། །སྔགས་ཀྱིས་མ་བཀུག་མ་འོངས་ན། །སྔགས་པ་བདག་མིན་སྔགས་རྒྱལ་མིན། །གང་ཞིག་སངས་རྒྱས་སྲས་སྔགས་དང་། །རྒྱལ་བ་མཆོག་གིས་"],["ན 326b","སྔགས་དག་ནི། །ཚར་གཅོད་དོན་དུ་གང་གསུངས་པའམ། །གདུལ་དཀའ་འདུལ་བར་བྱེད་པའང་རུང་། །གལ་ཏེ་ཀུན་རྣམས་མ་བཀུག་ན། །ས་སྟེང་མ་ལུས་དེ་དག་མེད། །དེ་ནས་སྔགས་པ་ཆེན་པོ་ལངས། །བརྟུལ་ཞུགས་བརྟན་ཞིང་ལས་རྣམས་གྲུབ། །ཇི་ལྟར་སྔགས་ནི་བྱས་པ་ཡི། །སྦྱོར་བ་མཐོང་བས་རྒྱུད་དག་ཀྱང་། །རྐུན་མ་དགུག་པ་དེ་དོན་གཙོར། །སྦྱོར་བ་རབ་ཏུ་བྱས་པར་གྱུར། །སྐད་ཅིག་དྲན་པ་ཙམ་གྱིས་ནི། །སྡོམ་བརྩོན་དེ་ནི་ལས་མྱུར་བྱེད། །ཡི་གེ་ཧཱུྃ་གི་སྔགས་གཅིག་གིས། །ཚངས་སོགས་ས་ས་སྟེང་འདྲེན་པར་བྱེད། །ལྷ་རྣམས་མ་ལུས་རབ་བཀུག་པ། །ཚངས་སོགས་བརྒྱ་བྱིན་དང་ཡང་བཅས། །ཧ་ཧ་ཞེས་བྱའི་སྒྲ་འདོན་ཅིང་། །ཉམ་ཐག་འཇིགས་པའི་སྒྲ་ཡང་སྒྲོགས། །ཅི་བགྱི་ཞེས་བྱའི་བློ་བྱེད་ཅིང་། །བདག་ཅག་འདིར་ནི་ཉེས་མེད་སྨྲ། །མྱུར་ཞིང་རབ་ཏུ་རིངས་པར་ཡངས། །བློ་ལྡན་དགེ་སློང་འཇིགས་མེད་པས། །ལྷ་རྣམས་ལ་ནི་རབ་སྨྲས་པ། །འདིར་ནི་བུམ་པ་སླར་བྱིན་ཞེས། །ལྷ་རྣམས་ཕན་ཚུན་ཐམས་ཅད་ལ། །དགེ་སློང་དེས་ནི་རབ་ཏུ་སྨྲས། །གང་གིས་བུམ་པ་བཟང་པོ་ཁྱེར། །ཁྱོད་ཀྱིས་མྱུར་དུ་རབ་ཏུ་སྨྲོས། །ལྷ་རྣམས་ཀུན་གྱིས་བལྟས་པ་ན། །ཀུན་ཏུ་ཡང་ནི་མ་མཐོང་གྱུར། །བུམ་པ་འདི་ནི་སུ་ཡིས་ཁྱེར། །ལྷ་ཡི་དབང་པོས་ཡང་དག་དགོངས། །བྱང་ཆུབ་སེམས་དཔའ་འོད་ཆེན་པོ། །དཔལ་ལྡན་ལག་ན་རྡོ་རྗེ་ཅན། །དེ་ཡི་བུ་ནི་མི་བཟད་ཡོད། །ཁྲོ་བ་ཆེ་ཞིང་ཤིན་ཏུ་གདུག །བགེགས་ཀྱི་གཟུགས་ཀྱིས་སྔགས་པ་ལ། །འགྲོ་བ་ཀུན་ལ་རྣམ་པར་རྒྱུ། །བུམ་པ་དེ་ནི་དེས་ཁྱེར་མཐོང་། །ལྷ་ཡི་བདག་པོས་དེ་ཡང་སྨྲས། །རྡོ་རྗེའི་རིགས་ཀྱི་བགེགས་ཡོད་པ། །ས་སྟེང་རྩེ་ཞིང་རོལ་པར་བྱེད། །འདིས་ནི་བདག་ལ་མ་མཆོད་པས། །དེས་ནི་བུམ་པ་དེ་འདིར་ཁྱེར། །ལྷ་ཡི་བདག་པོས་དེ་སྨྲས་ནས། །ཕྱིར་ཡང་ལྷ་ཡི་གནས་སུ་སོང་། །དེ་ཚེ་རང་ཉིད་སྔགས་ཀྱིས་ནི། །ལྷ་རྣམས་མ་ལུས་སླར་གཤེགས་གས་གསོལ། །སྐད་ཅིག་ཡུད་ཙམ་ཉིད་ཀྱིས་ནི། །ཤིན་ཏུ་ལེགས་པར་ཡང་དག་བཀུག །དེ་ཚེ་དབང་མེད་བུམ་པར་བཅས། །བགེགས་དེ་ཉིད་དང་བཅས་པར་འོངས། །དེ་ནས་"],["ན 327a","དེ་ནི་བགེགས་དེ་ཡིས། །ཡི་དགས་རྣམས་ལ་བུམ་པ་བྱིན། །དེ་ནས་དེ་ཡི་བགེགས་དེས་ནི། །ཚིག་འདི་དག་ནི་རབ་ཏུ་སྨྲས། །ཡི་དགས་འཇིག་རྟེན་བུམ་པ་ཁྱེར། །ང་ནི་དེ་ལ་དགའ་བ་མེད། །སྔགས་པ་དེས་ནི་དཀའ་བ་དང་། །དཀའ་བས་བཏུད་དེ་བགེགས་ལ་སྨྲས། །སོང་ཤིག་སོང་ཤིག་བགེགས་ཆེན་པོ། །ཕྱིན་ཅད་འདི་ལྟར་མ་བྱེད་ཅིག །དེ་ནས་དེས་ནི་ཡི་དགས་དག །དེ་ཡི་མོད་ལ་བཀུག་པར་གྱུར། །ལྟོགས་ཤིང་ངལ་བའི་སེམས་དང་ནི། །དམན་ཞིང་དེ་དག་ཁབ་ཙམ་ཁ། །ཤིན་ཏུ་མི་བཟད་ཆེན་པོ་དེ། །ཉམ་ཐག་སྐད་ཀྱང་རབ་ཏུ་འདོན། །སྙིང་རྗེའི་ཚིག་ཏུ་སྨྲ་བ་ནི། །བདག་ཉིད་ཆེན་པོ་ཡོངས་སུ་སྐྱོ་བས། །ཁྱོད་ཀྱི་བུམ་པ་འདིར་འོངས་ཀྱིས། །ཇི་ལྟར་འདོད་བཞིན་བདག་ལ་བྱོས། །སྔགས་པ་སྙིང་རྗེ་ཆེར་ལྡན་པས། །ཡང་དག་འདར་བ་རབ་ཏུ་སྐྱེས། །སྙིང་རྗེས་བརླན་པའི་སེམས་ཀྱིས་ནི། །ཚིག་ནི་འདི་དག་རབ་ཏུ་སྨྲས། །ཁྱོད་ཀྱི་འཇིག་རྟེན་སྡུག་བསྔལ་ཅི། །ཡུན་མི་རིང་པར་རབ་ཏུ་སྨོན། །དམན་པའི་ཡིད་ཀྱིས་དེ་སྨྲས་པ། །བཀྲེས་པས་ཡང་དག་གདུངས་པར་གྱུར། །ཡི་དགས་འཇིག་རྟེན་སྐོམ་པ་ཡིས། །བདག་ཉིད་ཆེན་པོ་ཡིན་ཡང་རུང་། །དགེ་སློང་སྙིང་རྗེ་ཆེན་པོས་ནི། །དེ་དག་ལ་ནི་བུམ་པ་བྱིན། །དེ་ནས་དེ་དག་ཡིད་དགའ་ནས། །མྱུར་བར་རང་གི་གནས་སུ་སོང་། །དེ་དག་བསམ་པ་ཙམ་གྱིས་ནི། །བུམ་པ་ལས་ནི་བཟའ་བཏུང་བྱུང་། །དགེ་སློང་དགའ་བོའི་འོག་ཏུ་ནི། །ཙནྡན་སྐྱོང་ནི་འབྱུང་བར་འགྱུར། །དེ་ཚེ་དུས་ནི་ཐ་མ་ལ། །ལོ་ནི་སུམ་བརྒྱ་དག་ཏུ་འཚོ། །བདག་ཉིད་ཆེན་པོ་བྱང་ཆུབ་ནི། །བགེགས་མེད་མྱུར་དུ་རྙེད་དཀའ་ཐོབ། །རྒྱལ་པོ་བཙུན་པ་ཞེས་བྱ་བ། །ང་ཡི་བསྟན་པ་ནུབ་བྱེད་པ། །དུས་ཀྱི་ཐ་མ་དེ་ཡི་ཚེ། །ཐེ་ཚོམ་མེད་པར་འབྱུང་བར་འགྱུར། །ཤར་ཕྱོགས་ནས་ནི་བརྩམས་ནས་སུ། །ཁ་ཆེའི་ཡུལ་གྱི་བར་དག་ཏུ། །རྨོངས་པས་ལྷ་ཁང་མཆོད་རྟེན་རྣམས། །དེ་ཚེ་དེ་བཞིན་འཇིག་པར་འགྱུར། །དགེ་སློང་ཚུལ་ཁྲིམས་ལྡན་པ་རྣམས། །བློ་ངན་དེས་ནི་གསོད་པར་བྱེད། །བྱང་གི་ཕྱོགས་"],["ན 327b","སུ་བརྟེན་ནས་ནི། །དེ་ནི་འཆི་བར་འགྱུར་བ་ཡིན། །མི་མ་ཡིན་པ་ཉིད་འཁྲུགས་ནས། །ཡུལ་འཁོར་ཕྱུགས་དང་གཉེན་རྣམས་དང་། །རི་ཡི་དུམ་བུས་བཅོམ་པར་འགྱུར། །བློ་ངན་དེ་ནི་ས་འོག་འགྲོ། །དེ་ནི་འོག་ནས་འོག་ཏུ་འགྲོ། །དམྱལ་ལས་དམྱལ་བ་རབ་དྲག་པར། །སྡུག་བསྔལ་སྡུག་བསྔལ་དྲག་པར་ནི། །མི་བཟད་པར་ནི་ཡང་དག་ལྟུང་། །མནར་མེད་ཞེས་ནི་བྱ་བ་ཡི། །སྡིག་པའི་ལས་ཀྱིས་དམྱལ་བ་ནི། །དེ་ནས་བསྐལ་བ་ཆེར་འཚེད་པ། །བདག་ཉིད་ངན་པ་གོ་མི་ཤན། །མི་དགེའི་བཤེས་གཉེན་ལ་བརྟེན་ནས། །སྡིག་པ་ཤིན་ཏུ་མི་བཟད་བྱས། །དེ་ནི་ང་ཡི་བསྟན་པ་ལ། །རྣམ་པ་ཀུན་གྱིས་འབད་ནས་ནི། །སེམས་ནི་མ་ལུས་རབ་བཏང་ནས། །ཕུན་སུམ་ཚོགས་དང་དེ་ནས་སྤྱོད། །ངེས་པར་སངས་རྒྱས་ཉིད་ལམ་ནི། །ཡན་ལག་བརྒྱད་ཀྱི་ཐེག་པས་ནི། །དེ་ཚེ་དེ་ནི་རབ་འགྲོ་ཞིང་། །མྱ་ངན་ནད་མེད་དམ་པ་ཐོབ། །དེ་ཡི་འོག་ཏུ་ས་སྲུང་བ། །སངས་རྒྱས་ཕྱོགས་ཞེས་རྣམ་པར་གྲགས། །ཕྱོགས་ཆེ་གཏོང་བ་ཆེ་བ་དང་། །སངས་རྒྱས་རྣམས་ཀྱི་བསྟན་ལ་དད། །དེ་ཚེ་དུས་ཀྱི་ཐ་མ་ལ། །འབྱུང་བར་འགྱུར་བར་ཐེ་ཚོམ་མེད། །ཐམས་ཅད་མངོན་དགའི་རྒྱལ་པོ་སྟེ། །སྟོན་པའི་བསྟན་པ་དེ་གཙོར་བྱེད། །ཀུན་དགའ་ར་བ་མཆོད་རྟེན་གནས། །སྟོན་པའི་གཟུགས་བརྙན་བླ་ན་མེད། །མཚེའུ་རྫིང་དང་ཁྲོན་པ་དང་། །མཚོ་རྣམས་དག་ནི་དུ་མ་དག །རྒྱལ་པོ་ཆེན་པོས་བྱས་ནས་ནི། །ཚེ་ཟད་ལྷ་ཡི་གནས་སུ་སོང་། །དེས་ཀྱང་ས་སྟེང་གྲུབ་པ་ནི། །པདྨ་འཆང་བ་བརྩོན་འགྲུས་ཆེ། །བདག་ཉིད་ཆེན་པོ་སེམས་དཔའ་ལ། །ས་ཡི་བདག་པོར་དོན་དུ་གཉེར། །དེ་ཡི་སྔགས་ཀྱི་མཐུ་ཡིས་ནི། །ལོ་ནི་སུམ་བརྒྱ་དག་ཏུ་འཚོ། །དེ་ཡི་ལས་ཀྱི་ལྷག་མ་ཡིས། །མྱུར་དུ་བྱང་ཆུབ་འཐོབ་པར་འགྱུར། །དེ་ཡི་བུ་ནི་རྒྱལ་པོ་ཡང་། །སྡེ་ཆེན་སྟོབས་ནི་ཆེ་བ་ཡི། །ཟབ་མོའི་ཕྱོགས་ཞེས་རྣམ་པར་གྲགས། །གྲོང་ཁྱེར་ས་ནི་ལྔ་ལེན་འབྱུང་། །རིག་པའི་བདག་ཉིད་རྒྱལ་པོ་དེའང་། །དེ་ཡི་ཚེ་ན་འབྱུང་བར་འགྱུར། །གཙུག་ལག་ཁང་དང་གནས་ཁང་དང་། །མཆོད་རྟེན་རྫིང་དང་ཁྲོན་པ་ནི། །འོད་ཆེན་"]]}