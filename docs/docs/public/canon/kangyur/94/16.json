། །རིགས་ནི་རྒྱལ་རིགས་ཡིན་ཏེ་འོད་དཔག་ཚད། །ཉི་ཤུ་རྩ་གཉིས་ཤེས་རབ་ཆེན་པོ་ཡབ། །ཤེས་རབ་མཆོག་མ་རྒྱལ་ཡུམ་ཤེས་རབ་བྱིན། །སྲས་ཡིན་ཤེས་རབ་བཟང་པོ་རིམ་གྲོ་པ། །ཤེས་རབ་ཆེན་པོ་བློ་གྲོས་ཅན་ཡིན་ཏེ། །འཇིགས་པ་མེད་པའི་ཤེས་རབ་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་བརྒྱད་ཅུ་ཀུན་ལ་ཡང་། །རྒྱལ་བའི་རྒྱལ་པོ་ཡི་ནི་ཚོགས་མཆོག་རྣམས། །བྱེ་བ་ཕྲག་ནི་ཁྲི་ཕྲག་བཅུ་བཅུ་ཡོད། །མི་ཚེ་ལོ་གྲངས་བྱེ་བ་བདུན་ཅུ་དྲུག །བདུད་དང་ཉོན་མོངས་ཐམས་ཅད་འཇོམས་མཛད་པའི། །དམ་ཆོས་ལོ་གྲངས་བརྒྱད་ཁྲིའི་བར་དུ་གནས། །རྒྱལ་བའི་སྐུ་གདུང་དག་ནི་རྒྱས་འགྱུར་ལ། །མཆོད་རྟེན་འབུམ་ཕྲག་སྙེད་ཀྱི་འཁོར་དང་ལྡན། །དེ་བཞིན་གཤེགས་པ་འཇམ་པའི་དབྱངས་སྐྱེ་བའི། །ཡུལ་ནི་ཡིད་དུ་འོང་བའི་དབྱངས་ཞེས་བྱ། །རྒྱལ་བའི་རིགས་ནི་རྒྱལ་རིགས་འོད་ཀྱི་ཚད། །དཔག་ཚད་བདུན་སྟོང་ཡབ་ནི་ཡིད་འཐད་ཡིན། །དབྱངས་མཆོག་མ་ཞེས་བྱ་བ་རྒྱལ་བའི་ཡུམ། །སྲས་པོ་དབྱངས་སྲེད་དགའ་བོ་རིམ་གྲོ་པ། །དུལ་བར་གནས་པའི་དབྱངས་ནི་མཁས་པ་སྟེ། །མཆོག་གི་དབྱངས་ཞེས་བྱ་བ་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་བཅུ་སྟེ་ཀུན་ལ་ཡང་། །ཕ་རོལ་ཕྱིན་ལ་ཤིན་ཏུ་ངེས་ཐོབ་པ། །བྱེ་བ་ཕྲག་ནི་ཉི་ཤུ་གསུམ་གསུམ་ཡོད། །མི་ཚེ་ལོ་གྲངས་བདུན་ཁྲི་དྲུག་སྟོང་ཡིན། །འཇིག་རྟེན་མཁྱེན་པའི་དམ་པའི་ཆོས་དག་ཀྱང་། །ལོ་གྲངས་སྟོང་གི་བར་དུ་གནས་པར་འགྱུར། །འཇིག་རྟེན་མཁྱེན་པ་མྱ་ངན་འདས་པ་ཡི། །སྐུ་གདུང་མཆོད་རྟེན་དཔག་ཚད་བརྒྱད་པ་གཅིག །དེ་བཞིན་"],["ཀ 210a","གཤེགས་པ་ཆགས་པ་མེད་མཛད་ཀྱི། །སྐྱེ་བའི་ཡུལ་ནི་བསོད་ནམས་བསགས་ཞེས་བྱ། །རྒྱལ་བའི་རིགས་ནི་བྲམ་ཟེ་འོད་ཀྱི་ཚད། །དཔག་ཚད་བདུན་ཅུ་ཡབ་ནི་ཆགས་མེད་ཡིན། །ལྷ་བདག་མ་ཞེས་བྱ་བ་རྒྱལ་བའི་ཡུམ། །སྲས་པོ་བདེན་སྦྱིན་ལྷ་ཆེན་རིམ་གྲོ་པ། །མཛོད་ཆེན་འཆང་བ་བློ་གྲོས་ཅན་ཡིན་ཏེ། །རྣམ་པར་ངེས་པའི་ལྷ་ནི་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་དྲུག་ཅུ་ཀུན་ལ་ཡང་། །དངོས་པོར་འཛིན་དང་བྲལ་བའི་བསམ་གཏན་པ། །བྱེ་བ་ཕྲག་ནི་བཅུ་གཅིག་བཅུ་གཅིག་ཡོད། །མི་ཚེ་ལོ་གྲངས་དག་ནི་བདུན་ཁྲི་ཡིན། །སྟོན་པ་མྱ་ངན་འདས་ནས་དམ་ཆོས་དག །ལོ་གྲངས་དགུ་ཁྲི་ཉིས་སྟོང་བར་དུ་གནས། །རྒྱལ་བའི་སྐུ་གདུང་རྒྱས་འགྱུར་མཆོད་རྟེན་གྲངས། །བྱེ་བ་ཕྲག་ནི་སྟོང་ཕྲག་བརྒྱད་ཅུ་འབྱུང་། །དེ་བཞིན་གཤེགས་པ་གཙོ་བོས་བྱིན་སྐྱེ་བའི། །ཡུལ་ནི་སྐྱེ་བོའི་མཆོད་རྟེན་ཞེས་ཀྱང་བྱ། །རིགས་ནི་བྲམ་ཟེ་ཡིན་ཏེ་འོད་དཔག་ཚད། །ཉི་ཤུ་རྩ་གཉིས་ཡབ་ནི་གཙོ་བཟངས་ཡིན། །གཙོ་མཆོག་མ་ཞེས་བྱ་བ་རྒྱལ་བའི་ཡུམ། །སྲས་པོ་གཙོ་སྲེད་གཙོ་བོ་རིམ་གྲོ་པ། །གཙོས་བྱིན་ཞེས་ནི་བྱ་བ་མཁས་པ་སྟེ། །འཇིགས་པ་མེད་པའི་ཡེ་ཤེས་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་སུམ་ཅུ་དྲུག་ཀུན་ལའང་། །རྒྱགས་དང་ང་རྒྱལ་བྲལ་བའི་བསམ་གཏན་པ། །བྱེ་བ་ཕྲག་ནི་དགུ་བཅུ་གཉིས་གཉིས་ཡོད། །མི་ཚེ་ལོ་གྲངས་དག་ནི་ལྔ་ཁྲི་ཡིན། །སྟོན་པ་མྱ་ངན་འདས་ནས་དམ་ཆོས་དག །ལོ་གྲངས་བདུན་ཁྲིའི་བར་དུ་གནས་པར་འགྱུར། །རྒྱལ་བའི་སྐུ་གདུང་མཆོད་རྟེན་གཅིག་ཡིན་ཏེ། །དཔག་ཚད་བདུན་པ་གསེར་གྱིས་རྣམ་པར་སྤྲས། །དེ་བཞིན་གཤེགས་པ་གཙོ་བོ་སྐྱེ་བ་ཡི། །ཡུལ་ནི་མཆོད་པ་མཆོག་དང་ལྡན་ཞེས་བྱ། །རིགས་ནི་རྒྱལ་རིགས་ཡིན་ཏེ་འོད་དཔག་ཚད། །ཉི་ཤུ་གཉིས་ཡོད་ཡབ་ནི་མཆོག་ལེགས་ཡིན། །བསོད་ནམས་རིན་ཆེན་མ་ནི་རྒྱལ་བའི་ཡུམ། །སྲས་པོ་སྐར་ལྡན་སྐར་བཟངས་རིམ་གྲོ་པ། །བསོད་ནམས་འདོད་ཅེས་བྱ་བ་མཁས་པ་སྟེ། །བདེན་པ་རྣམ་པར་ལྟ་བ་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་དྲུག་ཅུ་དྲུག་ཀུན་ལའང་། །བདུད་དང་ཉོན་མོངས་ལྟ་བ་རབ་འཇོམས་པ། །"],["ཀ 210b","བྱེ་བ་ཕྲག་ནི་ཉི་ཤུ་གསུམ་གསུམ་ཡོད། །མི་ཚེ་ལོ་གྲངས་བདུན་ཁྲི་ཉིས་སྟོང་ཡིན། །ཞི་བར་བྱིན་པའི་དམ་པའི་ཆོས་དག་ཀྱང་། །ལོ་གྲངས་དགུ་ཁྲིའི་བར་དུ་གནས་པར་འགྱུར། །འཇིག་རྟེན་མཁྱེན་པ་མྱ་ངན་འདས་པ་ཡི། །སྐུ་གདུང་མཆོད་རྟེན་དཔག་ཚད་ལྔ་པ་གཅིག །དེ་བཞིན་གཤེགས་པ་ཡེ་ཤེས་མཐུ་རྩལ་གྱི། །སྐྱེ་བའི་ཡུལ་ནི་ཡེ་ཤེས་ལྟ་ཞེས་བྱ། །རིགས་ནི་བྲམ་ཟེ་ཡིན་ཏེ་འོད་དཔག་ཚད། །དགུ་བཅུ་རྩ་གཅིག་ཤེས་ལྡན་བཟང་པོ་ཡབ། །ཤེས་མཆོག་མ་ཞེས་བྱ་བ་རྒྱལ་བའི་ཡུམ། །སྲས་པོ་ཤེས་ལྡན་ཤེས་ཆེན་རིམ་གྲོ་པ། །ཤེས་པའི་ཟླ་བ་ཞེས་བྱ་མཁས་པ་སྟེ། །བློ་ཡི་མར་མེ་མཁན་ནི་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་བཅུ་སྟེ་ཀུན་ལ་ཡང་། །གསེར་དང་བོང་བར་མཚུངས་པར་མཐོང་བ་པོ། །བྱེ་བ་ཕྲག་ནི་ཁྲི་ཕྲག་གསུམ་གསུམ་ཡོད། །མི་ཚེ་ལོ་གྲངས་བདུན་ཁྲི་བརྒྱད་སྟོང་ཡིན། །ཞི་བར་ཕྱིན་པའི་དམ་པའི་ཆོས་དག་ཀྱང་། །ལོ་གྲངས་བདུན་ཁྲི་བཞི་སྟོང་བར་དུ་གནས། །ཞི་བར་ཕྱིན་པའི་མཆོད་རྟེན་གྲངས་དག་ནི། །བྱེ་བ་སྟོང་ཕྲག་དགུ་བཅུ་རྩ་བརྒྱད་འབྱུང་། །འཇིག་རྟེན་མགོན་པོ་འོད་འཕྲོ་ཅན་སྐྱེ་བའི། །ཡུལ་ནི་གཟི་ལྡན་ལེགས་པར་མཆོད་ཅེས་བྱ། །རིགས་ནི་རྒྱལ་རིགས་ཡིན་ཏེ་འོད་དཔག་ཚད། །ཉི་ཤུ་རྩ་གཉིས་ཡབ་ནི་གསལ་བ་ཡིན། །རྡོ་རྗེའི་འོད་ནི་རྒྱལ་ཡུམ་སྲས་པོ་ནི། །འོད་འཕྲོ་འོད་འཕྲོ་བཟང་པོ་རིམ་གྲོ་པ། །ཡོན་ཏན་འོད་འཕྲོ་ཅན་ནི་མཁས་པ་སྟེ། །རྣམ་པར་གྲོལ་བའི་སྒྲོན་མ་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་བརྒྱད་ཅུ་ཀུན་ལ་ཡང་། །དགྲ་བཅོམ་མི་སློབ་ཉོན་མོངས་བསྲེགས་པ་པོ། །ཐེར་འབུམ་ཐེར་འབུམ་དག་ནི་འདུས་པར་འགྱུར། །མི་ཚེ་ལོ་གྲངས་དག་ནི་བརྒྱད་ཁྲི་ཡིན། །མྱ་ངན་འདས་ནས་དེ་ཡི་དམ་ཆོས་དག །ལོ་གྲངས་བདུན་ཁྲིའི་བར་དུ་གནས་པར་འགྱུར། །རྒྱལ་བའི་སྐུ་གདུང་དག་ནི་རྒྱས་འགྱུར་ལ། །ཡིད་དུ་འོང་བའི་གདུགས་སྟོང་སྙེད་ཀྱིས་བརྒྱན། །སེམས་ཅན་སྙིང་པོ་དབང་པོ་སྐྱེ་བ་ཡི། །ཡུལ་ནི་དབང་པོའི་ཏོག་དང་ལྡན་ཞེས་བྱ། །རྒྱལ་བའི་རིགས་ནི་རྒྱལ་རིགས་འོད་ཀྱི་ཚད། །དཔག་ཚད་བརྒྱ་ཡོད་རྒྱལ་མཚན་དབང་པོ་ཡབ། །རིན་ཆེན་མཆོག་མ་ཞེས་བྱ་རྒྱལ་བའི་"],["ཀ 211a","ཡུམ། །དབང་པོ་སྲས་ཡིན་བཟང་དབང་རིམ་གྲོ་པ། །དབང་ཆེན་ཏོག་ནི་བློ་གྲོས་ཅན་ཡིན་ཏེ། །མཚོན་ཆའི་དབང་པོ་ཞེས་བྱ་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་དྲུག་ཅུ་དྲུག་ཀུན་ལའང་། །མི་སློབ་དགྲ་བཅོམ་པ་ཡི་ཚོགས་ཀུན་དག །བྱེ་བ་ཕྲག་ནི་དགུ་བཅུ་གཉིས་གཉིས་ཡོད། །མི་ཚེ་ལོ་གྲངས་ཉི་ཁྲི་ཆིག་སྟོང་ཡིན། །དམ་ཆོས་ལོ་གྲངས་ཆིག་ཁྲི་ཆིག་སྟོང་གནས། །སྐུ་གདུང་མཆོད་རྟེན་ཡིད་འོང་གཅིག་ཡིན་ལ། །འཕང་དུ་དཔག་ཚད་བཅུ་གཉིས་པ་ཡིན་ཏེ། །གསེར་གྱི་རྒྱལ་མཚན་ཏོག་བཅས་དག་གིས་སྤྲས། །དེ་བཞིན་གཤེགས་པ་ཤུགས་འཆང་སྐྱེ་བ་ཡི། །ཡུལ་ནི་ཆོས་ཀྱི་རྒྱལ་མཚན་ཞེས་ཀྱང་བྱ། །རིགས་ནི་བྲམ་ཟེ་ཡིན་ཏེ་འོད་དཔག་ཚད། །བདུན་ཅུ་རྩ་གཉིས་ཡབ་ནི་བློ་བཟངས་ཡིན། །ཡོན་ཏན་རྒྱ་མཚོ་ཞེས་བྱ་རྒྱལ་བའི་ཡུམ། །སྲས་པོ་བདེན་སྨྲ་སྟོབས་ལྡན་རིམ་གྲོ་པ། །མཐུ་རྩལ་སྟོབས་ཞེས་བྱ་བ་མཁས་པ་སྟེ། །གོམས་པར་མཆོད་ཅེས་བྱ་བ་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་བརྒྱད་ཅུ་ཀུན་ལ་ཡང་། །ཕྱིར་མི་ལྡོག་པ་བྱང་ཆུབ་གནས་པ་ཀུན། །བྱེ་བ་ཕྲག་ནི་བདུན་ཅུ་བཞི་བཞི་ཡོད། །མི་ཚེ་ལོ་གྲངས་དགུ་ཁྲི་སུམ་སྟོང་ཡིན། །རྒྱལ་བ་མྱ་ངན་འདས་ནས་དམ་ཆོས་དག །ལོ་གྲངས་ཐེར་འབུམ་ཕྲག་ནི་གསུམ་དུ་གནས། །རྒྱལ་བའི་སྐུ་གདུང་དག་ནི་རྒྱས་འགྱུར་ལ། །ཞིང་རྣམས་ཀུན་དུ་མཛེས་པ་དག་ཏུ་འགྱུར། །སེམས་ཅན་སྙིང་པོ་སྐར་རྒྱལ་སྐྱེ་བ་ཡི། །ཡུལ་ནི་འོད་འཕྲོའི་འོད་དང་ལྡན་ཞེས་བྱ། །རྒྱལ་བའི་རིགས་ནི་རྒྱལ་རིགས་འོད་ཀྱི་ཚད། །དཔག་ཚད་བརྒྱ་ཡོད་སྦྱིན་སྲེག་འོད་འཕྲོ་ཡབ། །འོད་འཕྲོ་ཆེན་མོ་ཞེས་བྱ་རྒྱལ་བའི་ཡུམ། །སྲས་པོ་སྐར་མཁན་སྣང་དབང་རིམ་གྲོ་པ། །རབ་ཏུ་བརྒྱན་ཞེས་བྱ་བ་མཁས་པ་སྟེ། །འོད་དབང་མཐའ་ཡས་པ་ནི་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་སུམ་ཅུ་དྲུག་ཀུན་ལའང་། །དགྲ་བཅོམ་རྣམ་པར་ཐར་པ་བརྒྱད་ཐོབ་པ། །བྱེ་བ་ཕྲག་ནི་བདུན་ཅུ་གསུམ་གསུམ་ཡོད། །མི་ཚེ་ལོ་གྲངས་ཉི་ཁྲི་ཉིས་སྟོང་ཡིན། །མྱ་ངན་འདས་པ་དེ་ཡི་དམ་ཆོས་དག །ལོ་གྲངས་བདུན་ཁྲིའི་བར་དུ་གནས་པར་འགྱུར། །"],["ཀ 211b","རྒྱལ་བའི་སྐུ་གདུང་མཆོད་རྟེན་གཅིག་ཡིན་ཏེ། །དཔག་ཚད་བཅུ་པ་རིན་པོ་ཆེ་ཡིས་སྤྲས། །འཇིག་རྟེན་མགོན་པོ་འོད་ནི་བཟང་པོ་ཡི། །སྐྱེ་བའི་ཡུལ་ནི་ནོར་འབྱོར་པ་ཞེས་བྱ། །རིགས་ནི་བྲམ་ཟེ་ཡིན་ཏེ་འོད་དཔག་ཚད། །ཉི་ཤུ་རྩ་གཉིས་ཡབ་ནི་བློ་བཟངས་ཡིན། །བློ་འོད་མ་ཞེས་བྱ་བ་རྒྱལ་བའི་ཡུམ། །སྲས་པོ་བློ་ལེགས་བློ་ཆེན་རིམ་གྲོ་པ། །བློ་ཡི་འབྱུང་གནས་ཞེས་བྱ་མཁས་པ་སྟེ། །བློ་ལ་གནས་ཞེས་བྱ་བ་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་བརྒྱད་ཅུ་ཀུན་ལ་ཡང་། །སྲིད་པ་ཀུན་ལ་ཆགས་པ་མེད་གྱུར་པ། །བྱེ་བ་ཕྲག་ནི་དགུ་བཅུ་གཉིས་གཉིས་ཡོད། །མི་ཚེ་ལོ་གྲངས་དགུ་ཁྲི་དགུ་སྟོང་ཡིན། །རྒྱལ་བ་ཡོངས་སུ་མྱ་ངན་འདས་ནས་ཀྱང་། །དམ་ཆོས་ལོ་གྲངས་དྲུག་ཁྲིའི་བར་དུ་གནས། །རྒྱལ་བའི་སྐུ་གདུང་དག་ནི་རྒྱས་འགྱུར་ལ། །མཆོད་རྟེན་གསེར་གྱི་རྒྱལ་མཚན་དག་གིས་བསྐོར། །འཇིག་རྟེན་མགོན་པོ་གྲགས་པ་བྱིན་པ་ཡི། །སྐྱེ་བའི་ཡུལ་ནི་མཆོད་ཅིང་བཀུར་ཞེས་བྱ། །རིགས་ནི་བྲམ་ཟེ་ཡིན་ཏེ་འོད་དཔག་ཚད། །སུམ་ཅུ་རྩ་གཉིས་ཡབ་ནི་བློ་བཟངས་ཡིན། །བྱང་ཆུབ་འདོད་ཅེས་བྱ་བ་རྒྱལ་བའི་ཡུམ། །སྲས་པོ་ཟམ་པ་དུལ་བ་རིམ་གྲོ་པ། །ཕྱོགས་ཀྱི་མཆོད་རྟེན་ཞེས་བྱ་མཁས་པ་སྟེ། །འཇིག་རྟེན་མངོན་བསྟོད་པ་ནི་རྫུ་འཕྲུལ་ཅན། །འདུས་པ་ལན་གྲངས་བརྒྱད་ཅུ་རྩ་བཞི་སྟེ། །ཀུན་ལའང་ཐ་བ་མེད་པར་བསྒོམས་པ་པོ། །བྱེ་བ་ཕྲག་ནི་སྟོང་སྟོང་འབྱུང་བར་འགྱུར། །མི་ཚེ་ལོ་གྲངས་དགུ་ཁྲི་སུམ་སྟོང་ཡིན། །འགོག་པར་ཕྱིན་པའི་དམ་པའི་ཆོས་དག་ཀྱང་། །ལོ་གྲངས་བརྒྱད་ཁྲི་སུམ་སྟོང་བར་དུ་གནས། །རྒྱལ་བའི་སྐུ་གདུང་མཆོད་རྟེན་གཅིག་ཡིན་ཏེ། །དཔག་ཚད་བརྒྱད་པ་གསེར་གྱིས་རྣམ་པར་སྤྲས། །སེམས་ཅན་སྙིང་པོ་གཟུགས་ནི་བཟང་པོ་ཡི། །སྐྱེ་བའི་ཡུལ་ནི་ཐར་པ་དགའ་ཞེས་བྱ། །དེའི་རིགས་རྒྱལ་རིགས་ཡིན་ཏེ་འོད་དཔག་ཚད། །དྲུག་ཅུ་རྩ་གཉིས་ཡབ་ནི་དོན་ཆེན་ཡིན། །ཡོན་ཏན་ཚོགས་ནི་རྒྱལ་ཡུམ་སྲས་པོ་ནི། །ཡོན་ཏན་བདག་ཉིད་དོན་ལྡན་རིམ་གྲོ་པ། །ཡོན་ཏན་མེ་ཏོག་རྒྱས་པ་མཁས་པ་སྟེ། །མཐའ་ཡས་ཡོན་ཏན་དོན་ནི་རྫུ་"]]}