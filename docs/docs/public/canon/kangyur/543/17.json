ྣ་ཚོགས་ལྡན། །འོད་ཆེན་པོས་ནི་རྗེས་སུ་མྱོང་། །ལོ་ནི་བདུན་ཅུ་རྩ་དྲུག་ཏུ། །དཔལ་ལྡན་མཆོད་རྟེན་མཆོད་པ་བྱེད། །དེ་ནས་དེ་ནི་ནད་བཏབ་ནས། །ལུས་ཞིག་ནས་ནི་ལྷ་རིས་འགྲོ། །དེ་ཡི་འོག་ཏུ་རྒྱལ་པོ་ནི། །དཔའ་བོའི་སྡེ་ཞེས་རབ་ཏུ་བརྗོད། །ཆོས་ལ་སྤྱོད་ཅིང་རྣམ་པར་གྲགས། །བསྟན་པ་འདི་ལ་མཉམ་པར་བཞག །ལྷ་མོ་མཆོད་རྟེན་དཔལ་ཆེན་མ། །དེ་ཡི་སྔགས་ཀྱང་རབ་ཏུ་བསྒྲུབས། །དེས་ཀྱང་སྟོན་པའི་ཁང་ཆེན་ནི། །དེ་ཡི་ཚེ་ན་བྱས་པར་འགྱུར། །ས་རྣམས་རྒྱལ་མཚོའི་མཐར་ཐུག་པར། །མ་ལུས་མཆོད་རྟེན་རྣམས་ཀྱིས་བརྒྱན། །དེ་ལ་རྣམ་སྨིན་ལས་ཀྱིས་ནི། །ལུས་ལས་སྐྱེས་པའི་ནད་ཀྱང་འབྱུང་། །ཟླ་ཕྱེད་གཅིག་ཏུ་སྡུག་བསྔལ་ནས། །དེ་ནས་ཤི་འཕོས་ལུས་ཞིག་འགྱུར། །ལོ་ནི་བདུན་ཅུ་དག་ཏུ་ཡང་། །མི་ཡི་ནང་དུ་རྒྱལ་ཐབས་བྱས། །ཤི་འཕོས་དེ་ནི་མཐོ་རིས་འགྲོ། །ངེས་པར་བྱང་ཆུབ་གཞོལ་བར་འགྱུར། །དེ་ཡི་འོག་ཏུ་རྒྱལ་པོ་ནི། །དགའ་བོ་ཞེས་བྱ་འབྱུང་བར་འགྱུར། །དཔལ་ལྡན་གྲོང་ཁྱེར་མེ་ཏོག་ཅེས། །སྡེ་ཆེན་སྟོབས་ནི་ཆེ་བར་གནས། །ཤ་ཟ་པི་ལུ་ཞེས་བྱ་བའི། །སྔགས་ཀྱང་དེས་ནི་བསྒྲུབས་པ་ཡིན། །དེ་ཡི་སྔགས་ཀྱི་མཐུ་ཡིས་ནི། །ལོངས་སྤྱོད་ཆེན་པོ་ཡོད་པར་འགྱུར། །རྒྱ་ཡི་གཙོ་བོ་ཞེས་བྱ་བ། །འཇིག་རྟེན་འདིར་ནི་འབྱུང་བར་འགྱུར། །དེ་ནོར་ཐོབ་པས་བློན་པོར་འགྱུར། །འཇིག་རྟེན་རྒྱལ་པོ་ཉིད་དུའང་འགྱུར། །དེ་ཡི་དུས་སུ་འབྱུང་བ་ནི། །"],["ན 323b","བྲམ་ཟེ་ཚད་མ་ཤེས་པའོ། །ལོག་པའི་ང་རྒྱལ་དག་ལ་ཞེན། །མ་ག་དྷཱ་ཡི་གྲོང་ཁྱེར་གནས། །ལོག་པའི་ང་རྒྱལ་གྱིས་དྲེགས་རྣམས། །འབྱུང་བ་ཉིད་དུ་ཐེ་ཚོམ་མ་མེད། །དེ་དག་གིས་ནི་རྒྱལ་པོ་བསྐོར། །དེ་དག་ལ་ནི་དེས་ནོར་བྱིན། །ནོར་ནི་མང་པོ་དེ་དག་གིས། །དགེ་བའི་བཤེས་ལ་རབ་མཆོད་ནས། །དེ་ཡི་ནོར་ནི་ཟད་པར་བྱེད། །མ་འདྲེས་དེ་ལ་གོམས་པ་དང་། །སྦྱིན་ལ་ཞུམ་མེད་རྒྱུ་ཡིས་ནི། །བློ་ལྡན་དེ་ཡི་ལྷ་ཁང་ནི། །ཉི་ཤུ་རྩ་བཞི་བྱེད་དུ་བཅུག །གྲོང་ཁྱེར་མེ་ཏོག་ཅེས་བྱ་བར། །བདག་ཉིད་ཆེན་པོ་བློན་པོའི་གཙོ། །བྲམ་ཟེ་བཟང་པོ་སྙིང་རྗེར་ལྡན། །དེ་ཡི་ཚེ་ན་འབྱུང་བར་འགྱུར། །རྒྱལ་པོ་དང་ནི་རབ་མཛའ་བའི། །ཆོས་ཀྱི་བདག་ཉིད་འབྱུང་བར་འགྱུར། །གནོད་སྦྱིན་མ་ནི་དཔའ་མོ་ལྡན། །ས་སྟེང་དེ་ཡི་སྔགས་ཀྱང་འགྲུབ། །དེས་ཀྱང་ས་སྟེང་དག་ཏུ་ནི། །མཆོད་རྟེན་བཟང་པོ་བྱེད་དུ་བཅུག །གནོད་སྦྱིན་མ་ཡི་མཐུ་ཡིས་ནི། །ཤེས་རབ་རབ་ཏུ་ཆེ་བར་འགྱུར། །དེ་ཡི་བག་ཆགས་ལས་ཀྱིས་ནི། །སྔོན་གྱི་བག་ཆགས་ཡོང་བསྐུལ་ནས། །བློ་དང་ལྡན་པས་མཐར་གྱིས་ནི། །རྙེད་པར་དཀའ་བའི་བྱང་ཆུབ་འཐོབ། །མཆོག་སྲེད་ཅེས་ནི་རྣམ་གྲགས་པའི། །དེ་ཚེ་འདོད་ཆགས་ཤས་ཆེ་འབྱུང་། །བུད་མེད་བྱས་པའི་སྐྱོན་གྱིས་ནི། །བྲམ་ཟེའི་ཁྱེ་འུས་འཆི་བ་ཐོབ། །དཔལ་ལྡན་རྒྱལ་པོ་དགའ་བོ་ཡང་། །སྔ་མའི་ལས་ཀྱི་ཉེས་པ་ཡིས། །མེ་ཏོག་ཅེས་བྱའི་གྲོང་ཁྱེར་གྱི། །མི་རྣམས་འཆད་པས་གནོད་པར་བྱེད། །བློན་པོའི་ཚོགས་ཀྱང་མ་དད་གྱུར། །སྟོབས་ཆེན་བདེན་པར་སྨྲ་བ་ཡང་། །སྔོན་གྱི་ལས་ཀྱི་ཉེས་པ་ཡིས། །ནད་ཆེན་དག་གིས་ཐེབས་འགྱུར་ཏེ། །རིམས་ནད་ཆེན་པོས་སྡུག་བསྔལ་གདུང་། །ནམ་ཕྱེད་ཙམ་ན་ཤི་བར་འགྱུར། །རྒྱལ་པོ་དེ་ཡི་ཚེ་ཚད་ནི། །དེ་བཞིན་ལྔ་བཅུ་རྩ་དྲུག་གོ །དེ་ནི་ཉན་ཐོས་བྱང་ཆུབ་ཏུ། །རྒྱལ་པོ་ངེས་པར་འགྱུར་བ་ཡིན། །དེ་ཡི་གྲོགས་པོ་གཞན་གྱུར་པ། །བྲམ་ཟེའི་ཁྱེའུ་པ་ཎི་ནི། །ངེས་པར་ཉན་ཐོས་བྱང་ཆུབ་ཏུ། །ང་ཡིས་ལུང་བསྟན་བྱས་པ་ཡིན། །འཇིག་རྟེན་དབང་ཕྱུག་བདག་ཉིད་ཆེ། །དེ་ཡང་དེ་ཡི་སྔགས་གྲུབ་པའོ། །བྲམ་ཟེ་ཤེས་རབ་འདོད་པས་"],["ན 324a","ཀྱང་། །ཁྲོ་བོ་ཧ་ལ་ཧ་ལ་བསྒྲུབས། །རྒྱལ་པོ་དེ་ལས་གཞན་པ་ཡང་། །ཟླ་བ་སྦས་ཞེས་བྱ་བ་འབྱུང་། །གནོད་སྦྱིན་ཆུ་དབང་གྲུབ་པ་སྟེ། །རྒྱལ་སྲིད་གནོད་པ་མེད་པར་བྱེད། །ལོངས་སྤྱོད་ཆེ་ཞིང་བདེན་པར་སྨྲ། །ཆོས་ཀྱི་བདག་ཉིད་ས་ཡི་བདག །མི་དགེའི་བཤེས་གཉེན་རབ་བརྟེན་ནས། །སྲོག་ཆགས་མང་པོ་གསོད་པར་བྱེད། །ལས་ཀྱི་རྣམ་སྨིན་དེ་ཡིས་ནི། །འབྲུམ་བུའི་ནད་འབྱུང་རབ་ཏུ་བརྒྱལ། །དེ་ནི་མཚན་ཕྱེད་སད་ནས་ནི། །རྒྱལ་སྲིད་ལ་ནི་བུ་བཞག་པ། །སྙིང་པོ་ཐིག་ལེ་ཞེས་བྱ་བ། །བློན་པོ་ལ་སྡང་བྱིས་པ་དེ། །དེ་ནས་ཟླ་བ་སྦས་པ་དེ། །ཤི་འཕོས་ས་སྟེང་དུས་ལས་འདས། །མི་ཡི་འགྲོ་བ་སྤངས་པ་ཡི། །དེ་ཚེ་ཡི་དགས་འཇིག་རྟེན་སོང་། །འགྲོ་བ་ལས་གྲོལ་སྔགས་གོམས་པས། །དེ་ནས་ལྷ་ཡི་གནས་སུ་སོང་། །དགེ་བའི་སེམས་ཀྱིས་དམིགས་ནས་ནི། །སྔགས་ཀྱི་རྒྱུས་ནི་ཡང་དག་བསྐྱེད། །རྒྱལ་པོ་དེས་ནི་མཐར་གྱིས་ཀྱང་། །ཉན་ཐོས་ཀྱི་ནི་བྱང་ཆུབ་འགྲོ། །སྙིང་པོ་ཐིག་ལེ་རྒྱལ་པོ་ཡིས། །བྱིས་པ་མི་གསལ་བློ་ཡིས་ནི། །བྱེ་མ་ལས་བྱས་སྲིད་གཞན་དུ། །སྔོན་ནི་མཆོད་རྟེན་དག་ཀྱང་བྱས། །དེ་ཡི་རྣམ་སྨིན་མཐུ་ཡིས་ནི། །མ་སྨད་ལྷ་ཡི་གནས་སུ་སོང་། །སྐྱེ་བ་སྟོང་ཕྲག་ལྔ་བརྒྱར་ནི། །ལྷ་ཡི་ནང་དུ་བདེ་བ་མྱོང་། །མཐོ་རིས་འཇིག་རྟེན་ཤི་འཕོས་ནས། །མི་ཡི་ནང་དུ་རབ་སྐྱེས་པ། །བློ་ལྡན་ཟླ་བ་སྦས་པ་ཡི། །རྒྱལ་པོ་དགའ་བའི་རིགས་སུ་སྐྱེས། །བྱིས་པ་ཉིད་ནས་རྒྱལ་པོར་འགྱུར། །ཡུན་མི་ཐུང་བར་བདེ་བ་མྱོང་། འཇིགས་མེད་བསྟན་དང་ཡང་དག་རིག །སྤྱི་བརྩན་པ་དང་སྙན་པར་སྨྲ། །དེ་ཉིད་རང་དབང་རྒྱལ་སྲིད་ནི། །ལོ་ནི་བདུན་ཅུར་ཡོངས་སུ་བྱས། །སྐྲ་ཅན་ཞེས་བྱའི་སྔགས་དག་ཀྱང་། །རྒྱལ་པོ་དེ་ལ་རབ་ཏུ་གྲུབ། །ཁྱོད་ཉིད་ཀྱི་ནི་སྔགས་ཉིད་ཀྱང་། །དེ་ཚེ་གྲུབ་པར་བྱེད་པར་འགྱུར། །ཁྱོད་ཉིད་ཀྱིས་བཤད་སྔགས་དག་ཀྱང་། །དེ་ཡི་ཚེ་ན་གྲུབ་པར་འགྱུར། །བྱིས་པའི་ཚུལ་ཅན་སྣ་ཚོགས་གཟུགས། །བྱིས་པ་རྣམས་ལ་མཐུ་དང་ལྡན། །སྔགས་ཀྱི་གཟུགས་ཀྱིས་ལུས་ཅན་ལ། །ཐེ་ཚོམ་མེད་པར་འབྱུང་བར་འགྱུར། །སེམས་ཅན་རྣམས་ལ་ཕན་འདོད་"],["ན 324b","པས། །གང་ཞིག་ཁྱོད་ཀྱིས་བསྟན་པའི་སྔགས། །དེ་ཚེ་དེ་ཡི་དུས་དག་ཏུ། །བརྗོད་པ་ཙམ་གྱིས་འགྲུབ་པར་འགྱུར། །བློ་ལྡན་སྙིང་པོ་ཐིག་ལེ་ཡི། །རྒྱལ་པོ་དེ་ཡི་བློན་པོ་ནི། །ཙ་ནག་ཀྱ་ཞེས་རྣམ་བསྒྲགས་པ། །བྲམ་ཟེའི་ཁྱེ་འུས་ཁྲོ་བོ་འགྲུབ། །གཤིན་རྗེ་གཤེད་ཅེས་བྱ་བ་ནི། །བློ་ངན་དེས་ནི་དེ་ཡང་འགྲུབ། །དེས་ནི་ཁྲོ་བས་ཟིལ་ནོན་ནས། །སྲོག་ཆགས་དག་གི་འཚོ་བ་བཅད། །དེ་ཚེ་རྒྱལ་པོ་གསུམ་གྱི་བར། །ཤིན་ཏུ་མི་བཟད་སྡིག་པ་བྱས། །དེ་ནི་དུས་རིང་འཚོ་བ་ཡི། །བྲམ་ཟེ་ངན་པ་འབྱུང་བར་འགྱུར། །དེ་ཡི་སྔགས་ཀྱི་མཐུ་ཡིས་ནི། །ལུས་དེས་ལྷ་མིན་བརྟེན་པར་བྱེད། །ལྷ་མིན་ལུས་ལ་ཞུགས་ནས་ནི། །དེ་ནི་དུས་རིང་འཚོ་བར་བྱེད། །དེ་ནས་ལུས་དེ་ཞིག་ནས་ཀྱང་། །མནར་མེད་དམྱལ་བར་ཡང་དག་འགྲོ། །དེ་ནས་དམྱལ་བའི་སྡུག་བསྔལ་དེ། །བློ་ངན་དེས་ནི་རྗེས་སུ་མྱོང་། །དམྱལ་བའི་སྡུག་བསྔལ་སྣ་ཚོགས་པ། །མི་འདོད་དེ་ཚེ་ལས་ལས་བྱུང་། །ལས་གཅིག་སྡུག་བསྔལ་དེས་ཟད་ནས། །ཁྲོ་བོའི་སྔགས་ཀྱིས་རབ་བསྐུལ་ཏེ། །དམྱལ་བ་ལས་ནི་དེ་འཆི་འཕོས། །དུད་འགྲོ་དག་ཏུ་ཉེ་བར་སྐྱེས། །ཀླུ་ཡི་སྐྱེ་གནས་བརྟེན་ནས་ནི། །འཇིགས་པའི་གཟུགས་ཅན་དག་ཏུ་འགྱུར། །ཁྲོ་ལྡན་ཆེན་པོ་ཀླུ་ཡི་རྒྱལ། །གདེངས་ཅན་དུག་གིས་དྲེགས་བྱེད་དང་། །མི་བཟད་ལས་ནི་རབ་བྱེད་པས། །མ་རུངས་ལས་ལས་དེ་འཆི་འཕོས། །རྫུ་འཕྲུལ་ཆེན་པོ་ཡི་དགས་ཀྱི། །གཤིན་རྗེའི་རྒྱལ་པོར་རབ་ཏུ་འགྱུར། །དེ་ལྟར་སྡུག་བསྔལ་སྟོང་ཕྲག་ནི། །ཡང་དང་ཡང་དུ་རྗེས་སུ་མྱོང་། །བློ་ངན་དེ་ནི་མཐར་གྱིས་སུ། །བྲམ་ཟེའི་ཁྱེའུར་ས་སྟེང་འོང་འོངས། །མི་ཡི་སྐྱེ་བར་འོངས་ནས་ནི། །འཇིགས་པ་ཡི་ནི་གཟུགས་ཅན་འགྱུར། །ཁྲོ་བ་དང་ནི་དབུལ་བ་ཉིད། །གྲགས་པ་ཆུང་བ་ཉིད་དུ་འགྱུར། །གང་ཡང་འཇིག་རྟེན་རང་སངས་རྒྱས། །འདོད་མེད་བསེ་རུ་ལྟ་བུར་སྤྱོད། །དམན་པ་ལ་ནི་རྗེས་བརྩེ་བ། །ས་ཡི་སྟེང་ན་རྣམ་པར་རྒྱུ། །སེམས་ཅན་རྣམས་ལ་ཕན་འདོད་ཕྱིར། །བསོད་སྙོམས་སྤྱོད་ལ་རབ་ཏུ་ཞུགས། །དེ་ཚེ་གཞན་སེམས་རིག་"],["ན 325a","པ་དེས། །བློ་ངན་དེ་ནི་རབ་ཏུ་མཐོང་། །སྙིང་རྗེས་ཡིན་གྱིས་གཞན་མིན་དེས། །དེ་ཡི་ཐད་དུ་བྱོན་པར་འགྱུར། །དེས་ནི་ཟན་དྲོན་གསོལ་ཆེད་དུ། །བསེ་རུ་ལྟ་བུ་ལ་ནི་ཁྱེར། །དེས་ནི་སྔགས་ལ་རབ་བརྙས་ནས། །དེ་ཚེ་རྒྱུ་ནི་ཡང་དག་བསྟན། །དེ་ལས་གཅིག་གི་བདག་ཉིད་ལ། །བསོད་སྙོམས་དེ་ནི་ཡང་དག་བསྟབས། །ཀྱེ་འདི་རབ་བྱུང་མ་ལུས་པ། །ཇི་ལྟར་བདེ་བ་བཞིན་དུ་གསོལ། །དེ་ལ་རྗེས་བརྩེ་རང་སངས་རྒྱས། །དེ་ཚེ་རྫུ་འཕྲུལ་བསྟན་པར་འགྱུར། །དེ་ཡི་མཐུ་ཡིས་ཡིད་བསྐྱོད་ནས། །དེ་ནས་ངོ་མཚར་རབ་སྐྱེས་ཏེ། །སངས་རྒྱས་བསེ་རུ་ལྟ་བུ་ལ། །སྤྱི་བོས་ཀུན་ལ་རབ་ཏུ་བཏུད། །ཇི་ལྟར་འདོད་པར་ཉེས་བྲལ་རྣམས། །དགེ་བའི་རྩ་བ་དེ་ཡི་མཐུས། །རང་རྒྱལ་བྱང་ཆུབ་སྨོན་ལམ་བཏབ། །བདག་ཉིད་ཆེན་པོ་ཅི་འདྲ་བ། །རྫུ་འཕྲུལ་ཆེན་པོ་ཞི་བའི་གཟུགས། །སྡུག་བསྔལ་བློ་ངན་མི་འགྱུར་བར། །དེ་འདྲ་བདག་ནི་འཇིག་རྟེན་ཤོག །ལས་ཀྱི་ལྷག་མ་ཟད་པ་དང་། །འཆི་འཕོས་དེ་ཚེ་མཐོ་རིས་སོང་། །ཆོས་ཀྱི་བདག་ཉིད་དེ་མཐར་གྱིས། །ཉན་ཐོས་དེ་ནི་བྱང་ཆུབ་ཐོབ། །དེ་བས་སྔགས་ཀྱི་སྒྲུབ་པ་ནི། །མངོན་སྤྱོད་དག་ནི་ཡོང་མི་བྱ། །སངས་རྒྱས་བྱང་ཆུབ་སེམས་དཔའ་ཡིས། །མངོན་སྤྱོད་རབ་ཏུ་བཀག་པ་ཡིན། །སྙིང་རྗེ་མཆོག་ལྡན་སངས་རྒྱས་དང་། །བྱང་ཆུབ་སེམས་དཔའ་རྫུ་འཕྲུལ་ཆེ། །སྔགས་རྣམས་མཐུ་བསྟན་དོན་དུ་ནི། །ལས་རྣམས་ཐམས་ཅད་བསྟན་པ་ཡིན། །དེ་བཞིན་ནོར་བུ་ལྟ་བུའི་སྔགས། །གང་ཞིག་དེ་བཞིན་གཤེགས་པས་གསུངས། །ཁྲོ་དང་ཆགས་པས་ཟིལ་མནན་པའི། །བྱིས་པ་རྨོངས་པའི་སེམས་དག་གིས། །དེ་དག་སྔགས་ནི་མངོན་སྤྱོད་ལ། །ཕན་ཚུན་རབ་ཏུ་སྦྱོར་བར་བྱེད། །སངས་རྒྱས་བྱང་ཆུབ་སེམས་དཔའ་ནི། །བློ་དང་ལྡན་པས་དེ་བཞིན་བཀག །རྣམ་པ་ཐམས་ཅད་སྔགས་རྣམས་ནི། །སེམས་ཅན་ལོངས་སྤྱོད་འཕེལ་བ་དང་། །དེ་ནས་རྒྱལ་པོ་དམ་པ་དང་། །སྲུང་བ་ཆེ་དང་དབང་ཕྱིར་དང་། །སྐྱེ་གནས་སྣ་ཚོགས་ལ་གནས་པའི། །སེམས་ཅན་རྣམས་ནི་དགུག་དོན་དུ། །སྔགས་ཀྱང་བསྒྲུབ་པར་བྱ་བ་སྟེ། །འཚོ་བ་དགག་ཕྱིར་མ་ཡིན་ནོ། །དགེ་སློང་"],["ན 325b","མང་དུ་ཐོས་པ་ནི། །དེ་ཡི་ཚེ་ན་འབྱུང་འགྱུར་བ། །མ་ཁོལ་ཞེས་ཀྱང་བྱ་བ་སྟེ། །ང་ཉིད་ཀྱི་ནི་སྟོད་བྱེད་པ། །ཇི་བཞིན་ཡོན་ཏན་བཟང་པོ་ནི། །ཇི་ལྟ་བཞིན་དུ་བརྗོད་པར་འགྱུར། །ཀུན་ནས་སེམས་ནི་རབ་དང་ཞིང་། །སངས་རྒྱས་རྣམས་ཀྱི་བསྟན་ལ་དད། །སྒྲུབ་དཀའི་སྔགས་ནི་རབ་བསྒྲུབ་ཅིང་། །འཇམ་པའི་དབྱངས་ཀྱི་དེ་བཞིན་ནོ། །ཡོན་ཏན་ལྡན་ཞིང་ཚུལ་ཁྲིམས་ལྡན། །མང་དུ་ཐོས་ཤིང་ཆོས་ཀྱང་སྨྲ། །དུད་འགྲོར་སྔོན་ནི་གྱུར་པ་ན། །ང་ཡི་བསྟོད་པ་ཡོངས་སུ་སྨྲ། །ཉམས་དགའ་གྲོང་ཁྱེར་རྒྱལ་པོའི་ཁབ། །འོད་མའི་ཚལ་གྱི་ས་སྟེང་དུ། །སློབ་མའི་ཚོགས་དང་ལྷན་ཅིག་ཏུ། །ཇི་ལྟར་བདེ་བར་བཞུགས་པ་ན། །དེར་ནི་བྱ་རོག་ཅིག་ཡོད་པས། །ང་ལ་སེམས་ནི་རབ་དད་བྱས། །སེམས་ནི་ང་ལ་དད་བྱས་པས། །ལུས་ཞིག་ནས་ནི་མཐོ་རིས་སོང་། །ལྷ་རྣམས་ལས་ནི་ཤི་འཕོས་ནས། །མི་རྣམས་ནང་དུ་ཉེ་བར་སྐྱེས། །མི་ཡི་ནང་དུ་སྐྱེས་ནས་ཀྱང་། །ང་ཡི་བསྟན་ལ་རབ་ཏུ་འབྱུང་། །རབ་བྱུང་བདག་ཉིད་ཆེན་པོ་དེ། །ཇི་བཞིན་དེ་ཚེ་འབྱུང་བར་འགྱུར། །མ་ཁོལ་ཞེས་བྱའི་བརྟུལ་ཞུགས་ཅན། །དེ་ནི་དེ་ཚེ་འབྱུང་བར་འགྱུར། །ཇི་བཞིན་དོན་ནི་བསྟོད་པས་མཆོད། །རྣམ་པ་སྣ་ཚོགས་དཔེ་དག་གིས། །འབྱུང་པོ་ཀུན་ལ་ཕན་པའི་ཕྱིར། །ལེགས་པར་སྤྱོད་པ་རབ་བྱེད་པའོ། །སེམས་ཅན་རྗེས་སུ་གཟུང་བའི་ཕྱིར། །བསྟོད་པ་བརྗོད་པ་དེ་གཙོར་བྱེད། །དུས་མཐའི་འཇིག་རྟེན་སྨད་པ་ལ། །དེ་ཡི་ཚེ་ན་འབྱུང་བར་འགྱུར། །རྣམ་པར་སྨིན་པ་དེ་ཡིས་ནི། །ལུས་ཞིག་ནས་ནི་བདེ་འགྲོར་འགྲོ། །བློ་ལྡན་དེ་ནི་མཐར་གྱིས་ཀྱང་། །རྣམ་པ་སྣ་ཚོགས་བདེ་མྱོང་ནས། །བསམ་གྱིས་མི་ཁྱབ་མཆོག་གསུངས་པའི། །ཐམས་ཅད་མཁྱེན་པའི་བྱང་ཆུབ་ཐོབ། །དེ་བཞིན་གཤེགས་པ་ང་འདས་ནས། །ལོ་ནི་བཞི་བརྒྱ་ལོན་པ་ན། །དགེ་སློང་ཀླུ་ཞེས་དེ་འབོད་འབྱུང་། །བསྟན་པ་ལ་ནི་དད་ཅིང་ཕན། །རབ་ཏུ་དགའ་བའི་ས་ཐོབ་པ། །ལོ་ནི་དྲུག་བརྒྱ་དག་ཏུ་འཚོ། །རིག་པ་རྨ་བྱ་ཆེན་མོ་ནི། །བདག་ཉིད་ཆེན་པོ་དེས་ཀྱང་གྲུབ། །བསྟན་བཅོས་སྣ་ཚོགས་དོན་དང་ནི། །དངོས་པོ་མེད་པའི་དོན་"],["ན 326a","དེ་རིགས། །གང་ཚེ་ལུས་དེ་བོར་བ་ན། །བདེ་བ་ཅན་དུའང་སྐྱེ་བར་འགྱུར། །དེ་ནས་མཐར་གྱིས་སངས་རྒྱས་ཉིད། །ངེས་པ་ཁོ་ནར་ཡང་དག་འཐོབ། །ཐོགས་མེད་ཅེས་བྱའི་དགེ་སློང་ནི། །བསྟན་བཅོས་དེ་ནི་དོན་ལ་མཁས། །མདོ་སྡེ་དེས་དོན་དྲང་བའི་དོན། །རྣམ་པ་མང་པོའང་རབ་ཏུ་འབྱེད། །འཇིག་རྟེན་རིག་པ་སྟོན་བདག་ཉིད། །གཞུང་བྱེད་ངང་ཚུལ་ཅན་དུ་འགྱུར། །དེ་ཡི་རིག་པ་གྲུབ་པ་འདི། །སཱ་ལའི་ཕོ་ཉ་མོ་ཞེས་རྗོད། །དེ་ཡི་སྔགས་ཀྱི་མཐུ་ཡིས་ནི། །བློ་ནི་བཟང་པོ་སྐྱེ་བར་འགྱུར། །བསྟན་པ་ཡུན་རིང་གནས་པའི་ཕྱིར། །མདོ་ཡི་དེ་ཉིད་དོན་སྡུད་བྱེད། །ལོ་ནི་བརྒྱ་དང་ལྔ་བཅུར་འཚོ། །དེ་ལུས་ཞིག་ནས་ལྷ་ཡུལ་འགྲོ། །འཁོར་བ་རྣམས་སུ་འཁོར་བ་ན། །ཡུན་རིང་བདེ་བ་རྗེས་མྱོང་ནས། །བདག་ཉིད་ཆེན་པོ་མཐར་གྱིས་དེ། །བྱང་ཆུབ་ཐོབ་པར་འགྱུར་བ་ཡིན། །དེ་ལྟར་རྣམ་པ་མང་པོ་ཡི། །ང་ཡི་བསྟན་ལ་དགེ་སློང་རྣམས། །ཤེས་རབ་ལྡན་ཉིད་ཆོས་ཀྱང་སྤྱོད། །དུས་ཀྱི་མཐའ་ལ་དེ་ཚེ་འབྱུང་། །ཕྱི་མ་དེ་ཚེ་དུས་དག་ཏུ། །དགེ་སློང་དགྲ་བཅོམ་ཞེས་བྱ་བ། །དེ་ནི་སྔགས་དོན་བདག་ཉིད་ལྡན། །རྒྱུད་ཤེས་དེ་བཞིན་མང་དུ་ཐོས། །གནོད་སྦྱིན་སྔགས་ནི་རབ་བརྗོད་པས། །དེ་ལ་བུམ་པ་བཟང་པོ་འགྲུབ། །སྔོན་ནི་ངས་ནི་གང་བཤད་པའི། །ཐེག་པ་ཆེན་པོའི་མདོ་སྡེ་ཡང་། །དེ་ཡི་ཚེ་ན་བུམ་པ་ལས། །དཀའ་ཐུབ་ཆེན་པོ་འདྲེན་པར་བྱེད། །གླེགས་བམ་དེ་ལ་དེས་བལྟས་ནས། །དེ་ལ་སྔགས་ནི་ཟློས་པ་ན། །གནོད་སྦྱིན་བསྒྲུབ་པའི་བུམ་པ་ལ། །དེར་ནི་བསྲུང་བ་མ་བྱས་པའི། །བག་མེད་དྲན་པ་ཉམས་པ་ཡིས། །གཙུག་སྤྱོད་ཀྱིས་ནི་བུམ་པ་ཕྲོགས། །དེ་ནི་དེ་ནས་སྔགས་གྲུབ་པའི། །དགེ་སློང་སྔགས་ནི་ཟློས་བྱེད་པའི། །བུམ་པ་དག་ནི་བལྟས་པ་ན། །དེར་ནི་མངོན་པར་མཐོང་མ་གྱུར། །དེ་ནས་ཁྲོ་བས་མིག་དམར་ཞིང་། །རྣམ་གཡོ་ཚིག་ཏུ་སྨྲ་བ་ནི། །ཚངས་པ་དཀའ་བའི་མཐར་གྱུར་པར། །བརྒྱ་བྱིན་སོགས་བཅས་དབང་ཕྱུག་ཆེ། །སྔགས་ཀྱིས་མ་བཀུག་མ་འོངས་ན། །སྔགས་པ་བདག་མིན་སྔགས་རྒྱལ་མིན། །གང་ཞིག་སངས་རྒྱས་སྲས་སྔགས་དང་། །རྒྱལ་བ་མཆོག་གིས་"],["ན 326b","སྔགས་དག་ནི། །ཚར་གཅོད་དོན་དུ་གང་གསུངས་པའམ། །གདུལ་དཀའ་འདུལ་བར་བྱེད་པའང་རུང་། །གལ་ཏེ་ཀུན་རྣམས་མ་བཀུག་ན། །ས་སྟེང་མ་ལུས་དེ་དག་མེད། །དེ་ནས་སྔགས་པ་ཆེན་པོ་ལངས། །བརྟུལ་ཞུགས་བརྟན་ཞིང་ལས་རྣམས་གྲུབ། །ཇི་ལྟར་སྔགས་ནི་བྱས་པ་ཡི། །སྦྱོར་བ་མཐོང་བས་རྒྱུད་དག་ཀྱང་། །རྐུན་མ་དགུག་པ་དེ་དོན་གཙོར། །སྦྱོར་བ་རབ་ཏུ་བྱས་པར་གྱུར། །སྐད་ཅིག་དྲན་པ་ཙམ་གྱིས་ནི། །སྡོམ་བརྩོན་དེ་ནི་ལས་མྱུར་བྱེད། །ཡི་གེ་ཧཱུྃ་གི་སྔགས་གཅིག་གིས། །ཚངས་སོགས་ས་ས་སྟེང་འདྲེན་པར་བྱེད། །ལྷ་རྣམས་མ་ལུས་རབ་བཀུག་པ། །ཚངས་སོགས་བརྒྱ་བྱིན་དང་ཡང་བཅས། །ཧ་ཧ་ཞེས་བྱའི་སྒྲ་འདོན་ཅིང་། །ཉམ་ཐག་འཇིགས་པའི་སྒྲ་ཡང་སྒྲོགས། །ཅི་བགྱི་ཞེས་བྱའི་བློ་བྱེད་ཅིང་། །བདག་ཅག་འདིར་ནི་ཉེས་མེད་སྨྲ། །མྱུར་ཞིང་རབ་ཏུ་རིངས་པར་ཡངས། །བློ་ལྡན་དགེ་སློང་འཇིགས་མེད་པས། །ལྷ་རྣམས་ལ་ནི་རབ་སྨྲས་པ། །འདིར་ནི་བུམ་པ་སླར་བྱིན་ཞེས། །ལྷ་རྣམས་ཕན་ཚུན་ཐམས་ཅད་ལ། །དགེ་སློང་དེས་ནི་རབ་ཏུ་སྨྲས། །གང་གིས་བུམ་པ་བཟང་པོ་ཁྱེར། །ཁྱོད་ཀྱིས་མྱུར་དུ་རབ་ཏུ་སྨྲོས། །ལྷ་རྣམས་ཀུན་གྱིས་བལྟས་པ་ན། །ཀུན་ཏུ་ཡང་ནི་མ་མཐོང་གྱུར། །བུམ་པ་འདི་ནི་སུ་ཡིས་ཁྱེར། །ལྷ་ཡི་དབང་པོས་ཡང་དག་དགོངས། །བྱང་ཆུབ་སེམས་དཔའ་འོད་ཆེན་པོ། །དཔལ་ལྡན་ལག་ན་རྡོ་རྗེ་ཅན། །དེ་ཡི་བུ་ནི་མི་བཟད་ཡོད། །ཁྲོ་བ་ཆེ་ཞིང་ཤིན་ཏུ་གདུག །བགེགས་ཀྱི་གཟུགས་ཀྱིས་སྔགས་པ་ལ། །འགྲོ་བ་ཀུན་ལ་རྣམ་པར་རྒྱུ། །བུམ་པ་དེ་ནི་དེས་ཁྱེར་མཐོང་། །ལྷ་ཡི་བདག་པོས་དེ་ཡང་སྨྲས། །རྡོ་རྗེའི་རིགས་ཀྱི་བགེགས་ཡོད་པ། །ས་སྟེང་རྩེ་ཞིང་རོལ་པར་བྱེད། །འདིས་ནི་བདག་ལ་མ་མཆོད་པས། །དེས་ནི་བུམ་པ་དེ་འདིར་ཁྱེར། །ལྷ་ཡི་བདག་པོས་དེ་སྨྲས་ནས། །ཕྱིར་ཡང་ལྷ་ཡི་གནས་སུ་སོང་། །དེ་ཚེ་རང་ཉིད་སྔགས་ཀྱིས་ནི། །ལྷ་རྣམས་མ་ལུས་སླར་གཤེགས་གས་གསོལ། །སྐད་ཅིག་ཡུད་ཙམ་ཉིད་ཀྱིས་ནི། །ཤིན་ཏུ་ལེགས་པར་ཡང་དག་བཀུག །དེ་ཚེ་དབང་མེད་བུམ་པར་བཅས། །བགེགས་དེ་ཉིད་དང་བཅས་པར་འོངས། །དེ་ནས་"],["ན 327a","དེ་ནི་བགེགས་དེ་ཡིས། །ཡི་དགས་རྣམས་ལ་བུམ་པ་བྱིན། །དེ་ནས་དེ་ཡི་བགེགས་དེས་ནི། །ཚིག་འདི་དག་ནི་རབ་ཏུ་སྨྲས། །ཡི་དགས་འཇིག་རྟེན་བུམ་པ་ཁྱེར། །ང་ནི་དེ་ལ་དགའ་བ་མེད། །སྔགས་པ་དེས་ནི་དཀའ་བ་དང་། །དཀའ་བས་བཏུད་དེ་བགེགས་ལ་སྨྲས། །སོང་ཤིག་སོང་ཤིག་བགེགས་ཆེན་པོ། །ཕྱིན་ཅད་འདི་ལྟར་མ་བྱེད་ཅིག །དེ་ནས་དེས་ནི་ཡི་དགས་དག །དེ་ཡི་མོད་ལ་བཀུག་པར་གྱུར། །ལྟོགས་ཤིང་ངལ་བའི་སེམས་དང་ནི། །དམན་ཞིང་དེ་དག་ཁབ་ཙམ་ཁ། །ཤིན་ཏུ་མི་བཟད་ཆེན་པོ་དེ། །ཉམ་ཐག་སྐད་ཀྱང་རབ་ཏུ་འདོན། །སྙིང་རྗེའི་ཚིག་ཏུ་སྨྲ་བ་ནི། །བདག་ཉིད་ཆེན་པོ་ཡོངས་སུ་སྐྱོ་བས། །ཁྱོད་ཀྱི་བུམ་པ་འདིར་འོངས་ཀྱིས། །ཇི་ལྟར་འདོད་བཞིན་བདག་ལ་བྱོས། །སྔགས་པ་སྙིང་རྗེ་ཆེར་ལྡན་པས། །ཡང་དག་འདར་བ་རབ་ཏུ་སྐྱེས། །སྙིང་རྗེས་བརླན་པའི་སེམས་ཀྱིས་ནི། །ཚིག་ནི་འདི་དག་རབ་ཏུ་སྨྲས། །ཁྱོད་ཀྱི་འཇིག་རྟེན་སྡུག་བསྔལ་ཅི། །ཡུན་མི་རིང་པར་རབ་ཏུ་སྨོན། །དམན་པའི་ཡིད་ཀྱིས་དེ་སྨྲས་པ། །བཀྲེས་པས་ཡང་དག་གདུངས་པར་གྱུར། །ཡི་དགས་འཇིག་རྟེན་སྐོམ་པ་ཡིས། །བདག་ཉིད་ཆེན་པོ་ཡིན་ཡང་རུང་། །དགེ་སློང་སྙིང་རྗེ་ཆེན་པོས་ནི། །དེ་དག་ལ་ནི་བུམ་པ་བྱིན། །དེ་ནས་དེ་དག་ཡིད་དགའ་ནས། །མྱུར་བར་རང་གི་གནས་སུ་སོང་། །དེ་དག་བསམ་པ་ཙམ་གྱིས་ནི། །བུམ་པ་ལས་ནི་བཟའ་བཏུང་བྱུང་། །དགེ་སློང་དགའ་བོའི་འོག་ཏུ་ནི། །ཙནྡན་སྐྱོང་ནི་འབྱུང་བར་འགྱུར། །དེ་ཚེ་དུས་ནི་ཐ་མ་ལ། །ལོ་ནི་སུམ་བརྒྱ་དག་ཏུ་འཚོ། །བདག་ཉིད་ཆེན་པོ་བྱང་ཆུབ་ནི། །བགེགས་མེད་མྱུར་དུ་རྙེད་དཀའ་ཐོབ། །རྒྱལ་པོ་བཙུན་པ་ཞེས་བྱ་བ། །ང་ཡི་བསྟན་པ་ནུབ་བྱེད་པ། །དུས་ཀྱི་ཐ་མ་དེ་ཡི་ཚེ། །ཐེ་ཚོམ་མེད་པར་འབྱུང་བར་འགྱུར། །ཤར་ཕྱོགས་ནས་ནི་བརྩམས་ནས་སུ། །ཁ་ཆེའི་ཡུལ་གྱི་བར་དག་ཏུ། །རྨོངས་པས་ལྷ་ཁང་མཆོད་རྟེན་རྣམས། །དེ་ཚེ་དེ་བཞིན་འཇིག་པར་འགྱུར། །དགེ་སློང་ཚུལ་ཁྲིམས་ལྡན་པ་རྣམས། །བློ་ངན་དེས་ནི་གསོད་པར་བྱེད། །བྱང་གི་ཕྱོགས་"],["ན 327b","སུ་བརྟེན་ནས་ནི། །དེ་ནི་འཆི་བར་འགྱུར་བ་ཡིན། །མི་མ་ཡིན་པ་ཉིད་འཁྲུགས་ནས། །ཡུལ་འཁོར་ཕྱུགས་དང་གཉེན་རྣམས་དང་། །རི་ཡི་དུམ་བུས་བཅོམ་པར་འགྱུར། །བློ་ངན་དེ་ནི་ས་འོག་འགྲོ། །དེ་ནི་འོག་ནས་འོག་ཏུ་འགྲོ། །དམྱལ་ལས་དམྱལ་བ་རབ་དྲག་པར། །སྡུག་བསྔལ་སྡུག་བསྔལ་དྲག་པར་ནི། །མི་བཟད་པར་ནི་ཡང་དག་ལྟུང་། །མནར་མེད་ཞེས་ནི་བྱ་བ་ཡི། །སྡིག་པའི་ལས་ཀྱིས་དམྱལ་བ་ནི། །དེ་ནས་བསྐལ་བ་ཆེར་འཚེད་པ། །བདག་ཉིད་ངན་པ་གོ་མི་ཤན། །མི་དགེའི་བཤེས་གཉེན་ལ་བརྟེན་ནས། །སྡིག་པ་ཤིན་ཏུ་མི་བཟད་བྱས། །དེ་ནི་ང་ཡི་བསྟན་པ་ལ། །རྣམ་པ་ཀུན་གྱིས་འབད་ནས་ནི། །སེམས་ནི་མ་ལུས་རབ་བཏང་ནས། །ཕུན་སུམ་ཚོགས་དང་དེ་ནས་སྤྱོད། །ངེས་པར་སངས་རྒྱས་ཉིད་ལམ་ནི། །ཡན་ལག་བརྒྱད་ཀྱི་ཐེག་པས་ནི། །དེ་ཚེ་དེ་ནི་རབ་འགྲོ་ཞིང་། །མྱ་ངན་ནད་མེད་དམ་པ་ཐོབ། །དེ་ཡི་འོག་ཏུ་ས་སྲུང་བ། །སངས་རྒྱས་ཕྱོགས་ཞེས་རྣམ་པར་གྲགས། །ཕྱོགས་ཆེ་གཏོང་བ་ཆེ་བ་དང་། །སངས་རྒྱས་རྣམས་ཀྱི་བསྟན་ལ་དད། །དེ་ཚེ་དུས་ཀྱི་ཐ་མ་ལ། །འབྱུང་བར་འགྱུར་བར་ཐེ་ཚོམ་མེད། །ཐམས་ཅད་མངོན་དགའི་རྒྱལ་པོ་སྟེ། །སྟོན་པའི་བསྟན་པ་དེ་གཙོར་བྱེད། །ཀུན་དགའ་ར་བ་མཆོད་རྟེན་གནས། །སྟོན་པའི་གཟུགས་བརྙན་བླ་ན་མེད། །མཚེའུ་རྫིང་དང་ཁྲོན་པ་དང་། །མཚོ་རྣམས་དག་ནི་དུ་མ་དག །རྒྱལ་པོ་ཆེན་པོས་བྱས་ནས་ནི། །ཚེ་ཟད་ལྷ་ཡི་གནས་སུ་སོང་། །དེས་ཀྱང་ས་སྟེང་གྲུབ་པ་ནི། །པདྨ་འཆང་བ་བརྩོན་འགྲུས་ཆེ། །བདག་ཉིད་ཆེན་པོ་སེམས་དཔའ་ལ། །ས་ཡི་བདག་པོར་དོན་དུ་གཉེར། །དེ་ཡི་སྔགས་ཀྱི་མཐུ་ཡིས་ནི། །ལོ་ནི་སུམ་བརྒྱ་དག་ཏུ་འཚོ། །དེ་ཡི་ལས་ཀྱི་ལྷག་མ་ཡིས། །མྱུར་དུ་བྱང་ཆུབ་འཐོབ་པར་འགྱུར། །དེ་ཡི་བུ་ནི་རྒྱལ་པོ་ཡང་། །སྡེ་ཆེན་སྟོབས་ནི་ཆེ་བ་ཡི། །ཟབ་མོའི་ཕྱོགས་ཞེས་རྣམ་པར་གྲགས། །གྲོང་ཁྱེར་ས་ནི་ལྔ་ལེན་འབྱུང་། །རིག་པའི་བདག་ཉིད་རྒྱལ་པོ་དེའང་། །དེ་ཡི་ཚེ་ན་འབྱུང་བར་འགྱུར། །གཙུག་ལག་ཁང་དང་གནས་ཁང་དང་། །མཆོད་རྟེན་རྫིང་དང་ཁྲོན་པ་ནི། །འོད་ཆེན་"],["ན 328a","ས་ཡི་བདག་པོ་དེ། །དུ་མ་བྱེད་པར་ཐེ་ཚོམ་མེད། །བློ་དང་ལྡན་པ་འཇམ་དབྱངས་ཀྱི། །སྔགས་ཀྱང་དེས་ནི་རབ་བསྒྲུབས་པ། །དེ་དག་ཡི་གེ་དྲུག་ཅེས་བྱ། །དོན་ཆེན་ལོངས་སྤྱོད་འཕེལ་བྱེད་པའོ། །དེ་ཡི་སྔགས་ཀྱི་མཐུ་ཡིས་ནི། །དེ་ནི་ལོངས་སྤྱོད་ཆེ་བར་འགྱུར། །བློ་དང་ལྡན་པ་མཐར་གྱིས་ནི། །མྱུར་དུ་བྱང་ཆུབ་གཞོལ་བར་འགྱུར། །དེ་བཞིན་གཤེགས་པའི་བསྟན་འདི་ལ། །རྣམ་པ་སྣ་ཚོགས་བྱ་བ་བྱེད། །བྱང་གི་ཕྱོགས་ལ་བརྟེན་ནས་ནི། །དེ་ཡི་ཚེ་ན་འབྱུང་བར་འགྱུར། །ལྷ་ལྡན་ཡུལ་ཞེས་བྱ་བ་ཡི། །གངས་ཅན་རི་ཡི་ནང་གནས་པའི། །རྒྱལ་པོ་མི་ཡི་ལྷ་ཞེས་པ། །ལིཙྪ་བཱི་རྣམས་རིགས་སུ་བྱུང་། །དེ་ཡང་སྔགས་ཀྱི་དོན་བསྒྲུབས་ཏེ། །ལོངས་སྤྱོད་ཆེ་དང་ལྡན་པར་འགྱུར། །རིག་པ་ལོངས་སྤྱོད་ལྡན་ཞེས་བྱ། །མི་ཡི་བདག་པོས་དེ་ཡང་གྲུབ། །ལོ་ནི་བརྒྱད་ཅུར་རྒྱལ་སྲིད་བྱས། །དེས་ནི་རྐུན་མ་རྣམ་པར་སྤངས། །རྒྱལ་པོ་དེ་ནི་སྲོག་སྤངས་ནས། །དེར་ཡང་སྔགས་ནི་མྱུར་འགྲུབ་སྟེ། །ཞི་དང་རྒྱས་པ་བསིལ་བྱེད་པའོ། །འཇིག་རྟེན་སྒྲོལ་མ་ཞེས་གྲགས་དང་། །ལྷ་མོ་གོས་དཀར་མ་དང་ནི། །དཀར་མོ་ཆེན་མོ་གཞན་ཕན་བརྩོན། །རྟག་ཏུ་ཡིད་ནི་མི་སྐྱོ་བའོ། །དེ་ལ་སོགས་པ་གསུངས་པ་ཡི། །དེ་བཞིན་རྒྱལ་པོ་མང་པོ་ནི། །རྣམ་པ་དུ་མ་མང་པོ་དག །ཁ་དོག་སྣ་ཚོགས་སྣ་ཚོགས་གཟུགས། །ཁ་བ་ཅན་གནས་ཀླ་ཀློའི་རྒྱལ། །དེ་ཡང་སྟོན་པ་མཆོད་བྱེད་པའོ། །ཁྱུ་མཆོག་ཁྱུ་མཆོག་བཟང་པོ་དང་། །ས་འོད་དེ་བཞིན་ས་འོད་བཟང་། །དེ་བཞིན་ཕ་རོལ་གནོན་ཉིད་དང་། །རྐང་པའི་འགྲོས་ཞེས་བསྟན་པ་ཡིན། །ས་སྲུང་དང་ནི་བེའུ་དང་། །འོད་ལྡན་ཉིད་ནི་ཕྱི་མ་ཡིན། །ཐ་མར་ཆར་རྒྱལ་ངང་ཚུལ་ཏེ། །ཀླ་ཀློ་རྣམ་པ་སྣ་ཚོགས་ཡིན། །དེ་འོག་ལུགས་ནི་རྣམ་ཞིག་ཅིང་། །ཕྱི་རོལ་སྐྱེ་དགུས་ཉེ་བར་སྤྱོད། །དེ་ཚེ་བལ་ཡུལ་བདག་པོ་ནི། །མཚོན་གྱིས་འཐབ་པས་རྣམ་པར་འཇིག །ཀླ་ཀློའི་རྐུན་པོ་བསྟེན་པ་ཡི། །དེར་ནི་རྒྱལ་པོ་རྣམ་པར་འཇིག །ས་བདག་དུ་མ་གསུངས་པ་རྣམས། །སྣ་ཚོགས་ལྷ་དང་བྲམ་ཟེ་དག །དེ་ཡི་ཚེ་ན་འབྱུང་བར་"],["ན 328b","འགྱུར། །རྒྱ་ཡུལ་ཀུན་ལ་བརྟེན་པ་ཡི། །རྒྱལ་པོ་དབྱིག་གི་སྙིང་ཞེས་བྱ། །སྡེ་ཆེན་སྟོབས་ཀྱང་ཆེ་བ་དང་། །བློན་པོ་རྒྱ་ཆེ་ཉིད་དང་ནི། །སྐྱེ་བོ་རྩ་ལག་རབ་ཏུ་མང་། །ཀླ་ཀློས་བཏུད་དང་རྣམ་པར་རྒྱལ། །སྟོན་པའི་བསྟན་པ་དེ་གཙོར་བྱེད། །གཞོན་ནུ་བདག་ཉིད་ཆེན་པོ་ཉིད། །དེ་ཡི་སྔགས་ནི་རབ་བསྒྲུབས་པ། །མཐུ་ནི་ཆེན་པོ་དང་ལྡན་པའི། །རིག་པའི་རྒྱལ་པོ་ཡི་གེ་བརྒྱད། །དཔའ་བོ་ཆེ་ཞེས་རྣམ་པར་གྲགས། །ཕུན་སུམ་ཚོགས་པའི་གནས་ཆེན་ཡིན། །དེ་ཡི་བྱིས་པའི་བློ་ཡིས་ནི། །རྒྱལ་སྲིད་ཕྱིར་ནི་རབ་སྨོན་བྱས། །གང་གིས་དྲན་པ་ཙམ་གྱིས་ནི། །སངས་རྒྱས་ཉིད་དུ་ངེས་འགྱུར་བ། །མི་བདག་རྒྱལ་ཐབས་ཉིད་ཀྱི་ཕྱིར། །དེ་ནི་སྐལ་བ་མི་ཉུང་འགྱུར། །མཆོག་གི་སྦྱིན་པ་བླ་ན་མེད། །བསམ་པ་ཙམ་གྱིས་ཐོབ་པ་ཉིད། །ཚངས་སོགས་ལྷ་རྣམས་ཐམས་ཅད་ལ། །མ་ལུས་ལུང་ནི་རྩོལ་བྱེད་ན། །ལྷ་ངན་ཕལ་པ་དག་དང་ནི། །མི་ཡི་འཇིག་རྟེན་སྨོས་ཅི་དགོས། །ལོ་ནི་བརྒྱ་དང་ལྔ་བཅུར་འཚོ། །གྲགས་ཆེན་ལྷ་ཡི་གནས་སུ་འགྲོ། །ཆོས་ཀྱི་བདག་ཉིད་དེ་མཐར་གྱིས། །བྱང་ཆུབ་དམ་པ་ཐོབ་པར་འགྱུར། །གཞོན་ནུས་ཡོངས་སུ་བཤད་པ་ཡི། །རིག་པ་འདི་ནི་དེ་ཡུལ་དུ། །དེ་ནི་མྱུར་དུ་འགྲུབ་འགྱུར་གྱིས། །རིག་པ་གཞན་ནི་ནམ་ཡང་མིན། །བྱང་ཆུབ་སེམས་དཔའ་དཔའ་བོ་ཆེ། །འཇམ་པའི་དབྱངས་ནི་འོད་ཆེན་པོ། །མངོན་སུམ་དེ་ཡི་ཡུལ་དག་ན། །བྱིས་པའི་གཟུགས་ཀྱིས་བཞུགས་པ་ཡིན། །གྲུབ་པའི་ཞིང་མཆོག་དམ་པ་ལ། །མི་ནི་ཡོངས་སུ་སྒྲུབ་པར་འགྱུར། །རྒྱལ་པོ་ཏུ་རུཥྐ་ཞེས་བྱ། །བྱང་ཕྱོགས་ལ་ནི་ཡང་དག་བརྟེན། །སྡེ་ཆེན་བརྩོན་འགྲུས་ཆེ་བ་སྟེ། །དེ་ཡི་གནས་སུ་འབྱུང་བར་འགྱུར། །ཤིང་ཤུན་གྱོན་ཡུལ་མ་གཏོགས་པ། །ཁ་ཆེའི་མཐར་ཐུག་ཀ་ཤིར་བཅས། །དེ་ནི་དཔག་ཚད་བདུན་བརྒྱ་དང་། །འབུམ་ཕྲག་གཉིས་ཀྱི་ས་བདག་ཏུ། །དེ་ཚེ་དུས་ཀྱི་ཐ་མ་ལ། །དེ་ཚེ་ཐེ་ཚོམ་མེད་པར་འགྱུར། །དེ་ཡང་སྔགས་ནི་གྲུབ་པས་ན། །ལོ་ནི་སུམ་བརྒྱ་དག་ཏུ་འཚོ། །བློ་ལྡན་མི་ཡི་སྤྱན་གྱུར་པས། །"],["ན 329a","སྐྲ་ཅན་མ་ཡི་རིག་པ་བསྒྲུབས། །བདག་ཉིད་དགེ་བར་བྱ་བའི་ཕྱིར། །ལྷ་ཁང་དག་ནི་མང་པོ་བྱས། །སྟོང་ཕྲག་བརྒྱད་ཅུ་རྩ་གཅིག་གི། །མཆོད་རྟེན་མཆོག་ནི་དེ་བཞིན་བྱས། །ཐེག་པ་ཆེན་པོ་མཆོག་ཆོས་དང་། །དེ་བཞིན་སངས་རྒྱས་རྣམས་ཀྱི་ཡུམ། །འཇིག་རྟེན་ཤེས་རབ་ཕ་རོལ་ཕྱིན། །དེ་ཡི་ཡུལ་དུ་རབ་གནས་བྱས། །རྒྱལ་པོ་དེ་ནི་ལུས་ཞིག་ནས། །མཐོ་རིས་འཇིག་རྟེན་འགྲོ་བར་འགྱུར། །ས་བདག་དེ་ནི་མཐར་གྱིས་སུ། །རྫོགས་པའི་བྱང་ཆུབ་བླ་མེད་འཐོབ། །དེ་འོག་ས་བདག་རྒྱལ་པོ་ནི། །ཆེན་པོ་ཏུ་རུཥྐ་ཞེས་བྱ། །བློ་ལྡན་མང་པོས་བཀུར་ཞེས་བྱ། །རྟག་ཏུ་དགེ་ཞིང་མཆོད་ལ་དགའ། །ལྷ་མོ་སྒྲོལ་མ་རྫུ་འཕྲུལ་ཆེ། །དེ་ཡི་སྔགས་ཀྱང་རབ་ཏུ་བསྒྲུབས། །དེས་ཀྱང་སྔགས་ནི་རབ་བསྒྲུབས་པ། །ས་སྟེང་རྒྱལ་པོའི་ཆེད་དུའོ། །ཕྱོགས་ཆེ་དཔུང་ནི་ཆེན་པོ་དང་། །རྒྱལ་པོ་གྲགས་པ་ཆེན་པོ་སྟེ། །གཉེན་དང་རིགས་དང་རྒྱལ་པོས་ཀྱང་། །དེ་ནི་བཀུར་བ་ཉིད་དུ་འགྱུར། །རྩ་བརྒྱད་སྟོང་གི་གཙུག་ལག་ཁང་། །དེ་ཡི་དུས་སུ་ཡོད་པར་འགྱུར། །དེ་ཡི་སྔགས་ཀྱི་མཐུས་ཡིས་ནི། །ལོ་ནི་ཉིས་བརྒྱ་དག་ཏུ་འཚོ། །གང་ཚེ་དེ་ལུས་ཞིག་པ་ན། །དགའ་ལྡན་དུ་ནི་སྐྱེ་བར་འགྱུར། །བྱང་ཆུབ་སེམས་དཔའ་རྫུ་འཕྲུལ་ཆེ། །ལྷ་ཡི་བུས་ཀྱང་བཀུར་བར་འགྱུར། །ཆོས་ཀྱི་བདག་ཉིད་དེ་མཐར་གྱིས། །བྱང་ཆུབ་ཡན་ལག་མངོན་རྫོགས་ནས། །འབད་པས་དེ་ནི་མཐར་གྱིས་ཀྱང་། །མཉམ་མེད་བྱང་ཆུབ་ཐོབ་པར་འགྱུར། །དུས་ཀུན་དེ་ཡི་ཡུལ་དུ་ནི། །གསུང་རབ་མང་པོ་གནས་འགྱུར་བ། །སྔོན་གྱི་རྒྱལ་བ་དག་གིས་གསུངས། །ད་ལྟར་ངས་ཀྱང་གསུངས་པ་ཡིན། །རྫུ་འཕྲུལ་ཆེན་པོ་ཀླུ་དང་ནི། །འདོད་ཆགས་བྲལ་བས་རྣམ་པར་གནས། །དེ་བཞིན་འཇིག་རྟེན་སྐྱོང་བ་དང་། །གནོད་སྦྱིན་བསྟན་པ་སྲུང་བྱེད་དང་། །ས་སྟེང་དམ་ཆོས་སྲུང་བྱེད་པ། །དེ་ཡི་ཚེ་ན་འབྱུང་བར་འགྱུར། །དེ་ལྟར་རྣམ་པ་མང་པོ་བསྟན། །ས་བདག་འཇིག་རྟེན་རྣམ་གྲགས་པ། །བསྟན་དང་སྟོན་པར་འགྱུར་བ་ཡིན། །ནུབ་ཕྱོགས་ཡུལ་ནི་མཐའ་ཡས་པ། །འཕགས་རྒྱལ་"],["ན 329b","ཞེས་བྱའི་ཕ་རོལ་ཏུ། །ལ་དའི་ཡུལ་གྱི་སྐྱེ་བོ་ནི། །ངང་ཚུལ་ཞེས་བྱའི་རྒྱལ་པོ་ཡོད། །སངས་རྒྱས་རྣམས་ཀྱི་བསྟན་ལ་དད། །གྲོང་ཁྱེར་ཕྱིན་ནས་ཡང་དག་ཞུགས། །ཆོས་ཀྱི་རྒྱལ་པོར་འགྱུར་བ་སྟེ། །མཆོད་རྟེན་སྣ་ཚོགས་གཙུག་ལག་ཁང་། །དེ་བཞིན་སྲོག་ཆགས་དགེ་བར་ནི། །ས་བདག་ཆོས་ལ་མཉེས་གཤིན་པས། །རིག་པའི་བདག་ཉིད་བྱེད་པར་འགྱུར། །རྒྱལ་བའི་གཟུགས་བརྙན་ཡིད་འོང་ལ། །རྣམ་པ་སྣ་ཚོགས་མཆོད་པ་བྱེད། །འཇིག་རྟེན་མགོན་པོ་གྲགས་ཆེན་གྱི། །མཆོད་རྟེན་མཆོག་ལའང་མཆོད་པ་བྱེད། །དེས་ན་དེ་ནི་སྔགས་ཀྱང་གྲུབ། །རྒྱལ་པོ་ལས་སྐྱེས་ཁོ་ན་ནི། །དེ་ཡི་ཡུལ་དུ་ཡང་དག་གྲགས། །དགེ་སློང་བསོད་སྙོམས་བྱེད་པ་ནི། །ཚུལ་ཁྲིམས་ལྡན་ཞིང་བློ་དང་ལྡན། །སངས་རྒྱས་རྣམས་ཀྱི་བསྟན་ལ་དད། །བདག་ཉིད་ཆེན་པོ་དུས་སུ་རྒྱུ། །དེ་ནི་བསོད་སྙོམས་རབ་ཞུགས་རྒྱུ། །རྒྱལ་པོའི་ཁབ་བཟང་རབ་མཐོང་བ། །རྒྱ་ཆེ་སྐྱེ་བོས་གང་བ་ལ། །བསླང་བའི་དོན་དུ་དེར་ཡང་ཞུགས། །བཀྲེས་པ་དང་ཡང་ཡང་དག་ལྡན། །ངལ་ཞིང་ལྟོགས་པའི་ཡིད་གྱུར་ཀྱང་། །དེ་ཚེ་བསོད་སྙོམས་རྙེད་མ་གྱུར། །རྒྱལ་པོའི་སྐྱེས་བུས་དེ་མྱུར་བཟུང་། །ཁྱིམ་དེ་ལས་ནི་ཕྱུང་བར་འགྱུར། །དེ་ནས་དེ་ནི་ཡིད་བྱུང་ནས། །རྒྱལ་པོའི་མི་ལ་རབ་ཁྲོས་ཏེ། །གྲོང་ཁྱེར་དེ་ལས་ངེས་བྱུང་ནས། །མོད་ལ་དེ་ཡི་རང་གནས་ཕྱིན། །ལྟོགས་ཤིང་སྐོམ་པ་ཉིད་གྱུར་པས། །སྡུག་བསྔལ་ཡིད་མི་བདེ་བར་གྱུར། །དེ་ནས་དེ་ནི་ཟས་ཆད་ནས། །མཚན་ཕྱེད་དུ་ནི་ལངས་གྱུར་ནས། །སྡོམ་བརྩོན་དེ་ནི་སེམས་ཆུད་པས། །དེ་ཚེ་སྲོག་ནི་གཏང་བར་རྩོམ། །དེ་ཚེ་སྨོན་ལམ་བྱེད་པ་ནི། །ལ་དའི་ཡུལ་གྱི་བདག་པོར་ཤོག །དེ་ནས་དགེ་སློང་དུས་ལས་འདས། །སྤུ་གྲི་ཞེས་བྱའི་རྒྱལ་རིགས་སུ། །བདག་ཉིད་ཆེན་པོ་དེ་སྐྱེས་གྱུར། །སྟོན་པའི་བསྟན་པ་མཆོད་པར་བྱེད། །ལོ་ནི་སུམ་ཅུ་དག་ཏུ་ཡང་། །རྒྱལ་སྲིད་གནོད་པ་མེད་པར་བྱས། །བརྐམ་ཆགས་རང་མིའི་སྦྱོར་བ་ཡིས། །"],["ན 330a","མ་ཞུའི་ནད་ཀྱིས་བཏབ་པར་གྱུར། །དེ་ཚེ་རྒྱལ་པོ་ལུས་ཞིག་ནས། །དུས་བྱས་ལྷ་ཡི་གནས་སོང་བ། །བྱམས་པ་གང་དུ་བཞུགས་པ་ཡི། །དགའ་ལྡན་ལྷ་ཡི་གནས་མཆོག་ཏུ། །བདག་ཉིད་ཆེན་པོས་ཆོས་འཆད་པར། །དེ་ཉིད་དུ་ནི་སྐྱེ་བར་འགྱུར། །འོད་ཆེན་བྱམས་པ་ཆེན་པོ་ལ། །བསྙེན་བཀུར་བྱེད་ཅིང་ཆོས་ཀྱང་ཉན། །བདག་ཉིད་ཆེན་པོ་དེ་མཐར་གྱིས། །རྙེད་པར་དཀའ་བའི་བྱང་ཆུབ་ཐོབ། །ཚུལ་ཁྲིམས་ཞེས་བྱའི་རྒྱལ་པོའི་འོག །གཡོ་བ་ཞེས་བྱ་འབྱུང་བར་འགྱུར། །ལོ་ནི་ལྔ་བཅུ་རྩ་ལྔ་དང་། །དེ་བཞིན་ཟླ་བ་ལྔ་རུ་འཚོ། །དེ་སྲིད་རྒྱལ་སྲིད་དེས་བྱས་ནས། །མཚོན་ཆས་འཚོ་བས་རབ་བསད་པ། །བུད་མེད་བྱས་པའི་སྐྱོན་ཉིད་ཀྱིས། །དེ་ནི་མཚོན་ཆས་བསད་པར་འགྱུར། །དེ་ཡི་ནུ་བོ་བརྟན་ཞེས་བྱ། །བརྟན་པ་ཆོས་ནི་བརྟན་པར་འགྱུར། །སྔོན་ནི་བཀྲེན་པ་ཞམ་རིང་གྱུར། །ཡུལ་ནི་ལ་དའི་བདག་པོར་གྱུར། །ལྷག་མ་རྒྱལ་པོ་ཐམས་ཅད་དང་། །སྐྱེ་དགུ་ཀུན་ཀྱང་ཞམ་རིང་པའོ། །ཚུལ་ཁྲིམས་ཞེས་བྱ་རབ་འདས་ནས། །དེ་ནི་དེ་དག་ཀུན་གྱི་སྔར། །ས་བདག་ཐམས་ཅད་འབྱུང་འགྱུར་བ། །དཔའ་བོ་རྒྱ་མཚོའི་ཕ་རོལ་འགྲོ། །རྒྱལ་པོ་དབང་པོ་ཟླ་མཛེས་དང་། །དེ་བཞིན་དུ་ནི་གཞུ་དང་ཏོག །མེ་ཏོག་གཞུ་དང་རྒྱལ་པོའི་བུ། །རེས་ལྡན་གྲོང་ལས་བྱུང་བ་ཡིན། །དང་པོའི་དང་པོ་སྔ་མ་དག །བ་ལའི་གྲོང་དུ་འབྱུང་བ་ཡིན། །འོད་ཅེས་བྱ་བ་སྟོད་རྣམས་དང་། །དེ་བཞིན་ཁྱབ་འཇུག་ཅེས་བྱ་བ། །རྒྱལ་པོ་མཐའ་ཡས་གསུངས་པ་ནི། །ཡ་ང་བ་ཡི་རིགས་སུ་འབྱུང་། །དེ་དག་ཕྱི་མའི་རྒྱལ་པོ་ནི། །ཁྱབ་འཇུག་ཅེས་ནི་བྱ་བ་འབྱུང་། །གྲོང་དང་སྐྱེ་བོ་གཉེན་དང་བཅས། །དྲང་སྲོང་དམོད་པས་གནོད་གྱུར་པས། །བློ་ལྡན་རྒྱལ་པོ་མེད་པར་འགྱུར། །གྲོང་ཁྱེར་ཆུ་ཡིས་རབ་ཏུ་གང་། །དེ་ཚེ་དེ་ཡི་རེས་ལྡན་གྲོང་། །རྒྱ་མཚོ་ཆེན་པོས་རབ་ཏུ་གང་། །བྱང་གི་ཕྱོགས་ནི་ཐམས་ཅད་དུ། །རྩོམ་པ་སྣ་ཚོགས་རི་ཞོལ་བརྟན། །སྣ་ཚོགས་རིགས་ལ་གནས་པ་ཡི། །རྒྱལ་པོ་རྣམས་ནི་མཐའ་ཡས་གསུངས། །ཉི་ཤུ་གཅིག་དང་སུམ་ཅུ་"],["ན 330b","ཡི། །མི་ཡི་རྒྱལ་པོར་ཤེས་པར་བྱ། །བཅྭ་བརྒྱད་ས་ཡི་བདག་པོ་ཞེས། །བར་མའི་ས་ཀུན་བདག་པོ་ཡིན། །མཐའ་ཡས་ཀླུ་ཡི་སྡེ་ལ་སོགས། །དེ་ལས་ཐ་མ་རྣམ་པར་ཞིག །དེ་ནས་ཁྱབ་འཇུག་འཕྲོག་བྱེད་དང་། །མདུང་ཞེས་བྱ་བ་འཕྲོག་བྱེད་གཞན། །དབང་ལྡན་དང་ནི་ཕྲེང་ཀུན་དང་། །བཟའ་དང་བརྟུལ་ཞུགས་བཟང་པོ་གཞན། །དུས་ཀུན་ཆོས་ལུགས་རྣམ་པར་ཉམས། །རྒྱལ་པོ་དེ་དག་དུས་ལས་འདས། །དེས་ནི་བྲམ་ཟེ་རིགས་བྱུང་བ། །དེ་ཚེ་ལོངས་སྤྱོད་ཆེ་ནོར་དང་། །བར་མཐར་ཡི་གེ་དང་པོ་བྷ། །དེ་ཚེ་བློན་པོ་གཉི་ག་གཙོ། །གཉི་ག་ནོར་ལྡན་དཔལ་ལྡན་གྲགས། །བསྟན་པ་ལ་ནི་ཕན་པར་དགའ། །གཞོན་ནུ་ཁྱོད་ཀྱི་སྔགས་རྒྱལ་པོ། །བློན་པོས་དེ་ཚེ་སྔགས་ཀྱང་བཟླས། །དེ་ནས་བཟུང་ནས་ས་ཡི་བདག །གཉི་ག་མི་ཡི་དབང་ཕྱུག་གྱུར། །བདུན་དང་བརྒྱད་དང་དེ་བཞིན་གསུམ། །དེ་ཚེ་དཔལ་མགྲིན་གནས་ན་འདུག །སྟོན་པ་ཉི་མ་ཞེས་བྱ་བའི། །གནས་ན་དབང་ཕྱུག་རབ་ཏུ་གནས། །ཐམས་ཅད་གནས་སུ་ས་ཡི་བདག །འབྱུང་བར་འགྱུར་བར་ཐེ་ཚོམ་མ་མེད། །ཡི་གེ་ཧ་ཞེས་རབ་གསུངས་པ། །ས་རྣམས་ཀུན་ལ་མི་ཡི་བདག །དེ་ཡི་ཡུལ་དུ་སྔགས་འདི་དག །དེ་ཚེ་གྲུབ་པར་འགྲོ་བ་ཡིན། །ཞི་དང་རྒྱས་པའི་རིག་པ་རྣམས། །གང་ཞིག་ཆོས་རྒྱལ་གྱིས་གསུངས་པ། །ལོངས་སྤྱོད་རྣམ་པ་སྣ་ཚོགས་ཚོགས། །དེ་བཞིན་རྣམ་པ་སྣ་ཚོགས་ལྡན། །སྣ་ཚོགས་གཟུགས་ཀྱི་གཟུངས་དང་ནི། །རྫུ་འཕྲུལ་ཆེན་པོ་གནོད་སྦྱིན་མོ། །དེ་ཚེ་དུས་ཀྱི་ཐ་མ་ལ། །དེར་ནི་གྲུབ་པར་འགྱུར་བ་ཡིན། །ལྷོ་ཡི་ཕྱོགས་ལ་ཡང་དག་བསྟན། །རྒྱ་མཚོའི་འགྲམ་གྱི་ས་དག་ལ། །རྒྱལ་པོ་དཀར་དང་ཟླ་མཛེས་དང་། །ས་ལ་ཡི་ནི་བཞོན་པ་དང་། །དབང་ཆེན་དང་ནི་བདེ་བྱེད་དང་། །ས་བདག་དེ་བཞིན་ཡིད་དུ་འོང་། །ལོངས་སྤྱོད་སྐྲ་བཟང་སྐྲ་ཞེས་སུ། །ལྷོ་ཡི་ཕྱོགས་སུ་རྣམ་པར་གྲགས། །བཀྲ་ཤིས་དང་ནི་རྙེད་སླ་དང་། །བ་ལང་རྙེད་དང་ཁྱུ་ཉིད་དང་། །གྲུ་བཟང་དེ་བཞིན་གྲུ་དག་དང་། །དབང་ཆེན་དང་ནི་ཟླ་བ་ཉིད། །བ་ལང་སྲུང་དབང་ཟླ་བའི་སྡེ། །འདོད་ལྷ་དེ་བཞིན་མ་ག་དྷཱ། །གྲོང་"],["ན 331a","བྱེད་བདེ་བྱེད་ཉིད་དང་ནི། །སྟག་དང་སེང་གེ་གཟའ་ལྷག་དང་། །སངས་རྒྱས་དག་པ་བུམ་པ་དང་། །བུམ་པ་མ་ལུས་ཉིད་དུ་བརྗོད། །མཉམ་དང་ལེགས་པར་འཇམ་པ་དང་། །སྐྲ་བཟང་སྐྲ་ནི་ལྡན་པ་དང་། །ལྷོ་ཡི་ཕྱོགས་སུ་ས་ཡི་བདག །མཐའ་ཡས་མང་པོར་བསྟན་པ་ཡིན། །འདས་དང་མ་འོངས་པ་དག་དང་། །ད་ལྟར་དག་ཏུ་རྟོགས་པར་གྱིས། །རྣམ་པ་སྣ་ཚོགས་ནད་བཏབ་ནས། །འདི་དག་རྣམ་པ་སྣ་ཚོགས་འཆི། །མཚོན་གྱིས་འདེབས་དང་མུ་གེ་ཡིས། །འཆི་ཞིང་ཁ་ཅིག་ཕྱོགས་གཞན་འགྲོ། །དེ་ལྟར་འདི་དག་རྒྱལ་པོ་རྣམས། །ཀན་ཙི་པུ་རར་གནས་པར་བསྟན། །དེ་བཞིན་སྟོང་ཕྲག་རྣམ་གྲགས་པ། །དེ་ཚེ་འབྱུང་བར་འགྱུར་བ་ཡིན། །དེ་དུས་དེ་ཚེ་ཕྱོགས་དག་ཏུ། །སྔགས་རྣམས་གྲུབ་པར་འདོད་ན་ནི། །ཁྲོ་བོ་རྡོ་རྗེའི་རིགས་བསྟན་པའི། །སྔགས་འདི་དག་ནི་བསྒྲུབ་པར་བྱ། །མངོན་པར་སྤྱོད་པའི་ལས་དག་དང་། །དེ་བཞིན་དབང་གི་དོན་ཡང་འགྲུབ། །གཞོན་ནུ་བྱིས་པའི་གཟུགས་ཅན་ནི། །འཇམ་པའི་དབྱངས་ནི་བདག་ཉིད་ཆེ། །དེ་ཚེ་དུས་མཐར་ཕྱིན་པ་ན། །དེ་ཚེ་ཡུལ་དེར་འགྲུབ་པར་འགྱུར། །རི་བོ་འབིགས་བྱེད་ལ་བརྟེན་ནས། །རྒྱ་མཚོ་བ་ཚྭ་ཅན་འགྲམ་དུ། །གདོང་དྲུག་ཅེས་ནི་ཡང་དག་བསྒྲགས། །སེམས་ཅན་རྣམས་ལ་མཆོག་སྦྱིན་བྱེད། །འཇམ་པའི་དབྱངས་ནི་བློ་དང་ལྡན། །བྱང་ཆུབ་སེམས་དཔས་བཀའ་སྩལ་པ། །སེམས་ཅན་རྣམས་ལ་ཕན་འདོད་ཕྱིར། །ལྷོ་ཡི་ཕྱོགས་སུ་གནས་པར་གྱིས། །གདོང་དྲུག་གང་གི་སྔགས་དག་ནི། །འཇམ་པའི་དབྱངས་ཀྱིས་རབ་བསྟན་པ། །དེ་ཚེ་དེ་ཕྱོགས་དེ་དུས་སུ། །གྲུབ་པར་འགྱུར་བར་ཐེ་ཚོམ་མེད། །དེ་ཚེ་དཔལ་གྱི་རི་བོའི་ཕྱོགས། །འབིགས་བྱེད་ནང་དང་རི་ཞོལ་དང་། །གླིང་ཉིད་རྣམ་པ་ཐམས་ཅད་དང་། །ཀ་ལིང་ཀ་ཞེས་རབ་བསྒྲགས་དང་། །ཡོན་ཏན་གསུམ་དང་ཀླ་ཀློ་དང་། །ཁོ་ར་འཁོར་ཡུག་ཀོ་ས་ལ། །རྒྱ་མཚོའི་ནང་དང་འགྲམ་དག་ཏུ། །རྒྱལ་པོ་དག་ནི་མཐའ་ཡས་ཡོད། །ཆ་ཤས་ཀཱ་མ་རཱུ་ཞེས་པ། །ཁ་བ་ཅན་གྱི་ནང་ན་གནས། །ཨོ་ཌ་ཡུལ་གྱི་མཚམས་ཀུན་ན། །རྒྱལ་པོ་རྣམས་ནི་མང་པོ་གསུངས། །སྣ་ཚོགས་ཀླ་ཀློའི་"]]}