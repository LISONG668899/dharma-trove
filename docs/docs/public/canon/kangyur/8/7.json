{"t":"8","p":7,"paras":[["ཀ 87b","རྣམ་པར་ཤེས་པ་མྱེད་དོ། །རྣམ་པར་ཤེས་པ་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་མྱིང་དང་གཟུགས་མྱེད་དོ། །མྱིང་དང་གཟུགས་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་སྐྱེ་མཆེད་དྲུག་མྱེད་དོ། །སྐྱེ་མཆེད་དྲུག་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་རེག་པ་མྱེད་དོ། །རེག་པ་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་ཚོར་བ་མྱེད་དོ། །ཚོར་བ་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་སྲེད་བ་མྱེད་དོ། །སྲེད་པ་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་ལེན་པ་མྱེད་དོ། །ལེན་པ་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་སྲིད་པ་མྱེད་དོ། །སྲིད་པ་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་སྐྱེ་བ་མྱེད་དོ། །སྐྱེ་བ་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་རྒ་ཤི་མྱེད་དོ། །རྒ་ཤི་འགག་པ་མྱེད་དོ། །དེ་ལ་ནི་སྡུག་བསྔལ་མྱེད་དོ། །སྡུག་བསྔལ་ཡོངས་སུ་ཤེས་པ་མྱེད་དོ། །དེ་ལ་ནི་ཀུན་འབྱུང་བ་མྱེད་དོ། །ཀུ་འབྱུང་བ་སྤང་བ་མྱེད་དོ། །དེ་ལ་ནི་འགོག་པ་མྱེད་དོ། །འགོག་པ་མངོན་དུ་བྱ་བ་མྱེད་དོ། །དེ་ལ་ནི་ལམ་མྱེད་དོ། །ལམ་བསྒོམ་པ་མྱེད་དོ། །དེ་ལ་ནི་ཐོབ་པར་བྱ་བ་མེད་དོ། །མངོན་དུ་ཤེས་པར་བྱ་བ་མྱེད་དོ། །དེ་ལ་ནི་རྒྱུན་ཏུ་ཞུགས་པ་མྱེད་དོ། །རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་མྱེད་དོ། །དེ་ལ་ནི་ལན་ཅིག་ཕྱིར་འོང་བ་མྱེད་དོ། །ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་མྱེད་དོ། །དེ་ལ་ནི་ཕྱིར་མྱི་འོང་བ་མྱེད་དོ། །ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་མེད་དོ། །དེ་ལ་ནི་དགྲ་བཅོམ་པ་མེད་དོ། །དགྲ་བཅོམ་པའི་འབྲས་བུ་མེད་དོ། །དེ་ལ་ནི་རང་སངས་རྒྱས་མྱེད་དོ། །རང་བྱང་ཆུབ་མྱེད་དོ། །དེ་ལ་ནི་བྱང་ཆུབ་སེམས་དཔའ་མྱེད་དོ། །ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་མྱེད་དོ། །དེ་ལ་ནི་སངས་རྒྱས་མྱེད་དོ། །བྱང་ཆུབ་མེད་དོ། །ཤ་ར་དྭ་ཏིའི་བུ་བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་དེ་ལྟར་སྤྱོད་པ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་ཞེས་བྱ་སྟེ། དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། གཟུགས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །ཚོར་བ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །"],["ཀ 88a","འདུ་ཤེས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །འདུ་བྱེད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། མིག་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །སྣ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས། ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། གཟུགས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྒྲ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དྲི་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རོ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རེག་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆོས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། མྱིག་གི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །གཟུགས་ཀྱི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་"],["ཀ 88b","མཐོང་ངོ་། །མིག་གི་རྣམ་པར་ཤེས་པའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། རྣ་བའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྒྲའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་རྣམ་པར་ཤེས་པའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། སྣའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དྲིའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་རྣམ་པར་ཤེས་པའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། ལྕེའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མ་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རོའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་རྣམ་པར་ཤེས་པའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། ལུས་ཀྱི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རེག་བྱའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། ཡིད་ཀྱི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་"],["ཀ 89a","འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆོས་ཀྱི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། སའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆུའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མེའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རླུང་གི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ནམ་མཁའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པའི་ཁམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། མ་རིག་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་བྱེད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིང་དང་གཟུགས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྐྱེ་མཆེད་དྲུག་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རེག་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚོར་བ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་"],["ཀ 89b","བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྲེད་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལེན་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྲིད་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྐྱེ་བ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྒ་ཤི་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚུལ་ཁྲིམས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ་མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། ནང་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཕྱི་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བའམ་མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཕྱི་ནང་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་"],["ཀ 90a","རྗེས་སུ་མི་མཐོང་ངོ་། །ཆེན་པོ་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དོན་དམ་པ་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུས་བྱས་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱུ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུས་མ་བྱས་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དོར་བ་མེད་པ་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རང་བཞིན་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆོས་ཐམས་ཅད་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དེ་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ཀྱང་། དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་"],["ཀ 90b","འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡང་དག་པར་སྤོང་བ་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དབང་པོ་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྟོབས་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བྱང་ཆུབ་ཀྱི་ཡན་ལག་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལམ་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འཕགས་པའི་བདེན་པ་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བསམ་གཏན་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚད་མེད་པ་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཐར་པ་བརྒྱད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མཚན་མ་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྨོན་པ་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མངོན་པར་ཤེས་པ་"],["ཀ 91a","རྣམས་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །གཟུངས་ཀྱི་སྒོ་ཐམས་ཅད་ལ། བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །མི་འཇིགས་པ་བཞི་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །བྱམས་པ་ཆེན་པོ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྙིང་རྗེ་ཆེན་པོ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སངས་རྒྱས་ཀྱི་ཆོས་མ་འདྲེས་པ་བཅོ་བརྒྱད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །ཕྱིར་མི་འོང་བའི་འབྲས་བུ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དགྲ་བཅོམ་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །རང་བྱང་ཆུབ་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ལ་བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་"],["ཀ 91b","བརྩོན་ཞེས་བྱ་བ་འམ། མྱི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །ཤ་ར་དྭ་ཏིའི་བུ་རྣམ་གྲངས་དེ་ལྟ་བུས་ན། ཆོས་ཐམས་ཅད་འདུ་བ་དང་འབྲལ་བ་མྱེད་པའི་ཕྱིར། བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་ཞེས་བྱའོ། །ཤ་ར་དྭ་ཏིའི་བུ་གཞན་ཡང་བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པའི་ཚེ། སྟོང་པ་ཉིད་དང་སྟོང་པ་ཉིད་དུ་མྱི་སྡུད་མྱི་འབྱེད་དེ། སྟོང་པ་ཉིད་ཀྱི་རྣལ་འབྱོར་དང་ཡང་མ་ཡིན་ནོ། །མཚན་མ་མྱེད་པ་དང་མཚན་མ་མེད་པར་མྱི་སྡུད་མྱི་འབྱེད་དེ། མཚན་མ་མྱེད་པའི་རྣལ་འབྱོར་དང་ཡང་མ་ཡིན་ནོ། །སྨོན་པ་མྱེད་པ་དང་སྨོན་པ་མྱེད་པར་མྱི་སྡུད་མྱི་འབྱེད་དེ། སྨོན་པ་མྱེད་པའི་རྣལ་འབྱོར་དང་ཡང་མ་ཡིན་ནོ། །དེ་ཅིའི་ཕྱིར་ཞེ་ན། དེ་ནི་འདི་ལྟར་སྟོང་པ་ཉིད་ལ་འདུ་བ་འམ་འབྲལ་བ་མེད་དོ། །མཚན་མ་མྱེད་པ་ལ་འདུ་བ་འམ་འབྲལ་བ་མྱེད་དོ། །སྨོན་པ་མེད་པ་ལ་འདུ་བ་འམ་འབྲལ་བ་མེད་དོ། །ཤ་ར་དྭ་ཏིའི་བུ་དེ་ལྟ་བུར་བརྩོན་པའི་བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་ཞེས་བྱའོ། །ཤ་ར་དྭ་ཏིའི་བུ་གཞན་ཡང་བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པའི་ཚེ། ཆོས་རྣམས་ཀྱི་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ལ་འཇུག་སྟེ། དེ་དེ་ལྟར་ཁོང་དུ་ཆུད་པར་བྱེད་པས། གཟུགས་མྱི་སྦྱོར་མྱི་འབྱེད་དོ། །ཚོར་བ་མྱི་སྦྱོར་མྱི་འབྱེད་དོ། །འདུ་ཤེས་མྱི་སྦྱོར་མྱི་འབྱེད་དོ། །འདུ་བྱེད་མྱི་སྦྱོར་མྱི་འབྱེད་དོ། །རྣམ་པར་ཤེས་པ་མྱི་སྦྱོར་མྱི་འབྱེད་དོ། །གཟུགས་དང་སྔོན་གྱི་མཐར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །གཟུགས་དང་ཕྱི་མའི་མཐར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །གཟུགས་དང་ད་ལྟར་བྱུང་བར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་"],["ཀ 92a","ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚོར་བ་དང་སྔོན་གྱི་མཐར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚོར་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚོར་བ་དང་ད་ལྟར་བྱུང་བར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་དེ་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་ཤེས་དང་སྔོན་གྱི་མཐར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་ཤེས་དང་ཕྱི་མའི་མཐར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་ཤེས་དང་ད་ལྟར་བྱུང་བར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་བྱེད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་བྱེད་དང་ཕྱི་མའི་མཐར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་བྱེད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་དང་ད་ལྟར་བྱུང་"],["ཀ 92b","བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་"],["ཀ 93a","ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །གཟུགས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །གཟུགས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །གཟུགས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྒྲ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྒྲ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྒྲ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དྲི་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དྲི་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དྲི་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རོ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རོ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རོ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རེག་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རེག་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རེག་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་"],["ཀ 93b","སུ་མི་མཐོང་ངོ་། །ཆོས་རྣམས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། ད་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆོས་རྣམས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆོས་རྣམས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་གི་རྣམ་པར་ཤེས་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་གི་རྣམ་པར་ཤེས་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་གི་རྣམ་པར་ཤེས་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་རྣམ་པར་ཤེས་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་རྣམ་པར་ཤེས་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་རྣམ་པར་ཤེས་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་རྣམ་པར་ཤེས་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་རྣམ་པར་ཤེས་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་རྣམ་པར་ཤེས་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་རྣམ་པར་ཤེས་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་"],["ཀ 94a","རྣམ་པར་ཤེས་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་རྣམ་པར་ཤེས་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་གི་འདུས་ཏེ་རེག་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་གི་འདུས་ཏེ་རེག་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་གི་འདུས་ཏེ་རེག་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་འདུས་ཏེ་རེག་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་འདུས་ཏེ་རེག་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་འདུས་ཏེ་རེག་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་"],["ཀ 94b","མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་འདུས་ཏེ་རེག་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་འདུས་ཏེ་རེག་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་འདུས་ཏེ་རེག་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་འདུས་ཏེ་རེག་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་འདུས་ཏེ་རེག་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་འདུས་ཏེ་རེག་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་"],["ཀ 95a","ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་"],["ཀ 95b","སྡོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། །དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སའི་ཁམས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སའི་ཁམས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སའི་ཁམས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆུའི་ཁམས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆུའི་ཁམས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆུའི་ཁམས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མེའི་ཁམས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་"],["ཀ 96a","དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མེའི་ཁམས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མེའི་ཁམས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རླུང་གི་ཁམས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རླུང་གི་ཁམས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རླུང་གི་ཁམས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ནམ་མཁའི་ཁམས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ནམ་མཁའི་ཁམས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ནམ་མཁའི་ཁམས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པའི་ཁམས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པའི་ཁམས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པའི་ཁམས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མ་རིག་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མ་རིག་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མ་རིག་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ།"],["ཀ 96b","དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་བྱེད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་བྱེད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུ་བྱེད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྣམ་པར་ཤེས་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མྱིང་དང་གཟུགས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མྱིང་དང་གཟུགས་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མྱིང་དང་གཟུགས་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྐྱེ་མཆེད་དྲུག་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྐྱེ་མཆེད་དྲུག་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྐྱེ་མཆེད་དྲུག་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རེག་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རེག་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་"],["ཀ 97a","ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རེག་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚོར་བ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚོར་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐར་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚོར་བ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྲེད་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྲེད་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྲེད་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལེན་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལེན་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ལེན་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྲིད་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། །དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྲིད་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྲིད་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྐྱེ་བ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྐྱེ་བ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་"],["ཀ 97b","འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྐྱེ་བ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྒ་ཤི་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྒ་ཤི་དང་ཕྱི་མའི་མཐར་མ་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རྒ་ཤི་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚུལ་ཁྲིམས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚུལ་ཁྲིམས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཚུལ་ཁྲིམས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ད་ལྟར་བྱུང་བར་"],["ཀ 98a","མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ནང་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ནང་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ནང་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཕྱི་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་"],["ཀ 98b","མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཕྱི་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཕྱི་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཕྱི་ནང་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། །དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཕྱི་ནང་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཕྱི་ནང་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། །དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆེན་པོ་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆེན་པོ་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆེན་པོ་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དོན་དམ་པ་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དོན་དམ་པ་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་"],["ཀ 99a","པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དོན་དམ་པ་སྟོང་པ་ཉིད་དང་ད་ལྟར་གྱུར་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུས་བྱས་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུས་བྱས་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐར་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུས་བྱས་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུས་མ་བྱས་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུས་མ་བྱས་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །འདུས་མ་བྱས་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། །དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ཉི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་"],["ཀ 99b","པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། །དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དོར་བ་མེད་པ་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དོར་བ་མེད་པ་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དོར་བ་མེད་པ་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རང་བཞིན་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རང་བཞིན་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རང་བཞིན་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆོས་ཐམས་ཅད་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆོས་ཐམས་ཅད་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ཆོས་ཐམས་ཅད་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མྱི་དམྱིགས་པ་"],["ཀ 100a","སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མི་དམིགས་པ་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མྱི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དང་སྔོན་གྱི་མཐར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། །དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དང་ཕྱི་མའི་མཐར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། །དེ་ནི་འདི་ལྟར་ཕྱི་མའི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ་། །དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་དང་ད་ལྟར་བྱུང་བར་མྱི་སྦྱོར་མྱི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་། །དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་དང་སྔོན་གྱི་མཐར་མི་སྦྱོར་མི་འབྱེད་དེ། དེ་ནི་འདི་ལྟར་སྔོན་གྱི་མཐའ་"]]}